{
 "record_type": "creative_original_item/v1",
 "identity": "multi_source_table_merge",
 "title": "Multi-source table merge with provenance and conflicts",
 "purpose": "Compile one table from several CSV sources by mapping columns to target fields, converting units, matching on key fields, taking values by source priority, recording which source gave each value and listing disagreements.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
 "engine": {
  "name": "python",
  "minimum_version": "3.10"
 },
 "tags": [
  "data compilation",
  "merge",
  "provenance",
  "csv",
  "conflicts",
  "data integration"
 ],
