{
 "record_type": "creative_original_item/v1",
 "identity": "record_log_auditor",
 "title": "Operational log completeness and order audit",
 "purpose": "Audit an operational log for missing required fields, unreadable or out-of-order timestamps, repeated ids, sequence gaps and repeats, and missing days or hours per group against a period, with coverage shares.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
 "engine": {
  "name": "python",
  "minimum_version": "3.10"
 },
 "tags": [
  "records",
  "operational log",
  "audit",
  "completeness",
  "sequence gaps",
  "documentation"
 ],
 "files": [
  {
   "path": "README.md",
   "role": "other"
  },
  {
   "path": "record_log_auditor.py",
   "role": "executable_tool"
  },
  {
   "path": "PROCEDURE.md",
   "role": "skill_reference"
  },
