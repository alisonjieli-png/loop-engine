 "title": "Critical path schedule from tasks and dependencies",
 "purpose": "Compute earliest and latest start and finish, total and free float, the critical path and optional calendar dates from a task list with durations and finish-to-start dependencies.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
