        "type": "string"
       },
       "hours": {
        "type": "number"
       },
       "shifts": {
        "type": "integer"
       }
      }
     }
    },
    "filled_share": {
     "type": "number",
     "description": "positions filled divided by positions required"
    }
   }
  },
