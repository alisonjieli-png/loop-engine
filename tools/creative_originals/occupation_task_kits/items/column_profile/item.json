{
 "record_type": "creative_original_item/v1",
 "identity": "column_profile",
 "title": "Column profile of a CSV table",
 "purpose": "Summarize each column of a CSV without declared rules: missing values, distinct values, inferred type, frequent values, value shapes, lengths, quartiles, mean, standard deviation, outliers, date ranges, duplicate rows and constant or mostly empty columns.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
 "engine": {
  "name": "python",
  "minimum_version": "3.10"
 },
 "tags": [
  "data profiling",
  "csv",
  "data quality",
  "statistics",
  "outliers",
  "exploration"
 ],
 "files": [
  {
   "path": "README.md",
   "role": "other"
  },
  {
   "path": "column_profile.py",
   "role": "executable_tool"
  },
  {
   "path": "PROCEDURE.md",
   "role": "skill_reference"
