 "identity": "duplicate_record_finder",
 "title": "Duplicate record finder with blocking and weighted similarity",
 "purpose": "Find likely duplicate records by comparing only pairs that share a blocking key, scoring weighted field similarities (exact, normalized, token overlap, edit distance, digits, date) and grouping duplicates into clusters.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
