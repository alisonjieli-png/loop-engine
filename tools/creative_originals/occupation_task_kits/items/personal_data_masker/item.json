{
 "record_type": "creative_original_item/v1",
 "identity": "personal_data_masker",
 "title": "Personal data masker for free text",
 "purpose": "Replace personal identifiers in free text (emails, web addresses, IP addresses, card numbers, phone numbers, dates, ID numbers, ZIP codes, listed names and custom patterns) with numbered placeholders and return an inventory without the values.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
 "engine": {
  "name": "python",
  "minimum_version": "3.10"
 },
 "tags": [
  "privacy",
  "redaction",
  "pii",
  "masking",
  "health records",
  "student records"
 ],
 "files": [
  {
   "path": "README.md",
   "role": "other"
  },
  {
   "path": "personal_data_masker.py",
   "role": "executable_tool"
  },
  {
   "path": "PROCEDURE.md",
   "role": "skill_reference"
  },
  {
   "path": "TOOLS.md",
   "role": "other"
  },
