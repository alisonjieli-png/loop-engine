   "role": "other"
  }
 ],
 "contract": {
  "entry_points": {
   "module": "personal_data_masker",
   "function": "run",
   "command": "python3 personal_data_masker.py < input.json",
   "command_exit_codes": {
    "0": "result",
    "2": "refusal"
   }
  },
  "input_schema": {
   "type": "object",
   "required": [
    "text"
   ],
   "additionalProperties": false,
   "properties": {
    "text": {
     "type": "string",
     "maxLength": 500000,
     "description": "free text to mask"
    },
    "categories": {
     "type": "array",
     "items": {
      "enum": [
       "email",
       "url",
       "ip_address",
       "card_number",
       "id_number",
       "date",
       "phone",
       "postal_code",
       "name"
      ]
     },
     "uniqueItems": true,
     "description": "categories to mask (default all but postal_code)"
    },
    "names": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2
     },
     "maxItems": 5000,
     "description": "known names to mask wherever they appear as whole words"
    },
    "custom_patterns": {
     "type": "array",
     "maxItems": 50,
     "description": "extra identifiers: label and pattern",
     "items": {
      "type": "object",
      "required": [
       "label",
       "pattern"
      ],
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,30}$"
       },
       "pattern": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "style": {
     "enum": [
      "numbered",
      "label"
     ],
     "description": "numbered gives [EMAIL_1] per distinct value; label gives [EMAIL] (default numbered)"
    }
   }
  },
  "output_schema": {
   "type": "object",
   "required": [
    "masked_text",
    "inventory",
    "findings",
    "categories_checked"
   ],
   "properties": {
    "masked_text": {
     "type": "string"
    },
    "inventory": {
     "type": "object",
     "description": "category to count of masked occurrences"
    },
    "findings": {
     "type": "array",
     "description": "category, start, end (original text offsets), placeholder",
     "items": {
      "type": "object",
      "required": [
       "category",
       "start",
       "end",
       "placeholder"
      ]
     }
    },
    "categories_checked": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "refusal_reasons": [
   "input_invalid",
   "input_not_json",
   "invalid_pattern",
   "label_invalid"
  ],
  "examples": {
   "known_good": "examples/known_good.json",
   "known_wrong": "examples/known_wrong.json"
  },
  "effects": "none: a pure function of its JSON input; the command reads standard input and writes standard output",
