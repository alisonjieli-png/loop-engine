{
 "record_type": "creative_original_item/v1",
 "identity": "appointment_slot_allocator",
 "title": "Appointment slot allocator for providers and rooms",
 "purpose": "Place appointment requests into providers' free time by priority, service, date window, duration, buffer and preferred provider, and report what could not be placed and why.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
 "engine": {
  "name": "python",
  "minimum_version": "3.10"
 },
 "tags": [
  "scheduling",
  "appointments",
  "booking",
  "calendar",
  "capacity",
  "front desk"
 ],
 "files": [
  {
   "path": "README.md",
   "role": "other"
  },
  {
   "path": "appointment_slot_allocator.py",
   "role": "executable_tool"
  },
  {
   "path": "PROCEDURE.md",
   "role": "skill_reference"
  },
  {
   "path": "TOOLS.md",
   "role": "other"
  },
