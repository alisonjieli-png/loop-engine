   "path": "README.md",
   "role": "other"
  },
  {
   "path": "section_enrollment_allocator.py",
   "role": "executable_tool"
  },
  {
   "path": "PROCEDURE.md",
   "role": "skill_reference"
  },
  {
   "path": "TOOLS.md",
   "role": "other"
  },
  {
