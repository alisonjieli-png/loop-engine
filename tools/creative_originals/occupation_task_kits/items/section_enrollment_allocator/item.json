{
 "record_type": "creative_original_item/v1",
 "identity": "section_enrollment_allocator",
 "title": "Section enrollment allocator with prerequisites and waitlists",
 "purpose": "Seat students in course sections by priority group and registration time, honouring capacity, prerequisites, one section per course and time-block clashes, with ordered waitlists.",
 "form": "library_module",
 "asset_role": null,
 "dimension": "none",
 "engine": {
  "name": "python",
  "minimum_version": "3.10"
 },
 "tags": [
  "enrollment",
  "registration",
  "course sections",
  "waitlist",
  "prerequisites",
  "education"
 ],
