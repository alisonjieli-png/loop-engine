  "identity": "heightmap_terrain",
  "title": "Fractal noise terrain with islands, ridges and terraces",
  "purpose": "Generate a grid terrain from fractal gradient noise with ridged mode, island falloff, terraces, sea-level flattening and an optional closed base, plus a vertex group for the sea floor. Use it for landscapes, game maps, dioramas and printable relief models.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
