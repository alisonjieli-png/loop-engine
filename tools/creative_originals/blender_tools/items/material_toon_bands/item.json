{
  "record_type": "creative_original_item/v1",
  "identity": "material_toon_bands",
  "title": "Toon bands material from a fixed light direction",
  "purpose": "Build a cel-style material whose flat colour bands come from a half-Lambert term against a light direction given as a parameter, with an ink rim from the facing angle, emitted so it looks the same in Cycles, EEVEE and the viewport. Use it for stylized characters, props and illustrations.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
