      "path": "README.md",
      "role": "other"
    },
    {
      "path": "material_ceramic_tile.py",
      "role": "executable_tool"
    },
    {
      "path": "test_material_ceramic_tile.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
