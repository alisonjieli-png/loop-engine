  "title": "Glazed ceramic tile material with bevelled edges",
  "purpose": "Build a square tile node material from math nodes: grout lines, rounded tile edges by bump, a glossy glaze whose colour varies per tile from a cell hash, and rough grout. Use it for kitchens, bathrooms, pools and floors.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "blender",
    "minimum_version": "4.2"
  },
  "tags": [
