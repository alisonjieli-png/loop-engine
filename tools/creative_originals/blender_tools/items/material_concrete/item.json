{
  "record_type": "creative_original_item/v1",
  "identity": "material_concrete",
  "title": "Cast concrete material with pores and board seams",
  "purpose": "Build a concrete node material with water stains, aggregate specks from Voronoi cells, darkened and recessed air pores, and optional seams from board formwork every board width. Use it for brutalist architecture, floors, bunkers and urban scenes.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "blender",
    "minimum_version": "4.2"
  },
  "tags": [
    "blender",
    "material",
    "shader nodes",
    "concrete",
    "procedural texture",
    "architecture",
    "urban"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "material_concrete.py",
      "role": "executable_tool"
    },
    {
      "path": "test_material_concrete.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
    "module": "material_concrete",
    "entry_points": {
