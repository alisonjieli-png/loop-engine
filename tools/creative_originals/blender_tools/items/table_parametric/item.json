{
  "record_type": "creative_original_item/v1",
  "identity": "table_parametric",
  "title": "Parametric table with tapered, round or turned legs",
  "purpose": "Generate a table from overall size: a top with rounded corners, four inset legs in tapered, round or turned style, and aprons under the top, each a closed solid. Use it for interiors, product scenes and furniture blockouts.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "blender",
    "minimum_version": "4.2"
  },
  "tags": [
    "blender",
    "procedural",
    "furniture",
    "table",
    "interior",
    "mesh generator",
    "parametric"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "table_parametric.py",
      "role": "executable_tool"
    },
    {
      "path": "test_table_parametric.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
    "module": "table_parametric",
    "entry_points": {
      "core": "build_geometry",
      "blender": "create",
      "operator": "baltor.table_parametric",
      "expectations": "expectations"
