{
  "record_type": "creative_original_item/v1",
  "identity": "material_edge_wear",
  "title": "Edge wear material from the Bevel node",
  "purpose": "Build a painted-metal node material that wears through to bare metal along convex edges: the Bevel node normal is compared with the true normal, and the edge term is broken up by noise into chips. Use it for tools, vehicles, props and game assets that need handled edges.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "blender",
    "minimum_version": "4.2"
  },
