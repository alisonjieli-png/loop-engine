{
  "record_type": "creative_original_item/v1",
  "identity": "world_gradient_studio",
  "title": "Studio gradient world with a horizon band",
  "purpose": "Build a world that blends ground, horizon and zenith colours by the elevation of the view direction, with an adjustable horizon height and band softness and a separate backdrop strength for the camera. Use it for clean studio renders and stylized skies.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "blender",
    "minimum_version": "4.2"
  },
  "tags": [
    "blender",
    "world",
    "gradient",
    "studio",
    "backdrop",
    "lighting",
    "stylized"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "world_gradient_studio.py",
      "role": "executable_tool"
    },
    {
      "path": "test_world_gradient_studio.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
    "module": "world_gradient_studio",
    "entry_points": {
      "core": "world_graph",
      "blender": "create",
      "operator": "baltor.world_gradient_studio",
      "expectations": "expectations"
    },
    "parameters": [
      {
        "name": "ground_color",
        "type": "vector",
        "default": [
          0.06,
          0.055,
          0.05
        ],
        "minimum": 0.0,
        "maximum": 1.0,
        "unit": "linear RGB",
        "description": "Colour below the horizon."
      },
      {
        "name": "horizon_color",
        "type": "vector",
        "default": [
          0.55,
          0.55,
          0.58
        ],
        "minimum": 0.0,
        "maximum": 1.0,
        "unit": "linear RGB",
        "description": "Colour of the horizon band."
      },
      {
        "name": "zenith_color",
        "type": "vector",
        "default": [
          0.12,
          0.16,
          0.28
        ],
        "minimum": 0.0,
        "maximum": 1.0,
        "unit": "linear RGB",
        "description": "Colour straight up."
      },
      {
        "name": "horizon_height",
        "type": "float",
        "default": 0.0,
        "minimum": -60.0,
        "maximum": 60.0,
        "unit": "degree",
        "description": "Elevation of the horizon band."
      },
      {
        "name": "softness",
        "type": "float",
        "default": 12.0,
        "minimum": 0.5,
        "maximum": 90.0,
        "unit": "degree",
        "description": "Half the height of the horizon band."
      },
      {
        "name": "strength",
        "type": "float",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 100.0,
        "unit": "ratio",
        "description": "Strength of the light the world casts."
      },
      {
        "name": "camera_strength",
        "type": "float",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 100.0,
        "unit": "ratio",
        "description": "Strength of the backdrop as the camera sees it."
      }
    ],
    "outputs": {
      "kind": "node_graph",
      "description": "A world named Baltor Gradient Studio set as the scene world.",
      "at_defaults": {
        "nodes": 8,
        "links": 7
      }
    },
    "units": "metres",
    "axes": "Blender Z up, -Y forward",
    "blender_minimum": "4.2",
    "verification": {
      "fixture": "monkey",
      "preview": {
        "floor": true,
        "lights": "scene",
        "view": [
          0.3,
          -1.4,
          0.35
        ]
      }
    }
  },
  "limits": "A smooth three-colour gradient: no sun, clouds or image detail, so it gives soft light without shadows from a direction. The camera strength uses the Light Path node, which EEVEE honours only partly. Rendered here with Cycles CPU only. Verified in Blender 5.2.1; written for the 4.2 API.",
  "related": [
    "world_hdri_environment",
    "world_sky_sun",
    "infinite_backdrop"
  ],
  "technique_references": [
    "Elevation from the Z component of the world direction",
    "Colour ramp with stops at sin(elevation) positions",
    "Light Path camera ray mix for a separate backdrop strength"
  ],
  "native_checks": [
    "addon_install_and_enable",
    "operator_runs_with_defaults",
    "blender_data_matches_core",
    "addon_disable_unregisters",
    "script_mode_runs",
    "clean_reopen_addon_file",
    "clean_reopen_script_file",
    "gltf_separate_export",
    "engine_output_clean"
  ]
}
