{
  "record_type": "creative_original_item/v1",
  "identity": "fog_volume_height",
  "title": "Height fog volume with exponential falloff",
  "purpose": "Add a box of volumetric fog whose density falls off exponentially with height above its base and drifts in noise patches, with scattering colour and anisotropy, shown as bounds in the viewport. Use it for morning mist, valleys, dungeons and atmospheric depth.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "blender",
    "minimum_version": "4.2"
  },
  "tags": [
    "blender",
    "volume",
    "fog",
    "atmosphere",
    "lighting",
    "principled volume",
    "cycles"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "fog_volume_height.py",
      "role": "executable_tool"
    },
    {
      "path": "test_fog_volume_height.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
    "module": "fog_volume_height",
    "entry_points": {
      "core": "build_geometry",
      "blender": "create",
      "operator": "baltor.fog_volume_height",
      "expectations": "expectations"
    },
    "parameters": [
      {
        "name": "size",
        "type": "vector",
        "default": [
          6.0,
          6.0,
          3.0
        ],
        "minimum": 0.01,
        "maximum": 100000.0,
        "unit": "m",
        "description": "Width, depth and height of the fog box."
      },
      {
        "name": "density",
        "type": "float",
        "default": 0.25,
        "minimum": 0.0,
        "maximum": 1000.0,
        "unit": "1/m",
        "description": "Fog density at the bottom of the box."
      },
      {
        "name": "falloff",
        "type": "float",
        "default": 1.2,
        "minimum": 0.001,
        "maximum": 100000.0,
        "unit": "m",
        "description": "Height over which the density falls to 1 / e (about 37 percent)."
      },
      {
        "name": "breakup",
        "type": "float",
        "default": 0.6,
        "minimum": 0.0,
        "maximum": 1.0,
        "unit": "ratio",
        "description": "How much noise varies the density, as a share of it."
      },
      {
        "name": "noise_scale",
        "type": "float",
        "default": 0.35,
        "minimum": 0.001,
        "maximum": 1000.0,
        "unit": "1/m",
        "description": "Frequency of the noise patches."
      },
      {
        "name": "color",
        "type": "vector",
        "default": [
          0.85,
          0.88,
          0.92
        ],
        "minimum": 0.0,
        "maximum": 1.0,
        "unit": "linear RGB",
        "description": "Scattering colour of the fog."
      },
      {
        "name": "anisotropy",
        "type": "float",
        "default": 0.3,
        "minimum": -0.95,
        "maximum": 0.95,
        "unit": "ratio",
        "description": "Forward (positive) or backward (negative) scattering."
      }
    ],
    "outputs": {
      "kind": "mesh",
