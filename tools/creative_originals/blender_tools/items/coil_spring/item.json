      {
        "name": "wire_sides",
        "type": "int",
        "default": 10,
        "minimum": 3,
        "maximum": 48,
        "unit": "count",
        "description": "Sides of the round wire section."
      },
      {
        "name": "shear_modulus",
        "type": "float",
        "default": 79300000000.0,
        "minimum": 1000000.0,
        "maximum": 500000000000.0,
        "unit": "Pa",
        "description": "Shear modulus G of the wire material (spring steel is about 79.3 GPa)."
