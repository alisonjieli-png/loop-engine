  "title": "Helical compression spring with spring rate",
  "purpose": "Generate a compression spring as a round wire swept along a helix with closed end coils, and report its free length, solid length and spring rate from the wire material. Use it for mechanisms, suspension props and machine details.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
