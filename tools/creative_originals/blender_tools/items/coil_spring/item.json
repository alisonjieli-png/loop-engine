        "description": "Wire diameter d."
      },
      {
        "name": "active_coils",
        "type": "float",
        "default": 6.0,
        "minimum": 0.5,
        "maximum": 200.0,
        "unit": "turns",
        "description": "Active coils n between the closed ends."
