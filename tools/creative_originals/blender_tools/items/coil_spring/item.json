    "parameters": [
      {
        "name": "mean_diameter",
        "type": "float",
        "default": 0.04,
        "minimum": 0.002,
        "maximum": 5.0,
        "unit": "m",
        "description": "Mean coil diameter D, centre of wire to centre of wire."
