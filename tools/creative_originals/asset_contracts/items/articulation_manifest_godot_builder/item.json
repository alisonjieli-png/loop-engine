  },
  "limits": "Hinges and sliders only; no ball, planar or coupled joints. Axes and pivots are in the moving node's own frame at rest. The Godot node moves nodes by transform, not with physics joints, and its clips approximate a hinge arc with ten linear steps (exact at every step). Node names are matched exactly against the glTF names, so a renamed node breaks the binding. The saved scene embeds meshes and materials as sub-resources.",
  "related": [
    "asset_specification_schema",
    "articulation_loss_checker",
    "gltf_semantic_recovery"
  ],
  "technique_references": [
    "Forward kinematics with rest transform times joint motion",
    "Rotation about an axis through a pivot: T(p) R(axis, angle) T(-p)",
    "Godot 4 GLTFDocument and GLTFState run-time loading, AnimationLibrary, PackedScene.pack with owners",
    "JSON Schema draft 2020-12"
  ],
  "native_checks": [
    "checker_matches_contract",
    "schema_agrees_with_jsonschema",
    "godot_moves_each_joint_to_its_limits",
    "godot_joint_player_reaches_each_limit",
    "godot_reopens_the_built_scene",
    "godot_builder_refuses_each_known_wrong_binding",
    "blender_finds_every_bound_node"
  ]
