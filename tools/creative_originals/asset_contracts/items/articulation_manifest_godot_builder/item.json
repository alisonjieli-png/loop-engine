  "contract": {
    "entry_points": [
      {
        "name": "read_manifest",
        "kind": "function",
        "signature": "read_manifest(value, document, report) -> list of bound joints"
      },
      {
        "name": "joint_motion",
        "kind": "function",
        "signature": "joint_motion(joint, value) -> 4x4 local motion"
      },
      {
        "name": "pose",
        "kind": "function",
        "signature": "pose(document, joints, values) -> node index -> world matrix"
      },
      {
        "name": "predictions",
        "kind": "function",
        "signature": "predictions(document, joints) -> per joint world matrix and pivot at both limits"
      },
      {
        "name": "check",
        "kind": "function",
        "signature": "check(asset_path, manifest_path) -> asset_report.Report"
      },
      {
        "name": "run",
        "kind": "function",
        "signature": "run(argv: list) -> dict (the JSON report)"
      },
      {
        "name": "main",
        "kind": "command_line",
        "usage": "python3 articulation_manifest_godot_builder.py ASSET.gltf --manifest MANIFEST.json"
      },
      {
        "name": "godot/articulated_asset.gd",
        "kind": "godot_node_script",
        "usage": "preload, .new(), add to the tree, load_asset(gltf, manifest), set_joint(name, value), build_animation_player(), save_scene(path)"
      },
      {
        "name": "godot/articulation_probe.gd",
        "kind": "godot_scene_tree_script",
        "usage": "godot --headless --path PROJECT --script res://articulation_probe.gd -- OUT.json load ASSET.gltf MANIFEST.json [SAVE.tscn]"
      },
      {
        "name": "schema.json",
        "kind": "json_schema",
        "dialect": "https://json-schema.org/draft/2020-12/schema"
      }
    ],
    "inputs": [
      {
        "name": "asset",
        "format": "glTF 2.0 (.gltf or .glb)"
      },
      {
        "name": "manifest",
        "format": "articulation_manifest/v1 JSON (schema.json)"
      }
    ],
    "report": {
      "record_type": "asset_contract_report/v1",
      "tool": "articulation_manifest_godot_builder",
      "subject": "the asset file name",
      "ok": "true when every joint binds",
      "failures": "list of {code, where (joint name), detail}",
      "warnings": "joint_moves_nothing",
      "facts": "joints: per bound joint the node, type, limits, and at each limit the world_matrix (3 rows of 4) and world_pivot"
    },
    "failures_detected": [
      "asset_unreadable",
      "manifest_invalid",
      "joint_type_invalid",
      "node_missing",
      "node_ambiguous",
      "node_jointed_twice",
      "axis_invalid",
      "pivot_invalid",
      "limits_invalid",
      "joint_name_repeated"
    ],
    "proves": "Every joint names exactly one node, no node carries two joints, axes are unit vectors, pivots are finite, and limits are ordered around the rest value; the reported poses are the forward kinematics of the manifest.",
    "does_not_prove": "That the motion is free of collisions, that the limits match the real object, or that a physics engine would behave the same way (the Godot node sets transforms; it adds no physics joints).",
    "fixtures": [
      {
