  "identity": "articulation_loss_checker",
  "title": "Articulation loss checker for exports that drop joint information",
  "purpose": "Catch exports that keep every mesh but lose what joints need: parts joined into their parent, origins moved off the hinge, node frames rotated, hierarchies flattened, and joint records in custom properties left out by a default export.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "articulation",
    "joints",
    "export",
    "gltf",
    "blender",
    "pivot",
    "extras",
    "regression check"
  ],
