  "contract": {
    "entry_points": [
      {
        "name": "joint_facts",
        "kind": "function",
        "signature": "joint_facts(asset, joint) -> presence, parent, has_geometry, world_pivot, world_axis, extras"
      },
      {
        "name": "compare",
        "kind": "function",
        "signature": "compare(joints, export, reference, extras_required, tolerance_m, tolerance_deg, report) -> rows"
      },
      {
        "name": "check",
        "kind": "function",
        "signature": "check(export_path, manifest_path, reference_path=None, extras_required=False, tolerance_m=0.001, tolerance_deg=0.5) -> asset_report.Report"
      },
      {
        "name": "run",
        "kind": "function",
        "signature": "run(argv: list) -> dict (the JSON report)"
      },
      {
        "name": "main",
        "kind": "command_line",
        "usage": "python3 articulation_loss_checker.py EXPORT.gltf --manifest MANIFEST.json [--reference REFERENCE.gltf] [--extras required]"
      }
    ],
    "inputs": [
      {
        "name": "export",
        "format": "the exported glTF 2.0 (.gltf or .glb)"
      },
      {
        "name": "manifest",
        "format": "articulation_manifest/v1 JSON"
      },
      {
        "name": "reference",
        "format": "a glTF export known to keep the joints",
        "optional": true
      },
      {
        "name": "extras",
        "format": "required or optional: whether each joint node must carry extras.joint"
      }
    ],
    "report": {
      "record_type": "asset_contract_report/v1",
      "tool": "articulation_loss_checker",
      "subject": "the export file name",
      "ok": "true when every joint survives",
      "failures": "list of {code, where (joint name), detail}",
      "warnings": "none",
      "facts": "joints (per joint the export facts and, with a reference, the reference facts: present, count, parent, has_geometry, world_pivot, world_axis, extras), reference, extras_required"
    },
    "failures_detected": [
      "asset_unreadable",
      "reference_unreadable",
      "manifest_invalid",
      "joint_node_missing",
      "joint_node_ambiguous",
      "joint_node_without_geometry",
      "pivot_moved",
      "joint_axis_changed",
      "joint_parent_changed",
      "joint_extras_missing",
      "joint_extras_mismatch"
    ],
    "proves": "Each joint's node exists exactly once with geometry at or below it; with a reference, its world pivot, world axis and parent are unchanged within tolerance (1 mm, 0.5 degrees by default); with extras required, its node carries a joint record equal to the manifest.",
    "does_not_prove": "That the joint moves the right geometry, or that the joint values are sensible. A reference export must itself be right: the tool compares, it does not judge the reference.",
