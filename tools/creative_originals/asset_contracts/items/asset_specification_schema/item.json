          "joint_axis_zero"
        ]
      },
      {
        "argv": [
          "fixtures/bad_clip_target.spec.json"
        ],
        "expect": "fail",
        "codes": [
          "clip_target_unknown"
        ]
      },
      {
        "argv": [
          "fixtures/bad_behavior_reference.spec.json"
        ],
        "expect": "fail",
        "codes": [
