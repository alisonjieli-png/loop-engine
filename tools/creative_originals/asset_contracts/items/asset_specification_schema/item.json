        ]
      },
      {
        "argv": [
          "fixtures/bad_negative_dimension.spec.json"
        ],
        "expect": "fail",
        "codes": [
          "schema_violation"
        ]
      },
      {
        "argv": [
          "fixtures/bad_unknown_field.spec.json"
        ],
        "expect": "fail",
        "codes": [
          "schema_violation"
        ]
      },
      {
        "argv": [
          "fixtures/bad_material_unknown.spec.json"
        ],
        "expect": "fail",
        "codes": [
