        ]
      },
      {
        "argv": [
          "fixtures/bad_dotted_name.spec.json"
        ],
        "expect": "fail",
        "codes": [
          "schema_violation"
        ]
      }
    ]
  },
  "limits": "Rest poses carry no rotation: the blockout places parts by translation only, and joint axes are read in the asset frame. Names are limited to letters, digits, underscore, space and hyphen so that Godot and Blender keep them unchanged. Continuous and fixed joints get no limit clip. The standard-library schema check implements the keywords this schema uses, not all of JSON Schema.",
  "related": [
    "gltf_semantic_recovery",
    "articulation_manifest_godot_builder",
    "animation_export_trap_checker"
  ],
  "technique_references": [
    "JSON Schema draft 2020-12: type, properties, required, additionalProperties, $ref and $defs",
    "Parent chain walking for cycle detection",
    "Axis-angle to unit quaternion conversion",
    "glTF 2.0 specification: nodes, meshes and animation channels"
  ],
  "native_checks": [
    "checker_matches_contract",
    "schema_agrees_with_jsonschema",
    "godot_realises_each_valid_specification",
    "blender_realises_each_valid_specification"
  ]
}
