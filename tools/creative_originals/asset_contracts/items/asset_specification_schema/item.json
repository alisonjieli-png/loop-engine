{
  "record_type": "creative_original_item/v1",
  "identity": "asset_specification_schema",
  "title": "Asset specification schema with validator and blockout generator",
  "purpose": "Declare what a 3D asset must be before it is modelled: parts with parents, dimensions, centres, pivots and materials; joints with axes and limits; clips and behaviors. Validate a specification and generate a placeholder glTF that realises it.",
  "form": "schema",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "json schema",
    "asset specification",
    "contract",
    "joints",
    "blockout",
    "gltf",
    "3d asset",
    "validator"
  ],
