{
  "record_type": "creative_original_item/v1",
  "identity": "gltf_structural_validator",
  "title": "glTF 2.0 structural validator",
  "purpose": "Check that a .gltf or .glb file is internally consistent before an engine loads it: buffers, views, accessors, indices, materials, textures, the node graph, skins and animation samplers. Run it after every export and before every import.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
