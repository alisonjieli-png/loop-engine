  },
  "limits": "Pure Python: an asset with one million vertices and one million indices took about 8 seconds on the build host under load (October 9, 2026). Extension contents (KHR_*, EXT_*) are not validated, only extensionsRequired against extensionsUsed. Images are checked for existence and PNG or JPEG magic bytes, not decoded. Sparse accessors, matrix column padding and GLB containers are supported. Animation pointer targets are accepted without further checks. Rules of the specification outside the listed failure codes are not checked.",
  "related": [
    "gltf_semantic_recovery",
    "animation_export_trap_checker",
    "web_delivery_budget_checker"
  ],
  "technique_references": [
    "glTF 2.0 specification: buffers, buffer views and accessors (alignment, byte stride, sparse storage, min and max)",
    "glTF 2.0 specification: meshes, primitives, attribute semantics and morph targets",
    "glTF 2.0 specification: nodes, scenes, skins and animations (samplers, interpolation, output counts)",
    "Iterative depth-first search with open and done marks for cycle detection"
  ],
  "native_checks": [
    "checker_matches_contract",
    "godot_agrees_on_known_good",
    "blender_agrees_on_known_good",
    "known_wrong_refused_with_engine_reactions"
  ]
