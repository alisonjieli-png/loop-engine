  "contract": {
    "entry_points": [
      {
        "name": "validate_file",
        "kind": "function",
        "signature": "validate_file(path) -> asset_report.Report"
      },
      {
        "name": "validate",
        "kind": "function",
        "signature": "validate(asset: gltfio.Asset, subject: str = '') -> asset_report.Report"
      },
      {
        "name": "run",
        "kind": "function",
        "signature": "run(argv: list) -> dict (the JSON report)"
      },
      {
        "name": "main",
        "kind": "command_line",
        "usage": "python3 gltf_structural_validator.py ASSET.gltf"
      }
    ],
    "inputs": [
      {
        "name": "asset",
        "format": "glTF 2.0 JSON (.gltf with embedded base64 or sibling buffers) or binary glTF (.glb)"
      }
    ],
    "report": {
      "record_type": "asset_contract_report/v1",
      "tool": "gltf_structural_validator",
      "subject": "the file name",
      "ok": "true exactly when no rule failed",
      "failures": "list of {code, where, detail}",
      "warnings": "list of {code, where, detail}: buffer_longer_than_declared, primitive_without_positions, texture_without_source, image_format_unrecognized, node_unreachable",
      "facts": "counts per top-level array, container, generator, extensions_used, node_names, mesh_names, material_names, animation_names; when no rule failed also triangles, scene_bounds (metres, glTF axes) and animations (name, duration, channels)"
    },
    "failures_detected": [
      "file_unreadable",
      "json_invalid",
      "asset_header_invalid",
      "asset_version_unsupported",
      "property_type_invalid",
      "extension_required_not_used",
      "buffer_invalid",
      "buffer_unresolved",
      "buffer_length_mismatch",
      "buffer_reference_invalid",
      "buffer_view_out_of_range",
      "byte_stride_invalid",
      "buffer_view_target_invalid",
      "buffer_view_reference_invalid",
      "accessor_type_invalid",
      "accessor_count_invalid",
      "accessor_normalized_invalid",
      "accessor_misaligned",
      "accessor_out_of_bounds",
      "accessor_min_max_invalid",
      "accessor_min_max_mismatch",
      "accessor_min_max_missing",
      "accessor_value_not_finite",
      "accessor_reference_invalid",
      "sparse_invalid",
      "mesh_primitive_invalid",
      "attribute_type_invalid",
      "attribute_count_mismatch",
      "index_type_invalid",
      "index_out_of_range",
      "index_restart_value",
      "primitive_mode_invalid",
      "primitive_count_invalid",
      "material_reference_invalid",
      "morph_target_invalid",
      "material_value_invalid",
      "texture_reference_invalid",
      "sampler_reference_invalid",
      "sampler_value_invalid",
      "image_reference_invalid",
      "image_source_invalid",
      "image_unresolved",
      "node_reference_invalid",
      "mesh_reference_invalid",
      "skin_reference_invalid",
      "camera_reference_invalid",
      "node_transform_conflict",
      "node_transform_invalid",
      "node_rotation_not_unit",
      "node_multiple_parents",
      "node_cycle",
      "node_skin_without_mesh",
      "scene_reference_invalid",
      "scene_node_not_root",
      "skin_joint_invalid",
      "skin_inverse_bind_invalid",
      "skin_inverse_bind_count_mismatch",
      "skin_skeleton_not_ancestor",
      "skin_attributes_missing",
      "skin_joint_index_out_of_range",
      "animation_sampler_reference_invalid",
      "animation_target_invalid",
      "animation_channel_duplicate",
      "animation_input_invalid",
      "animation_input_negative",
      "animation_input_not_increasing",
      "animation_interpolation_invalid",
      "animation_output_invalid",
      "animation_output_count_mismatch"
    ],
    "proves": "Every index the file uses points at an existing entry; every accessor lies inside its buffer view and buffer, is aligned, and its declared min and max equal the data; primitives have consistent attribute counts and in-range indices; the node graph is a forest with one parent per node; skins and animation samplers have the counts and types the glTF 2.0 data model requires.",
    "does_not_prove": "That the asset looks right, has sensible dimensions, names or materials, that its extensions are supported by a given engine, that textures decode, or that animation motion is plausible. It is not the Khronos glTF-Validator and does not implement every rule of the specification.",
    "fixtures": [
      {
        "argv": [
          "fixtures/good_door.gltf"
        ],
        "expect": "pass"
      },
      {
        "argv": [
          "fixtures/good_skinned_strip.gltf"
        ],
        "expect": "pass"
      },
