    "articulation_manifest_godot_builder"
  ],
  "technique_references": [
    "Godot 4 text scene and resource format: sections, header attributes, multi-line values",
    "Bracket and string aware scanning of multi-line values",
    "Scene tree path resolution with instanced sub-scenes"
  ],
  "native_checks": [
