  "contract": {
    "entry_points": [
      {
        "name": "parse",
        "kind": "function",
        "signature": "parse(text) -> list of sections {kind, attributes, properties: [(key, raw value, line)], line}; raises ParseError"
      },
      {
        "name": "node_paths",
        "kind": "function",
        "signature": "node_paths(path, project) -> every node path a scene defines, with the nodes of instanced scenes"
      },
      {
        "name": "lint",
        "kind": "function",
        "signature": "lint(path, project=None) -> asset_report.Report"
      },
      {
        "name": "run",
        "kind": "function",
        "signature": "run(argv: list) -> dict (the JSON report)"
      },
      {
        "name": "main",
        "kind": "command_line",
        "usage": "python3 godot_scene_linter.py FILE.tscn [--project PROJECT_FOLDER]"
      }
    ],
    "inputs": [
      {
        "name": "file",
        "format": "Godot text scene (.tscn) or text resource (.tres), format 3 or 4 (format 2 with a warning)"
      },
      {
        "name": "project",
        "format": "the folder holding project.godot; found by walking up from the file when omitted",
        "optional": true
      }
    ],
    "report": {
      "record_type": "asset_contract_report/v1",
      "tool": "godot_scene_linter",
      "subject": "the file name",
      "ok": "true when no rule fails",
      "failures": "list of {code, where (line), detail}",
      "warnings": "project_root_unknown, godot3_format, ext_resource_unused, sub_resource_unused",
      "facts": "kind, format, project, ext_resources (id, type, path, exists), sub_resources (id, type), nodes (path, name, type, instance), connections"
    },
    "failures_detected": [
      "file_unreadable",
      "syntax_invalid",
      "header_invalid",
      "format_unsupported",
      "ext_resource_invalid",
      "ext_resource_id_repeated",
      "ext_resource_missing_file",
      "ext_resource_reference_unknown",
      "sub_resource_id_repeated",
      "sub_resource_reference_unknown",
      "sub_resource_forward_reference",
      "root_node_count",
      "node_parent_missing",
      "node_name_repeated",
      "node_type_missing",
      "connection_node_missing",
      "resource_section_missing"
    ],
    "proves": "The file parses; every res:// external resource exists under the project root; every ExtResource and SubResource id is declared, sub-resources before their first use; the scene has one root, every node a known parent (including nodes of instanced scenes), a type or an instance, and a unique name among its siblings; every connection joins existing nodes.",
    "does_not_prove": "That property values are valid for their class, that scripts compile, that signals and methods exist, or that uid:// references resolve (the uid cache is not read).",
