{
  "record_type": "creative_original_item/v1",
  "identity": "duoprism",
  "title": "Duoprisms as products of two polygons",
  "purpose": "Build any {p}x{q} duoprism exactly (pq vertices, two rings of prisms), with unit-edge or equal radii, check its counts and volume against the product formulas, and write exploded prisms, a wireframe glTF or a polytope JSON record.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "4d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "4d",
    "duoprism",
    "product polytope",
    "prism ring",
    "polygon",
    "clifford torus",
    "polytope",
    "gltf"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "duoprism.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "entry_points": [
      "radii",
      "polytope",
      "polygon_area",
      "expected_counts",
      "is_uniform",
      "tesseract_check",
      "mesh",
      "export",
      "invariants",
      "controls",
      "main"
    ],
    "parameters": [
      {
        "flag": "--p",
        "type": "int",
        "default": 5,
        "meaning": "sides of the xy polygon"
      },
      {
        "flag": "--q",
        "type": "int",
        "default": 7,
        "meaning": "sides of the zw polygon"
      },
      {
        "flag": "--radii",
        "type": "choice",
        "choices": [
          "uniform",
          "equal"
        ],
        "default": "uniform",
        "meaning": "unit edges or both radii 1"
      },
      {
        "flag": "--rotate",
        "type": "text",
        "default": "xw=0.5,yz=0.3",
        "meaning": "plane rotations applied in order"
      },
      {
        "flag": "--project",
        "type": "choice",
        "choices": [
          "perspective",
          "stereographic",
          "orthographic"
        ],
        "default": "perspective",
        "meaning": "4D to 3D projection"
      },
      {
        "flag": "--eye",
        "type": "float",
        "default": 2.6,
        "meaning": "4D eye distance in circumradii"
      },
      {
        "flag": "--style",
        "type": "choice",
        "choices": [
          "cells",
          "tubes",
          "lines"
        ],
        "default": "cells",
        "meaning": "exploded prisms, tubes or LINES"
      },
      {
        "flag": "--shrink",
        "type": "float",
        "default": 0.86,
        "meaning": "cell scale toward its own centroid"
      },
      {
        "flag": "--tube",
        "type": "float",
        "default": 0.025,
        "meaning": "tube radius in circumradii"
      },
      {
        "flag": "--cells",
        "type": "choice",
        "choices": [
          "front",
          "all"
        ],
        "default": "front",
        "meaning": "cells style: only cells facing the 4D eye, or all cells"
      },
      {
        "flag": "--out",
        "type": "path",
        "default": null,
        "meaning": ".gltf model or .json polytope record"
      }
    ],
