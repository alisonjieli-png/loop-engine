    }
  ],
  "contract": {
    "class_name": "BaltorTransitionTable",
    "extends": "RefCounted",
    "signals": [
      {
        "name": "transitioned",
        "arguments": [
          "from_state: StringName",
          "to_state: StringName",
          "event: StringName"
        ]
      },
      {
        "name": "event_ignored",
        "arguments": [
          "state: StringName",
          "event: StringName"
        ]
      }
    ],
    "exports": [],
    "methods": [
      {
        "name": "register_guard",
        "arguments": [
          "guard_name: StringName",
          "guard: Callable"
        ],
        "returns": "void"
      },
      {
        "name": "register_action",
        "arguments": [
          "action_name: StringName",
          "action: Callable"
        ],
        "returns": "void"
      },
      {
        "name": "load_table",
        "arguments": [
          "table: Dictionary"
        ],
        "returns": "bool"
      },
      {
        "name": "get_errors",
        "arguments": [],
        "returns": "PackedStringArray"
      },
      {
        "name": "fire",
        "arguments": [
          "event: StringName",
          "payload: Dictionary = {}"
        ],
        "returns": "bool"
      },
      {
        "name": "get_state",
        "arguments": [],
        "returns": "StringName"
      },
      {
        "name": "reset",
        "arguments": [],
        "returns": "void"
      },
      {
        "name": "available_events",
        "arguments": [],
        "returns": "PackedStringArray"
      }
    ],
    "placement": "res://baltor/godot_components/event_transition_table/",
    "depends_on": []
  },
  "limits": "Flat states only. Guards and actions must be registered before load_table(). The first matching row wins; there are no priorities beyond table order and exact-before-wildcard. door_table.json is sample data. Verified with Godot 4.7.2 headless; written against the Godot 4.3 API.",
