{
  "record_type": "creative_original_item/v1",
  "identity": "event_transition_table",
  "title": "Data-driven state machine from a JSON transition table",
  "purpose": "Load states and event transitions from a Dictionary or JSON file, with wildcard rows, named guards and named actions registered in code, validation that refuses malformed tables, and signals for taken and ignored events.",
  "form": "library_module",
  "dimension": "none",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
