        "arguments": [
          "position: Vector2",
          "velocity: Vector2",
          "target_position: Vector2",
          "target_velocity: Vector2",
          "max_speed: float",
          "max_prediction: float = 1.0"
        ],
        "returns": "Vector2",
        "static": true
      },
      {
        "name": "evade",
        "arguments": [
