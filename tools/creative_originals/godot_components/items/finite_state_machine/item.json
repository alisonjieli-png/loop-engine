  "contract": {
    "class_name": "BaltorStateMachine",
    "extends": "Node",
    "signals": [
      {
        "name": "state_changed",
        "arguments": [
          "previous: StringName",
          "current: StringName"
        ]
      },
      {
        "name": "transition_refused",
