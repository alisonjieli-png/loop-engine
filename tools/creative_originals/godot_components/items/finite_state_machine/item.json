  "identity": "finite_state_machine",
  "title": "Finite state machine with child-node states",
  "purpose": "Run one active state at a time from child nodes, with ordered exit and enter calls, an optional transition table, queued requests and a bounded history. Use it for characters, menus, doors and game flow.",
  "form": "library_module",
  "dimension": "none",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
