        "type": "StringName",
        "default": "&\"\""
      },
      {
        "name": "auto_start",
        "type": "bool",
        "default": true
      },
      {
        "name": "allowed_transitions",
        "type": "Dictionary",
        "default": "{}"
      },
      {
        "name": "history_size",
        "type": "int",
        "default": 8,
        "annotation": "@export_range(0, 64)"
      }
    ],
    "methods": [
      {
        "name": "start",
        "arguments": [
          "data: Dictionary = {}"
        ],
        "returns": "bool"
      },
      {
        "name": "stop",
        "arguments": [],
        "returns": "void"
      },
      {
        "name": "transition_to",
        "arguments": [
          "state_name: StringName",
          "data: Dictionary = {}"
        ],
        "returns": "bool"
      },
      {
        "name": "go_back",
        "arguments": [
          "data: Dictionary = {}"
        ],
        "returns": "bool"
      },
      {
        "name": "has_state",
        "arguments": [
          "state_name: StringName"
        ],
        "returns": "bool"
      },
      {
        "name": "get_state_node",
        "arguments": [
          "state_name: StringName"
        ],
