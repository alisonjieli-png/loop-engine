{
  "record_type": "creative_original_item/v1",
  "identity": "buoyancy_probes_3d",
  "title": "Probe buoyancy and water drag for RigidBody3D",
  "purpose": "Float a RigidBody3D on water from probe points: depth-proportional upward force per probe, travelling sine waves for the surface height, water drag and signals for entering and leaving the water.",
