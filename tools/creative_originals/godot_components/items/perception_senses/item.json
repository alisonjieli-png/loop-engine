      {
        "name": "can_see",
        "arguments": [
          "observer: Vector2",
          "facing: Vector2",
          "target: Vector2",
          "occluded: Callable = Callable()"
        ],
        "returns": "bool"
      },
      {
        "name": "can_hear",
        "arguments": [
          "listener: Vector2",
          "source: Vector2",
          "loudness: float = 1.0"
        ],
        "returns": "bool"
      },
      {
        "name": "observe",
        "arguments": [
          "delta: float",
          "observer: Vector2",
          "facing: Vector2",
          "targets: Dictionary",
          "occluded: Callable = Callable()"
        ],
        "returns": "void"
      },
      {
        "name": "report_noise",
        "arguments": [
          "listener: Vector2",
          "source: Vector2",
          "loudness: float = 1.0"
        ],
        "returns": "bool"
      },
      {
        "name": "get_known_targets",
        "arguments": [],
        "returns": "Array[StringName]"
      },
      {
        "name": "is_visible",
        "arguments": [
          "target_id: StringName"
        ],
        "returns": "bool"
      },
      {
        "name": "get_last_known_position",
        "arguments": [
          "target_id: StringName"
        ],
        "returns": "Vector2"
      },
      {
        "name": "get_time_since_seen",
        "arguments": [
          "target_id: StringName"
        ],
        "returns": "float"
      },
      {
        "name": "get_last_noise",
        "arguments": [],
        "returns": "Dictionary"
      },
      {
        "name": "forget_all",
        "arguments": [],
        "returns": "void"
      }
    ],
