      "role": "skill_asset"
    }
  ],
  "contract": {
    "class_name": "BaltorPerception",
    "extends": "RefCounted",
    "signals": [
      {
        "name": "target_spotted",
        "arguments": [
          "target_id: StringName",
          "at: Vector2"
        ]
      },
      {
        "name": "target_lost",
        "arguments": [
          "target_id: StringName",
          "last_known: Vector2"
        ]
      },
      {
