{
  "record_type": "creative_original_item/v1",
  "identity": "perception_senses",
  "title": "AI perception with view cone, hearing and memory",
  "purpose": "Decide what a 2D agent sees (range, view cone, peripheral sense, optional occlusion check) and hears (radius times loudness), and remember targets with last known positions until a memory time runs out.",
  "form": "library_module",
  "dimension": "2d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
