{
  "record_type": "creative_original_item/v1",
  "identity": "trauma_screen_shake_2d",
  "title": "Trauma screen shake for Camera2D",
  "purpose": "Shake a Camera2D from a decaying trauma value: the shake is trauma to a power, and smooth seeded noise moves the offset and roll within set limits. The camera returns to its original offset and rotation when the shake ends.",
  "form": "library_module",
  "dimension": "2d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "camera",
    "screen shake",
    "trauma",
    "noise",
    "juice",
    "camera2d",
    "feedback"
  ],
