{
  "record_type": "creative_original_item/v1",
  "identity": "utility_ai",
  "title": "Utility AI scorer with response curves",
  "purpose": "Score named actions from considerations mapped through response curves (linear, polynomial, logistic, step, smoothstep) with compensated products, vetoes, weights and hysteresis, and pick the best action.",
  "form": "library_module",
  "dimension": "none",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "utility ai",
    "ai",
    "decision making",
    "response curves",
    "scoring",
    "npc"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "tests/test_utility_ai.gd",
      "role": "skill_asset"
    },
    {
      "path": "utility_ai.gd",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "class_name": "BaltorUtilityAI",
    "extends": "RefCounted",
    "signals": [
      {
        "name": "action_changed",
        "arguments": [
          "previous: StringName",
          "current: StringName"
        ]
      }
    ],
    "exports": [],
    "methods": [
      {
        "name": "add_action",
        "arguments": [
          "action_name: StringName",
          "weight: float = 1.0"
        ],
        "returns": "bool"
      },
      {
        "name": "add_consideration",
        "arguments": [
          "action_name: StringName",
          "input: Callable",
          "minimum: float",
          "maximum: float",
          "curve: Response = Response.LINEAR",
          "slope: float = 1.0",
          "exponent: float = 1.0",
          "x_shift: float = 0.0",
          "y_shift: float = 0.0"
        ],
        "returns": "bool"
      },
      {
        "name": "curve_value",
        "arguments": [
          "curve: Response",
          "x: float",
          "slope: float = 1.0",
          "exponent: float = 1.0",
          "x_shift: float = 0.0",
          "y_shift: float = 0.0"
        ],
        "returns": "float",
        "static": true
      },
      {
        "name": "score_action",
        "arguments": [
          "action_name: StringName",
          "context: Variant = null"
        ],
        "returns": "float"
      },
      {
        "name": "scores",
        "arguments": [
          "context: Variant = null"
        ],
        "returns": "Dictionary"
      },
      {
        "name": "choose",
        "arguments": [
          "context: Variant = null"
        ],
        "returns": "StringName"
      },
      {
        "name": "get_current",
        "arguments": [],
        "returns": "StringName"
      },
      {
        "name": "get_actions",
        "arguments": [],
        "returns": "Array[StringName]"
      }
    ],
    "placement": "res://baltor/godot_components/utility_ai/",
    "depends_on": [],
    "properties": [
      {
        "name": "current_bonus",
        "type": "float"
      }
    ],
    "enums": [
      {
        "name": "Response",
        "values": [
          "LINEAR",
          "POLYNOMIAL",
          "LOGISTIC",
          "STEP",
          "SMOOTHSTEP"
        ]
      }
    ]
  },
  "limits": "Chooses the single best action; no weighted random among the top choices. Scores are only as good as the considerations and curve parameters, which need tuning per game. Verified with Godot 4.7.2 headless; written against the Godot 4.3 API.",
  "related": [],
  "technique_references": [
    "utility-based AI",
    "response curves",
    "compensation factor for multiplied considerations",
    "hysteresis bonus"
  ],
  "native_checks": [
    "godot_parse_check_only",
    "godot_gdscript_tests",
    "godot_tests_reject_gutted_component",
    "godot_editor_import",
    "godot_contract_reflection",
    "godot_readme_usage_compiles"
  ]
}
