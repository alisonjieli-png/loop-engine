{
  "record_type": "creative_original_item/v1",
  "identity": "zoom_to_fit_2d",
  "title": "Group camera that zooms to fit several targets",
  "purpose": "Center a Camera2D on several targets and zoom so all of them fit with a margin, within zoom limits and with smoothing, for local multiplayer and boss fights.",
  "form": "library_module",
  "dimension": "2d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "camera",
    "camera2d",
    "zoom",
    "multiplayer",
    "framing",
    "group camera"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "tests/test_zoom_to_fit_2d.gd",
      "role": "skill_asset"
    },
    {
      "path": "zoom_to_fit_2d.gd",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "class_name": "BaltorGroupCamera2D",
    "extends": "Camera2D",
    "signals": [],
    "exports": [
      {
        "name": "targets",
        "type": "Array[NodePath]",
        "default": "[]"
      },
      {
        "name": "margin",
        "type": "float",
        "default": 64.0
      },
      {
        "name": "min_zoom",
        "type": "float",
        "default": 0.25
      },
      {
        "name": "max_zoom",
        "type": "float",
        "default": 2.0
      },
      {
        "name": "follow_speed",
        "type": "float",
        "default": 4.0
      }
    ],
    "methods": [
      {
        "name": "fit",
        "arguments": [
          "points: PackedVector2Array",
          "view_size: Vector2",
          "border: float",
          "smallest: float",
          "largest: float"
        ],
        "returns": "Dictionary",
        "static": true
      },
      {
        "name": "update_camera",
        "arguments": [
          "points: PackedVector2Array",
          "view_size: Vector2",
          "delta: float"
        ],
        "returns": "void"
      }
    ],
    "placement": "res://baltor/godot_components/zoom_to_fit_2d/",
    "depends_on": []
  },
  "limits": "Fits the axis-aligned bounds of target positions, not their sprites; raise the margin for large characters. Uses the viewport size, so stretch settings change the result. Verified with Godot 4.7.2 headless; written against the Godot 4.3 API.",
  "related": [],
  "technique_references": [
    "bounding box framing",
    "aspect-aware zoom fit",
    "exponential smoothing"
