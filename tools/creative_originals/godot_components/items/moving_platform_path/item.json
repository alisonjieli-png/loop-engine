        "arguments": [],
        "returns": "Vector2"
      },
      {
        "name": "get_target_index",
        "arguments": [],
        "returns": "int"
      },
      {
        "name": "is_waiting",
        "arguments": [],
        "returns": "bool"
      },
      {
        "name": "pause",
        "arguments": [],
