{
  "record_type": "creative_original_item/v1",
  "identity": "moving_platform_path",
  "title": "Waypoint moving platform that carries riders",
  "purpose": "Move an AnimatableBody2D through waypoint offsets at an exact speed, wait at each point, loop or ping-pong, and carry CharacterBody2D riders through the physics engine's platform sync.",
  "form": "library_module",
  "dimension": "2d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
