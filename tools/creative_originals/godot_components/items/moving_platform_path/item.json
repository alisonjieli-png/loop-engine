      }
    ],
    "placement": "res://baltor/godot_components/moving_platform_path/",
    "depends_on": []
  },
  "limits": "Straight segments only (no curves or easing). With sync_to_physics on, the shown position follows the physics step, so read get_current_point() for the logical position between frames. Verified with Godot 4.7.2 headless; written against the Godot 4.3 API.",
