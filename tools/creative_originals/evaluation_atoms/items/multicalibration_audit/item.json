{
  "record_type": "creative_original_item/v1",
  "identity": "multicalibration_audit",
  "title": "Multicalibration audit by prediction bin and group",
  "purpose": "Report the mean residual (outcome minus prediction) in every prediction bin for every declared group and for the whole population, flag cells beyond a tolerance, and repair violations by iterative patching. Finds miscalibration that cancels out in the overall reliability bins.",
  "form": "library_module",
  "dimension": "none",
  "engine": {"name": "python", "minimum_version": "3.10"},
  "tags": ["calibration", "multicalibration", "fairness audit", "subgroup analysis", "reliability", "post-processing"],
  "files": [
    {"path": "README.md", "role": "other"},
    {"path": "multicalibration_audit.py", "role": "executable_tool"},
    {"path": "test_multicalibration_audit.py", "role": "executable_tool"}
  ],
  "contract": {
    "entry_points": [
      {"name": "multicalibration_audit", "arguments": "predictions in [0, 1]; outcomes in [0, 1]; groups: {name: [row indices]} (may overlap); bins; tolerance > 0; minimum_count", "returns": "{cells, violations, max_abs_residual, max_weighted_violation, calibrated_overall, multicalibrated}"},
      {"name": "multicalibrate", "arguments": "the audit arguments plus max_rounds", "returns": "{predictions (patched), rounds, patches, audit (after patching)}"}
    ],
    "assumptions": [
      "Groups are declared in advance; the audit only checks the groups it is given.",
      "Cells smaller than minimum_count are reported but never flagged; their residuals are noisy."
    ],
    "guarantees": [
      "Each cell's residual is the exact mean of outcome minus prediction over its rows; the implicit group all is always audited.",
      "Each patch of a flagged cell lowers the squared error by at least minimum_count x tolerance^2, so multicalibrate stops; on return without hitting max_rounds no cell is flagged.",
      "A prediction of exactly 1 joins the last bin."
    ],
    "known_answers": [
