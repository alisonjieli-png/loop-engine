  "record_type": "creative_original_item/v1",
  "identity": "screen_door_fade",
  "title": "Dithered distance fade for camera occluders",
  "purpose": "Fade an opaque mesh without transparency sorting: pixels are discarded against a 4 x 4 Bayer threshold pattern as the object comes close to the camera or as a fade uniform drops, so walls and props in front of the camera become see-through.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
