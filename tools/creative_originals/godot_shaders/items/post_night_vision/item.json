        "default": [
          0.35,
          1.0,
          0.45,
          1.0
        ]
      },
      {
        "name": "gain",
        "type": "float",
        "hint": "hint_range(0.5, 6.0)",
        "default": 2.4
      },
      {
        "name": "glow",
        "type": "float",
        "hint": "hint_range(0.0, 2.0)",
        "default": 0.6
      },
      {
        "name": "noise_amount",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.25
      },
      {
        "name": "scanline_strength",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.15
      },
      {
        "name": "binocular",
        "type": "bool",
        "hint": null,
        "default": true
      },
      {
        "name": "mask_radius",
        "type": "float",
        "hint": "hint_range(0.2, 1.0)",
        "default": 0.46
