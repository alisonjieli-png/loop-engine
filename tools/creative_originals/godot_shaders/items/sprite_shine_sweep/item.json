  "identity": "sprite_shine_sweep",
  "title": "Shine sweep across a sprite",
  "purpose": "Run a bright diagonal shine band across a sprite at intervals, masked by the sprite's alpha, with control of angle, width, softness, speed and the pause between sweeps.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "2d",
