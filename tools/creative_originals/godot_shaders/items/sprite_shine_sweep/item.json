      {
        "name": "sweep_time",
        "type": "float",
        "hint": "hint_range(0.1, 5.0)",
        "default": 0.8
      },
      {
        "name": "pause_time",
        "type": "float",
        "hint": "hint_range(0.0, 10.0)",
        "default": 1.4
      },
      {
        "name": "progress_override",
        "type": "float",
        "hint": "hint_range(-1.0, 1.0)",
