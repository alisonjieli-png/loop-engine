{
  "record_type": "creative_original_item/v1",
  "identity": "post_edge_detect",
  "title": "Full-screen ink edges from depth and colour",
  "purpose": "Draw ink lines over a 3D scene where depth or colour changes sharply: a Laplacian of inverse depth finds silhouettes and creases, a Sobel filter on luminance finds colour borders. Optional paper tint for a drawn look.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
