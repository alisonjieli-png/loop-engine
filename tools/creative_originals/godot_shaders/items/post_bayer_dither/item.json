{
  "record_type": "creative_original_item/v1",
  "identity": "post_bayer_dither",
  "title": "Ordered dithering to few colours or one bit",
  "purpose": "Dither the screen with an 8 x 8 Bayer matrix: reduce each channel to a few levels, or the image to two colours like a one-bit display, with adjustable dot scale and contrast.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "post-process",
    "dithering",
    "bayer",
    "one bit",
    "retro",
    "full-screen"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "post_bayer_dither.gdshader",
      "role": "skill_asset"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "demo.tscn",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "unshaded",
      "cull_disabled",
      "depth_test_disabled",
      "depth_draw_never",
      "skip_vertex_transform",
      "fog_disabled"
    ],
    "uniforms": [
      {
        "name": "screen_texture",
        "type": "sampler2D",
        "hint": "hint_screen_texture, filter_linear_mipmap",
        "default": null
      },
      {
        "name": "levels",
        "type": "int",
        "hint": "hint_range(2, 16)",
        "default": 4
      },
      {
        "name": "dot_scale",
        "type": "float",
        "hint": "hint_range(1.0, 8.0)",
        "default": 2.0
      },
      {
        "name": "one_bit",
        "type": "bool",
        "hint": null,
        "default": false
      },
      {
        "name": "dark_color",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          0.1,
          0.08,
          0.16,
          1.0
        ]
      },
      {
        "name": "light_color",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          0.92,
          0.9,
          0.8,
          1.0
        ]
      },
      {
        "name": "contrast",
        "type": "float",
        "hint": "hint_range(0.5, 2.0)",
        "default": 1.1
      }
    ],
    "placement": "res://baltor/godot_shaders/post_bayer_dither/",
    "usage": "post_process_quad",
    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "A MeshInstance3D with a 2 x 2 QuadMesh, `material.tres` as its material override and a large extra cull margin, as in `demo.tscn`."
    ],
    "outputs": "The scene reduced to four levels per channel with a fine crosshatch-like dot pattern."
  },
  "limits": "Ordered dithering shows a regular grid pattern by design. When the output is scaled by a non-integer factor the pattern beats into moire. The pass reads Godot's screen texture after opaque geometry, so transparent objects drawn after it are not processed and its order among other transparent passes is not controlled.",
