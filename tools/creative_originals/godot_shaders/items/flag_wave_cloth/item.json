{
  "record_type": "creative_original_item/v1",
  "identity": "flag_wave_cloth",
  "title": "Waving flag with a pinned edge",
  "purpose": "Animate a flag on a subdivided quad: travelling waves grow away from the pole edge, a droop adds weight, analytic derivatives rebuild the normals, and the face shows procedural stripes and a disc or an assigned texture.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "flag",
    "cloth",
    "wind",
    "vertex animation",
    "banner"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "flag_wave_cloth.gdshader",
      "role": "skill_asset"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "demo.tscn",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "cull_disabled"
    ],
    "uniforms": [
      {
        "name": "flag_texture",
