{
  "record_type": "creative_original_item/v1",
  "identity": "billboard_axis_modes",
  "title": "Billboard modes: spherical or upright cylindrical",
  "purpose": "Vertex billboarding for cards with two modes: spherical (faces the camera fully, for glows and particles) or cylindrical (turns only around the world Y axis, for trees and characters that must stay upright), keeping node position and scale.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "billboard",
    "impostor",
    "vertex shader",
    "sprites",
    "foliage"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "billboard_axis_modes.gdshader",
      "role": "skill_asset"
    },
    {
