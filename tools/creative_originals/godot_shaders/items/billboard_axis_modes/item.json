      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "cull_disabled"
    ],
    "uniforms": [
      {
        "name": "card_texture",
        "type": "sampler2D",
        "hint": "source_color, hint_default_white, filter_linear_mipmap",
        "default": null
      },
      {
        "name": "tint",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          1.0,
          1.0,
          1.0,
          1.0
        ]
      },
      {
        "name": "mode",
        "type": "int",
        "hint": "hint_range(0, 1)",
        "default": 1
      },
      {
        "name": "alpha_cutoff",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.5
      },
      {
        "name": "shade_as_upright",
        "type": "bool",
        "hint": null,
        "default": true
      }
    ],
    "placement": "res://baltor/godot_shaders/billboard_axis_modes/",
    "usage": "surface_material",
    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "Card textures with alpha, and quads whose origin sits at the base for cylindrical mode (the demo uses `center_offset`)."
    ],
    "outputs": "Round green tree cards standing upright and turning to face the camera as it moves."
  },
  "limits": "Cards rotate in the vertex stage, so frustum culling and shadows use the unrotated mesh bounds; give nodes a margin. Shadow maps render the card facing the light camera, not the main camera. Cylindrical mode degenerates when the camera is exactly above the card.",
