{
  "record_type": "creative_original_item/v1",
  "identity": "post_radial_zoom_blur",
  "title": "Radial zoom blur toward a point",
  "purpose": "Streak the image toward or away from a screen point like a fast zoom or a speed burst, with no blur at the centre, adjustable strength, sample count and an optional brightness boost of the streaks.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "post-process",
    "zoom blur",
    "radial blur",
    "speed",
    "motion",
    "full-screen"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "post_radial_zoom_blur.gdshader",
      "role": "skill_asset"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "demo.tscn",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "unshaded",
      "cull_disabled",
      "depth_test_disabled",
      "depth_draw_never",
      "skip_vertex_transform",
      "fog_disabled"
    ],
    "uniforms": [
      {
        "name": "screen_texture",
        "type": "sampler2D",
        "hint": "hint_screen_texture, filter_linear_mipmap",
        "default": null
      },
      {
        "name": "center_x",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.5
      },
      {
        "name": "center_y",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.5
      },
      {
        "name": "strength",
        "type": "float",
        "hint": "hint_range(0.0, 0.5)",
        "default": 0.12
      },
      {
        "name": "samples",
        "type": "int",
        "hint": "hint_range(2, 48)",
        "default": 20
      },
      {
        "name": "clear_radius",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.15
      },
      {
        "name": "streak_boost",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.15
      }
    ],
    "placement": "res://baltor/godot_shaders/post_radial_zoom_blur/",
    "usage": "post_process_quad",
    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "A MeshInstance3D with a 2 x 2 QuadMesh, `material.tres` as its material override and a large extra cull margin, as in `demo.tscn`."
    ],
    "outputs": "The scene streaking outward from the middle with the centre still sharp."
  },
  "limits": "Streaks only sample what is on screen, so content entering from off screen does not streak in. Very high strength with few samples shows stepping. The pass reads Godot's screen texture after opaque geometry, so transparent objects drawn after it are not processed and its order among other transparent passes is not controlled.",
  "related": [
    "post_light_scattering",
    "screen_shockwave_2d"
  ],
  "technique_references": [
    "Radial blur by sampling toward a centre",
    "Per-pixel jittered sample offsets",
    "MurmurHash3 32-bit finalizer over prime-combined lattice coordinates as a hash"
  ],
  "native_checks": [
    "contract_static",
    "engine_run",
    "engine_log_clean",
    "shader_in_scene",
    "capture_written",
    "render_not_uniform",
    "shader_changes_pixels"
  ]
}
