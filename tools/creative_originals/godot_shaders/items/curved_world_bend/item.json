{
  "record_type": "creative_original_item/v1",
  "identity": "curved_world_bend",
  "title": "Curved world bend by camera distance",
  "purpose": "Bend everything that uses the material downward with the square of its horizontal distance from the camera, so the world curves away like a small planet or a rolling log, with a checker pattern to show the bend.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
