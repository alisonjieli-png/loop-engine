    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "Meshes with enough vertices along the bend (the demo road has 200 rows); other scene materials need the same vertex code to match."
    ],
    "outputs": "A checkered road and blocks that curve down and to the side toward the horizon."
  },
  "limits": "Visual only: physics, raycasts and culling use the unbent positions, so objects near the frustum edge can pop. Normals are not updated for the bend. Large flat polygons do not bend; subdivide them.",
