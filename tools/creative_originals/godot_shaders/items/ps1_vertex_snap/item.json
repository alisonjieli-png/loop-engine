{
  "record_type": "creative_original_item/v1",
  "identity": "ps1_vertex_snap",
  "title": "Retro console look: vertex snapping and affine textures",
  "purpose": "Recreate late-1990s console rendering: vertices snap to a coarse screen grid so geometry jitters, texture coordinates interpolate without perspective correction so textures warp, and colours drop to 15-bit with ordered dithering.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "retro",
    "ps1",
    "vertex snapping",
    "affine texture",
    "low fidelity"
  ],
  "files": [
