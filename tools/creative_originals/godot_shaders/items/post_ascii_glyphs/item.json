{
  "record_type": "creative_original_item/v1",
  "identity": "post_ascii_glyphs",
  "title": "ASCII text rendering of the screen",
  "purpose": "Render the scene as text: the screen is cut into character cells, each cell's brightness picks one of ten 5 x 5 bitmap glyphs from sparse to dense, drawn in the cell colour or a single terminal colour.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "post-process",
    "ascii",
    "text mode",
    "terminal",
    "retro",
    "full-screen"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "post_ascii_glyphs.gdshader",
      "role": "skill_asset"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "demo.tscn",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "unshaded",
      "cull_disabled",
      "depth_test_disabled",
      "depth_draw_never",
      "skip_vertex_transform",
      "fog_disabled"
    ],
    "uniforms": [
      {
        "name": "screen_texture",
        "type": "sampler2D",
        "hint": "hint_screen_texture, filter_linear_mipmap",
        "default": null
      },
      {
        "name": "cell_pixels",
        "type": "float",
        "hint": "hint_range(4.0, 32.0)",
        "default": 8.0
      },
      {
        "name": "use_scene_color",
        "type": "bool",
        "hint": null,
        "default": true
      },
      {
        "name": "text_color",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          0.4,
          1.0,
          0.5,
          1.0
        ]
      },
      {
        "name": "background_color",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          0.02,
          0.03,
          0.04,
          1.0
        ]
      },
      {
        "name": "contrast",
        "type": "float",
        "hint": "hint_range(0.5, 3.0)",
        "default": 1.3
      },
      {
        "name": "color_boost",
        "type": "float",
        "hint": "hint_range(0.5, 3.0)",
        "default": 1.4
      }
    ],
    "placement": "res://baltor/godot_shaders/post_ascii_glyphs/",
    "usage": "post_process_quad",
    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "A MeshInstance3D with a 2 x 2 QuadMesh, `material.tres` as its material override and a large extra cull margin, as in `demo.tscn`."
    ],
    "outputs": "The scene redrawn as coloured characters, dense glyphs in bright areas and dots in dark ones."
  },
  "limits": "Ten glyph levels and a 5 x 5 grid limit detail; the cell size should be at least 6 pixels for legible glyphs. Mip averaging is box filtered. The pass reads Godot's screen texture after opaque geometry, so transparent objects drawn after it are not processed and its order among other transparent passes is not controlled.",
  "related": [
    "post_pixelate_palette",
    "post_halftone_dots"
  ],
  "technique_references": [
    "Luminance-indexed glyph selection",
    "Bitmap glyphs packed into integers",
    "Cell averaging by mip level"
  ],
  "native_checks": [
    "contract_static",
    "engine_run",
    "engine_log_clean",
    "shader_in_scene",
    "capture_written",
    "render_not_uniform",
    "shader_changes_pixels"
  ]
}
