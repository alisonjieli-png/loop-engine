  "identity": "post_underwater_view",
  "title": "Underwater camera view",
  "purpose": "Make the camera look underwater: wavy screen distortion, wavelength-dependent absorption by distance from the depth buffer (red fades first), a blue-green scattering colour, brighter light from above and a vignette.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
