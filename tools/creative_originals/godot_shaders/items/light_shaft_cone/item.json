    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "An open cone mesh (a CylinderMesh with a small top radius and no caps) with V running from the apex.",
      "Optional: a SpotLight3D with the same aim to light the scene."
    ],
    "outputs": "A warm, soft-edged shaft of light with floating dust that fades where it reaches the floor and statue."
  },
  "limits": "Not a light: it does not illuminate anything. It ignores occluders inside the cone (no shadowed shafts). Additive, so it is invisible on bright backgrounds. Seen from inside the cone it looks flat.",
