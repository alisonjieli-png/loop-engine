{
  "record_type": "creative_original_item/v1",
  "identity": "post_pixelate_palette",
  "title": "Pixelation with nearest-colour palette mapping",
  "purpose": "Pixelate the screen into blocks and snap each block to the nearest colour of a small palette texture, with optional ordered dithering between palette colours, for low-resolution retro looks.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "post-process",
    "pixel art",
    "pixelate",
    "palette",
    "retro",
    "full-screen"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "post_pixelate_palette.gdshader",
      "role": "skill_asset"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "demo.tscn",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "unshaded",
      "cull_disabled",
      "depth_test_disabled",
      "depth_draw_never",
      "skip_vertex_transform",
      "fog_disabled"
    ],
    "uniforms": [
      {
        "name": "screen_texture",
        "type": "sampler2D",
        "hint": "hint_screen_texture, filter_nearest",
        "default": null
      },
      {
        "name": "palette",
        "type": "sampler2D",
        "hint": "source_color, filter_nearest, repeat_disable",
        "default": null
      },
      {
        "name": "palette_size",
        "type": "int",
        "hint": "hint_range(2, 32)",
        "default": 8
      },
      {
        "name": "pixel_size",
        "type": "float",
        "hint": "hint_range(1.0, 32.0)",
        "default": 4.0
      },
      {
        "name": "dither_strength",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 0.35
      },
      {
        "name": "palette_mix",
        "type": "float",
        "hint": "hint_range(0.0, 1.0)",
        "default": 1.0
      }
    ],
    "placement": "res://baltor/godot_shaders/post_pixelate_palette/",
    "usage": "post_process_quad",
    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "A MeshInstance3D with a 2 x 2 QuadMesh, `material.tres` as its material override and a large extra cull margin, as in `demo.tscn`.",
      "Optional: a palette image (N colours side by side) for `palette`."
    ],
    "outputs": "The scene as chunky 4-pixel blocks reduced to an eight-colour retro palette."
  },
  "limits": "Blocks sample one point, so thin details can vanish between frames as the camera moves. Palette matching is a weighted RGB distance, not a perceptual colour space. Cost grows with `palette_size`. The pass reads Godot's screen texture after opaque geometry, so transparent objects drawn after it are not processed and its order among other transparent passes is not controlled.",
  "related": [
    "post_bayer_dither",
    "post_posterize_gamma",
    "ps1_vertex_snap"
  ],
  "technique_references": [
    "Block pixelation by sampling block centres",
    "Nearest palette colour search",
    "2 x 2 ordered dithering"
  ],
  "native_checks": [
    "contract_static",
    "engine_run",
    "engine_log_clean",
    "shader_in_scene",
    "capture_written",
    "render_not_uniform",
    "shader_changes_pixels"
  ]
}
