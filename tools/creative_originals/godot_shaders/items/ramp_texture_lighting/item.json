{
  "record_type": "creative_original_item/v1",
  "identity": "ramp_texture_lighting",
  "title": "Lighting through an artist colour ramp",
  "purpose": "Map the light term through a gradient texture so an artist controls the whole shading curve and its colours: warm lights, coloured shadows, sharp or soft transitions, plus a ramp-driven specular and rim.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
