{
  "record_type": "creative_original_item/v1",
  "identity": "post_color_grading",
  "title": "Lift, gamma and gain colour grading",
  "purpose": "Grade the final image like a colour corrector: lift for shadows, gamma for midtones, gain for highlights as colours, plus contrast, saturation, vibrance, white balance temperature and tint.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "post-process",
    "color grading",
    "lift gamma gain",
    "white balance",
    "cinematic",
    "full-screen"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "post_color_grading.gdshader",
      "role": "skill_asset"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "demo.tscn",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "unshaded",
      "cull_disabled",
      "depth_test_disabled",
      "depth_draw_never",
      "skip_vertex_transform",
      "fog_disabled"
    ],
    "uniforms": [
      {
        "name": "screen_texture",
        "type": "sampler2D",
        "hint": "hint_screen_texture, filter_linear_mipmap",
        "default": null
      },
      {
        "name": "lift",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          0.04,
          0.02,
          0.08,
          1.0
        ]
      },
      {
        "name": "gamma",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          0.5,
          0.5,
          0.52,
          1.0
        ]
      },
      {
        "name": "gain",
        "type": "vec4",
        "hint": "source_color",
        "default": [
          1.0,
          0.96,
          0.88,
          1.0
        ]
      },
      {
        "name": "contrast",
        "type": "float",
        "hint": "hint_range(0.5, 2.0)",
        "default": 1.1
      },
      {
        "name": "saturation",
        "type": "float",
        "hint": "hint_range(0.0, 2.0)",
        "default": 1.1
      },
      {
        "name": "vibrance",
        "type": "float",
        "hint": "hint_range(-1.0, 1.0)",
        "default": 0.2
      },
      {
        "name": "temperature",
        "type": "float",
        "hint": "hint_range(-1.0, 1.0)",
        "default": 0.15
      },
      {
        "name": "tint",
        "type": "float",
        "hint": "hint_range(-1.0, 1.0)",
        "default": 0.0
      }
    ],
    "placement": "res://baltor/godot_shaders/post_color_grading/",
    "usage": "post_process_quad",
    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "A MeshInstance3D with a 2 x 2 QuadMesh, `material.tres` as its material override and a large extra cull margin, as in `demo.tscn`."
    ],
    "outputs": "The scene with slightly purple shadows, warm highlights and a little more punch."
  },
  "limits": "Grades display-referred colour after tonemapping, not scene-linear values, so extreme settings clip. No lookup table input; for LUT grading use Godot's colour correction texture. The pass reads Godot's screen texture after opaque geometry, so transparent objects drawn after it are not processed and its order among other transparent passes is not controlled.",
  "related": [
    "post_gradient_map",
    "post_vignette",
    "post_color_blindness"
  ],
  "technique_references": [
    "Lift, gamma and gain grading",
    "Contrast around a pivot",
    "Saturation and vibrance",
    "Approximate white balance multipliers"
  ],
  "native_checks": [
    "contract_static",
    "engine_run",
    "engine_log_clean",
    "shader_in_scene",
    "capture_written",
    "render_not_uniform",
    "shader_changes_pixels"
  ]
}
