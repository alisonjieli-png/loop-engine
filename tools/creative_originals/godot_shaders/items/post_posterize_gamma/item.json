{
  "record_type": "creative_original_item/v1",
  "identity": "post_posterize_gamma",
  "title": "Posterize in perceptual steps",
  "purpose": "Reduce the image to a few flat tone levels per channel or on luminance only, quantizing after a gamma curve so steps are evenly spaced to the eye, with a hard or slightly softened step edge.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "post-process",
    "posterize",
    "quantize",
    "stylized",
    "comic",
    "full-screen"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "post_posterize_gamma.gdshader",
      "role": "skill_asset"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "demo.tscn",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "shader_type": "spatial",
    "render_modes": [
      "unshaded",
      "cull_disabled",
      "depth_test_disabled",
      "depth_draw_never",
      "skip_vertex_transform",
      "fog_disabled"
    ],
    "uniforms": [
      {
        "name": "screen_texture",
        "type": "sampler2D",
        "hint": "hint_screen_texture, filter_linear_mipmap",
        "default": null
      },
      {
        "name": "levels",
        "type": "int",
        "hint": "hint_range(2, 32)",
        "default": 5
      },
      {
        "name": "gamma",
        "type": "float",
        "hint": "hint_range(0.3, 3.0)",
        "default": 1.0
      },
      {
        "name": "luminance_only",
        "type": "bool",
        "hint": null,
        "default": false
      },
      {
        "name": "edge_softness",
        "type": "float",
        "hint": "hint_range(0.0, 0.5)",
        "default": 0.0
      },
      {
        "name": "saturation",
        "type": "float",
        "hint": "hint_range(0.0, 2.0)",
        "default": 1.15
      }
    ],
    "placement": "res://baltor/godot_shaders/post_posterize_gamma/",
    "usage": "post_process_quad",
    "renderers": {
      "compatibility": "compiled_and_rendered",
      "forward_plus": "not_verified",
      "mobile": "not_verified"
    },
    "inputs": [
      "A MeshInstance3D with a 2 x 2 QuadMesh, `material.tres` as its material override and a large extra cull margin, as in `demo.tscn`."
    ],
    "outputs": "The scene flattened into five crisp tone steps per channel with slightly boosted saturation."
  },
  "limits": "Smooth gradients such as the sky turn into visible bands by design. Per-channel quantizing can shift hues in dark areas. The pass reads Godot's screen texture after opaque geometry, so transparent objects drawn after it are not processed and its order among other transparent passes is not controlled.",
  "related": [
    "post_pixelate_palette",
    "post_gradient_map"
  ],
  "technique_references": [
    "Gamma-biased quantization",
    "Luminance-only posterization by rescaling"
  ],
  "native_checks": [
