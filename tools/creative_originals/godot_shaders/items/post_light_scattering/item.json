{
  "record_type": "creative_original_item/v1",
  "identity": "post_light_scattering",
  "title": "Screen-space light shafts from the sky",
  "purpose": "Crepuscular rays as a post process: sky pixels near the sun become light sources, and each pixel marches toward the sun's screen position accumulating them with decay, so objects cut dark shafts into the glow.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "godot",
    "minimum_version": "4.3"
  },
  "tags": [
    "godot shader",
    "spatial",
    "post-process",
    "god rays",
    "light shafts",
    "crepuscular rays",
    "sun",
    "full-screen"
  ],
