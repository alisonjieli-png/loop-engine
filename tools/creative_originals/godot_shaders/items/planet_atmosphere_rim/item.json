  "identity": "planet_atmosphere_rim",
  "title": "Planet atmosphere shell with analytic path length",
  "purpose": "Atmosphere glow for planets: on a shell sphere around the planet, the length of each view ray through the atmosphere is computed analytically, turned into scattering with an exponential, and lit only on the sun side.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
