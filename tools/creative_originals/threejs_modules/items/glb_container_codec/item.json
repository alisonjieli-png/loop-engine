    },
    "exports": [
      {
        "name": "parseGlb",
        "kind": "function",
        "signature": "parseGlb(data) -> {json, binary, version, byteLength, chunks}",
        "summary": "Read a GLB from an ArrayBuffer or typed array; binary is a Uint8Array view of the BIN chunk or null; throws GlbError with a reason code."
      },
      {
        "name": "encodeGlb",
        "kind": "function",
        "signature": "encodeGlb(json, binary = null) -> Uint8Array",
        "summary": "Write a GLB: JSON padded with spaces, BIN padded with zeros; buffers[0] must match the binary."
      },
      {
        "name": "isGlb",
        "kind": "function",
        "signature": "isGlb(data) -> boolean",
        "summary": "True when the data starts with a glTF 2.0 binary header; never throws."
      },
      {
        "name": "GlbError",
        "kind": "class",
        "signature": "new GlbError(code, message)",
        "summary": "The refusal error; code is a stable reason such as magic, version, length_mismatch or chunk_truncated."
      },
      {
        "name": "GLB_FORMAT",
        "kind": "constant",
        "summary": "Frozen container constants: magic, version, chunk types, header sizes and alignment."
      }
    ],
    "refusal_codes": [
      "too_short",
      "magic",
      "version",
      "length_mismatch",
      "length_unaligned",
      "chunk_truncated",
      "chunk_unaligned",
      "first_chunk_not_json",
