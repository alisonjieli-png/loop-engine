  "identity": "glb_container_codec",
  "title": "Strict GLB container reader and writer",
  "purpose": "Read and write the binary glTF 2.0 container (header, JSON chunk, optional BIN chunk) with strict checks that name the reason for every refusal, on ArrayBuffers and typed arrays with no three.js. Use it to inspect, repack or validate .glb files in pipelines, workers and loaders.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "node",
    "minimum_version": "18",
    "notes": "Pure JavaScript with TextEncoder and TextDecoder; also runs in browsers and workers. The demo loads its output with three.js 0.186.1 GLTFLoader."
  },
