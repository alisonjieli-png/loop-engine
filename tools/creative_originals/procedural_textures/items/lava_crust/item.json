        "colour_space": "linear",
        "convention": "gltf_roughness",
        "range": [
          0.3,
          1.0
        ]
      },
      {
        "name": "height",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_high"
      },
      {
        "name": "ao",
        "channels": 1,
