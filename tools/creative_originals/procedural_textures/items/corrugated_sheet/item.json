        "type": "int",
        "default": 6,
        "minimum": 2,
        "maximum": 24,
        "meaning": "Corrugations across the tile."
      },
      {
        "name": "profile",
        "type": "int",
        "default": 0,
        "minimum": 0,
        "maximum": 1,
        "meaning": "Rib shape: 0 sine wave, 1 trapezoidal box rib."
      },
      {
