        "type": "float",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 2.0,
        "meaning": "Albedo saturation multiplier."
      },
      {
        "name": "brightness",
        "type": "float",
        "default": 1.0,
        "minimum": 0.5,
        "maximum": 1.0,
        "meaning": "Albedo brightness multiplier."
