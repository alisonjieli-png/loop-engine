        "convention": "opengl_y_up"
      },
      {
        "name": "roughness",
        "channels": 1,
        "colour_space": "linear",
        "convention": "gltf_roughness",
        "range": [
          0.1,
          1.0
        ]
      },
      {
        "name": "metallic",
        "channels": 1,
        "colour_space": "linear",
        "convention": "gltf_metallic"
      },
      {
        "name": "height",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_high"
      },
      {
        "name": "ao",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_unoccluded"
      }
    ],
    "parameters": [
