{
  "record_type": "creative_original_item/v1",
  "identity": "slate_cleft",
  "title": "Riven slate",
  "purpose": "Generate tileable PBR maps of riven slate: cleft terraces with short steps, fine riving lines, tone changes between sheets and rusty iron spots. Use for roof slates, floor slabs, paving and wall cladding.",
  "form": "function",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "texture",
    "pbr",
    "tileable",
    "slate",
    "stone",
    "riven",
    "terraces",
    "procedural"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "slate_cleft.py",
      "role": "executable_tool"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "blender_material.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
    "entry_point": "generate",
    "module": "slate_cleft.py",
    "signature": "generate(width=256, height=256, seed=0, preset=\"default\", directx_normal=False, **parameters) -> {map name: {\"channels\", \"colour_space\", \"pixels\"}}",
    "command_line": "python slate_cleft.py --size 1024 --seed 7 --preset NAME --out DIR [--width W --height H] [--set NAME=VALUE] [--directx-normal] [--orm]",
    "maps": [
      {
        "name": "albedo",
        "channels": 3,
        "colour_space": "srgb",
        "convention": "gltf_base_color",
        "range": [
          0.02,
          0.7
        ]
      },
      {
        "name": "normal",
        "channels": 3,
        "colour_space": "linear",
        "convention": "opengl_y_up"
      },
      {
        "name": "roughness",
        "channels": 1,
        "colour_space": "linear",
        "convention": "gltf_roughness",
        "range": [
          0.25,
          1.0
        ]
      },
      {
        "name": "height",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_high"
      },
      {
        "name": "ao",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_unoccluded"
      }
    ],
    "parameters": [
      {
        "name": "terraces",
        "type": "int",
        "default": 7,
        "minimum": 2,
        "maximum": 20,
        "meaning": "Cleavage levels over the height range."
      },
      {
        "name": "terrace_scale",
        "type": "int",
        "default": 3,
        "minimum": 1,
        "maximum": 10,
        "meaning": "Noise cells across the tile for the terrace outlines (higher gives smaller terraces)."
      },
      {
        "name": "step_softness",
        "type": "float",
        "default": 0.15,
        "minimum": 0.02,
        "maximum": 0.5,
        "meaning": "Share of each level spent on the step edge (low values give crisp steps)."
      },
      {
        "name": "riving",
        "type": "float",
        "default": 0.5,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Depth of the fine streaks along the cleavage."
      },
      {
        "name": "iron_spots",
        "type": "float",
        "default": 0.15,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Rusty spots from weathered pyrite."
      },
      {
        "name": "tone_variation",
        "type": "float",
        "default": 0.5,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Tone change between terraces."
      },
      {
        "name": "hue_shift",
        "type": "float",
        "default": 0.0,
        "minimum": -0.5,
        "maximum": 0.5,
        "meaning": "Hue rotation of the albedo in turns."
      },
      {
        "name": "saturation",
        "type": "float",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 2.0,
        "meaning": "Albedo saturation multiplier."
      },
      {
        "name": "brightness",
        "type": "float",
        "default": 1.0,
        "minimum": 0.5,
        "maximum": 1.5,
        "meaning": "Albedo brightness multiplier."
      }
    ],
    "presets": [
      {
        "name": "default",
        "description": "Blue-grey riven slate with a few rust spots.",
        "values": {}
      },
      {
        "name": "green",
        "description": "Grey-green slate with broad, soft terraces.",
        "values": {
          "terraces": 5,
          "step_softness": 0.3,
          "iron_spots": 0.05
        }
      },
      {
        "name": "heather",
        "description": "Purple-grey slate with crisp steps.",
        "values": {
          "terraces": 9,
          "step_softness": 0.06,
          "terrace_scale": 4
        }
      },
      {
        "name": "rusty_multicolour",
        "description": "Grey slate stained with heavy rust and ochre.",
        "values": {
          "iron_spots": 0.8,
          "tone_variation": 0.8
        }
      },
      {
        "name": "black_honed",
        "description": "Fine black slate, honed nearly flat.",
        "values": {
          "terraces": 3,
          "step_softness": 0.45,
          "riving": 0.15,
          "iron_spots": 0.0,
          "tone_variation": 0.2
        }
      }
    ],
    "tileable": true,
    "default_size": 256,
    "cost_seconds_1024": 21.0,
    "peak_memory_mb_1024": 687,
    "godot_material": "material.tres",
    "godot_texture_folder": "res://baltor/textures/slate_cleft/",
    "blender_builder": "blender_material.build_material(folder)"
  },
  "limits": "Terraces are a quantized noise field, an approximation of cleavage; real slate also shows cleavage steps along straight lines, which this does not force. Iron spots are round stamps. Occlusion is a blurred-height estimate.",
  "related": [
    "sandstone_strata",
    "roof_shingles"
  ],
  "technique_references": [
    "Quantized fractional Brownian motion with smoothed steps for terraces",
    "Domain warping with tileable gradient noise",
    "Anisotropic noise for riving streaks",
    "Soft round stamps for iron spots",
    "Height to tangent-space normal by central differences"
  ],
  "native_checks": [
    "command_line_generates_declared_maps",
    "maps_decode",
    "maps_have_declared_size_and_channels",
    "maps_tile_without_a_seam",
    "normal_vectors_unit_length_facing_out",
    "maps_carry_detail",
    "godot_imports_the_maps",
    "godot_material_template_loads_every_map",
    "godot_compatibility_render",
    "capture_shows_the_textured_surface",
    "blender_builds_the_material"
  ]
}
