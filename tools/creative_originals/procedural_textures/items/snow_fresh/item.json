{
  "record_type": "creative_original_item/v1",
  "identity": "snow_fresh",
  "title": "Snow surface",
  "purpose": "Generate tileable PBR maps of snow: soft drifts with sparkling glints, wind-carved sastrugi ridges, or old crusted snow with dirt and melt pits. Use for winter ground, roofs and mountains.",
  "form": "function",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "texture",
    "pbr",
    "tileable",
    "snow",
    "winter",
    "ice",
    "ground",
    "procedural"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "snow_fresh.py",
      "role": "executable_tool"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "blender_material.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
    "entry_point": "generate",
    "module": "snow_fresh.py",
    "signature": "generate(width=256, height=256, seed=0, preset=\"default\", directx_normal=False, **parameters) -> {map name: {\"channels\", \"colour_space\", \"pixels\"}}",
    "command_line": "python snow_fresh.py --size 1024 --seed 7 --preset NAME --out DIR [--width W --height H] [--set NAME=VALUE] [--directx-normal] [--orm]",
    "maps": [
      {
        "name": "albedo",
        "channels": 3,
        "colour_space": "srgb",
        "convention": "gltf_base_color",
        "range": [
          0.3,
          0.95
        ]
      },
      {
        "name": "normal",
        "channels": 3,
        "colour_space": "linear",
        "convention": "opengl_y_up"
      },
      {
        "name": "roughness",
        "channels": 1,
        "colour_space": "linear",
        "convention": "gltf_roughness",
        "range": [
          0.1,
          1.0
        ]
      },
      {
        "name": "height",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_high"
      },
      {
        "name": "ao",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_unoccluded"
      }
    ],
    "parameters": [
      {
        "name": "drift_scale",
        "type": "int",
        "default": 3,
        "minimum": 1,
        "maximum": 12,
        "meaning": "Noise cells across the tile for the drifts (higher gives smaller drifts)."
      },
      {
        "name": "drift_height",
        "type": "float",
        "default": 0.5,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Height of the soft drifts."
      },
      {
        "name": "wind_ridges",
        "type": "float",
        "default": 0.0,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Sharp wind-carved ridges (sastrugi)."
      },
      {
        "name": "glints",
        "type": "float",
        "default": 0.5,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Density of sparkling crystal glints."
      },
      {
        "name": "age",
        "type": "float",
        "default": 0.0,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Old snow: dirt specks, glazed crust and melt pits."
      },
      {
        "name": "blue_tint",
        "type": "float",
        "default": 0.4,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Cool tint in the hollows."
      },
      {
        "name": "hue_shift",
        "type": "float",
        "default": 0.0,
        "minimum": -0.5,
        "maximum": 0.5,
        "meaning": "Hue rotation of the albedo in turns."
      },
      {
        "name": "saturation",
        "type": "float",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 2.0,
        "meaning": "Albedo saturation multiplier."
      },
      {
        "name": "brightness",
        "type": "float",
        "default": 1.0,
        "minimum": 0.5,
        "maximum": 1.5,
        "meaning": "Albedo brightness multiplier."
      }
    ],
    "presets": [
      {
        "name": "default",
        "description": "Fresh powder with soft drifts and glints.",
        "values": {}
      },
      {
        "name": "sastrugi",
        "description": "Wind-packed snow carved into sharp ridges.",
        "values": {
          "wind_ridges": 0.9,
          "drift_height": 0.3,
          "glints": 0.3
        }
      },
      {
        "name": "old_crusted",
        "description": "Old, dirty snow with an icy crust and melt pits.",
        "values": {
          "age": 0.85,
          "glints": 0.7,
          "blue_tint": 0.2,
          "drift_scale": 5
        }
      },
      {
        "name": "drift_field",
        "description": "Large rolling drifts in deep fresh snow under a cold blue sky.",
        "values": {
          "drift_scale": 2,
          "drift_height": 0.95,
          "glints": 0.4,
          "blue_tint": 1.0,
          "brightness": 0.93
        }
      }
    ],
    "tileable": true,
    "default_size": 256,
    "cost_seconds_1024": 33.5,
    "peak_memory_mb_1024": 664,
    "godot_material": "material.tres",
    "godot_texture_folder": "res://baltor/textures/snow_fresh/",
    "blender_builder": "blender_material.build_material(folder)"
  },
  "limits": "Light scattering inside snow is only suggested by a blue tint in the hollows; use a subsurface or translucency setting in the engine for real scattering. Glints are small bright, smooth spots in the maps, not view-dependent sparkle. Occlusion is a blurred-height estimate.",
  "related": [
    "sand_ripples"
  ],
  "technique_references": [
    "Low-frequency fractional Brownian motion for drifts",
    "Ridged noise stretched across the wind for sastrugi",
    "Small smooth stamps as glints",
    "Cavity tint from blurred height",
    "Worley distance for melt pits"
  ],
  "native_checks": [
    "command_line_generates_declared_maps",
    "maps_decode",
    "maps_have_declared_size_and_channels",
    "maps_tile_without_a_seam",
    "normal_vectors_unit_length_facing_out",
    "maps_carry_detail",
    "godot_imports_the_maps",
    "godot_material_template_loads_every_map",
    "godot_compatibility_render",
    "capture_shows_the_textured_surface",
    "blender_builds_the_material"
  ]
}
