{
  "record_type": "creative_original_item/v1",
  "identity": "forest_floor_leaves",
  "title": "Forest floor leaf litter",
  "purpose": "Generate tileable PBR maps of a forest floor: stacked fallen leaves with midribs, veins and curled edges, twigs and dark soil, in autumn, oak, wet or maple colours. Use for woodland ground and paths.",
  "form": "function",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "texture",
    "pbr",
    "tileable",
    "leaves",
    "forest",
    "autumn",
    "ground",
    "procedural"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "forest_floor_leaves.py",
      "role": "executable_tool"
    },
    {
      "path": "material.tres",
      "role": "skill_asset"
    },
    {
      "path": "blender_material.py",
      "role": "executable_tool"
    }
  ],
  "contract": {
    "entry_point": "generate",
    "module": "forest_floor_leaves.py",
    "signature": "generate(width=256, height=256, seed=0, preset=\"default\", directx_normal=False, **parameters) -> {map name: {\"channels\", \"colour_space\", \"pixels\"}}",
    "command_line": "python forest_floor_leaves.py --size 1024 --seed 7 --preset NAME --out DIR [--width W --height H] [--set NAME=VALUE] [--directx-normal] [--orm]",
    "maps": [
      {
        "name": "albedo",
        "channels": 3,
        "colour_space": "srgb",
        "convention": "gltf_base_color",
        "range": [
          0.02,
          0.85
        ]
      },
      {
        "name": "normal",
        "channels": 3,
        "colour_space": "linear",
        "convention": "opengl_y_up"
      },
      {
        "name": "roughness",
        "channels": 1,
        "colour_space": "linear",
        "convention": "gltf_roughness",
        "range": [
          0.35,
          1.0
        ]
      },
      {
        "name": "height",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_high"
      },
      {
        "name": "ao",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_unoccluded"
      }
    ],
    "parameters": [
      {
        "name": "leaves",
        "type": "int",
        "default": 190,
        "minimum": 20,
        "maximum": 1500,
        "meaning": "Number of leaves on the tile."
      },
      {
        "name": "leaf_size",
        "type": "float",
        "default": 0.065,
        "minimum": 0.015,
        "maximum": 0.15,
        "meaning": "Average leaf length (half extent) in texture units."
      },
      {
        "name": "lobed",
        "type": "float",
        "default": 0.3,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Share of lobed (oak-like) leaves; the rest are ovate."
      },
      {
        "name": "curl",
        "type": "float",
        "default": 0.5,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "How much leaf edges lift."
      },
      {
        "name": "decay",
        "type": "float",
        "default": 0.3,
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Share of dark, decaying leaves."
      },
      {
        "name": "twigs",
        "type": "int",
        "default": 10,
        "minimum": 0,
        "maximum": 60,
        "meaning": "Number of twigs on the tile."
      },
      {
        "name": "hue_shift",
        "type": "float",
        "default": 0.0,
        "minimum": -0.5,
        "maximum": 0.5,
        "meaning": "Hue rotation of the albedo in turns."
      },
      {
        "name": "saturation",
        "type": "float",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 2.0,
        "meaning": "Albedo saturation multiplier."
      },
      {
        "name": "brightness",
        "type": "float",
        "default": 1.0,
        "minimum": 0.5,
        "maximum": 1.5,
        "meaning": "Albedo brightness multiplier."
      }
    ],
    "presets": [
      {
        "name": "default",
        "description": "Autumn litter of yellow, orange and brown leaves over soil.",
        "values": {}
      },
      {
        "name": "oak_brown",
        "description": "Dry brown oak leaves, mostly lobed.",
        "values": {
          "lobed": 0.9,
          "decay": 0.5,
          "leaves": 170,
          "leaf_size": 0.075
        }
      },
      {
        "name": "wet_dark",
        "description": "Wet, dark, decaying leaves pressed flat.",
        "values": {
          "decay": 0.9,
          "curl": 0.15,
          "leaves": 260
        }
      },
      {
        "name": "maple_red",
        "description": "Fresh red and orange leaves, sparse over soil.",
        "values": {
          "leaves": 110,
          "decay": 0.05,
          "leaf_size": 0.065,
          "twigs": 6,
          "lobed": 0.0
        }
      }
    ],
    "tileable": true,
    "default_size": 256,
    "cost_seconds_1024": 17.3,
    "peak_memory_mb_1024": 508,
    "godot_material": "material.tres",
    "godot_texture_folder": "res://baltor/textures/forest_floor_leaves/",
    "blender_builder": "blender_material.build_material(folder)"
  },
  "limits": "Leaves are flat stamped outlines (ovate or lobed) with height-map curl; they do not fold or cast real shadows. Leaf shapes are generic, not species-accurate. Occlusion is a blurred-height estimate.",
  "related": [
    "grass_lawn",
    "moss_cushion"
  ],
  "technique_references": [
    "Leaf outline from a width profile along the midrib",
    "Z-buffered stamping with rising layer heights",
    "Vein lines from local leaf coordinates",
    "Capsule strokes for stems and twigs",
    "Height to tangent-space normal by central differences"
  ],
  "native_checks": [
    "command_line_generates_declared_maps",
    "maps_decode",
    "maps_have_declared_size_and_channels",
    "maps_tile_without_a_seam",
    "normal_vectors_unit_length_facing_out",
    "maps_carry_detail",
    "godot_imports_the_maps",
    "godot_material_template_loads_every_map",
    "godot_compatibility_render",
    "capture_shows_the_textured_surface",
    "blender_builds_the_material"
  ]
}
