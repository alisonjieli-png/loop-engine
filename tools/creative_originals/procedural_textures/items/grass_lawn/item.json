    "command_line": "python grass_lawn.py --size 1024 --seed 7 --preset NAME --out DIR [--width W --height H] [--set NAME=VALUE] [--directx-normal] [--orm]",
    "maps": [
      {
        "name": "albedo",
        "channels": 3,
        "colour_space": "srgb",
