        "range": [
          0.02,
          0.85
        ]
      },
      {
        "name": "normal",
        "channels": 3,
        "colour_space": "linear",
        "convention": "opengl_y_up"
      },
      {
        "name": "roughness",
        "channels": 1,
        "colour_space": "linear",
        "convention": "gltf_roughness",
        "range": [
          0.35,
          1.0
        ]
      },
      {
        "name": "height",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_high"
      },
      {
        "name": "ao",
        "channels": 1,
        "colour_space": "linear",
        "convention": "white_is_unoccluded"
      }
    ],
    "parameters": [
