        "maximum": 12000,
        "meaning": "Number of blades on the tile."
      },
      {
        "name": "blade_length",
        "type": "float",
        "default": 0.042,
        "minimum": 0.008,
        "maximum": 0.12,
        "meaning": "Average blade length in texture units."
      },
      {
        "name": "blade_width",
        "type": "float",
        "default": 0.0034,
        "minimum": 0.001,
        "maximum": 0.01,
        "meaning": "Blade width at the base in texture units."
      },
      {
