        "colour_space": "linear",
        "convention": "gltf_roughness",
        "range": [
          0.12,
          1.0
        ]
      },
      {
        "name": "metallic",
        "channels": 1,
        "colour_space": "linear",
        "convention": "gltf_metallic"
      },
      {
        "name": "height",
