    "complexity": "O(n^2) including the self-intersection check",
    "outputs": [
      {
        "format": "gltf",
        "content": "a flat band between the demonstration polygon and its offset, in the XZ plane facing +Y"
      },
      {
        "format": "obj",
        "content": "the same band as Wavefront OBJ"
      }
    ],
    "axes": "+Y up, metres; 2D (x, y) maps to (x, 0, -y)"
  },
  "limits": "Offsets that make edges vanish or cross are refused rather than cleaned up (no splitting into several polygons). Holes are not handled; offset each ring separately with the opposite sign. Round joins are polylines of arc_segments chords per right angle.",
