{
  "record_type": "creative_original_item/v1",
  "identity": "platonic_solids",
  "title": "Platonic solids with exact edge length",
  "purpose": "Generate the five regular convex polyhedra with exact coordinates and polygon faces found as supporting planes. Use them for dice, crystals, teaching models and as seeds for other operators.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "polyhedron",
    "platonic solids",
    "dodecahedron",
    "icosahedron",
    "dice",
    "geometry"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "platonic_solids.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "platonic_solids",
    "entry_points": [
      {
        "name": "solid_vertices",
        "signature": "solid_vertices(name, edge=1.0)",
        "summary": "Vertex coordinates of a Platonic solid centred at the origin with the given edge length."
      },
      {
        "name": "hull_faces",
        "signature": "hull_faces(vertices)",
        "summary": "Faces of a convex polyhedron given only its vertices: each plane through three vertices with all vertices on one side is a face; its vertices are ordered counter-clockwise seen from outside."
      },
      {
        "name": "platonic_solid",
        "signature": "platonic_solid(name='dodecahedron', edge=1.0)",
        "summary": "One Platonic solid: exact vertices, polygon faces (triangles, squares or pentagons), outward winding."
      },
      {
        "name": "build",
        "signature": "build(solid='all', edge=1.0)",
        "summary": "The flat-shaded solid, or all five side by side along X, as the command line writes them."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the solids as .gltf or .obj and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "solid",
        "type": "str",
        "default": "all",
        "unit": "name",
        "choices": [
          "all",
          "tetrahedron",
          "cube",
          "octahedron",
          "dodecahedron",
          "icosahedron"
        ],
        "meaning": "Which solid to write; 'all' places the five in a row along X."
      },
      {
        "name": "edge",
        "type": "float",
        "default": 1.0,
        "unit": "m",
        "minimum": 1e-06,
        "maximum": 1000000.0,
        "meaning": "Edge length of every solid."
      }
    ],
    "invariants": {
