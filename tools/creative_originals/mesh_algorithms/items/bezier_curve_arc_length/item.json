{
  "record_type": "creative_original_item/v1",
  "identity": "bezier_curve_arc_length",
  "title": "Cubic Bezier evaluation, arc length and resampling",
  "purpose": "Evaluate and split cubic Bezier curves by de Casteljau, measure arc length by Gauss-Legendre quadrature and resample paths at even arc-length spacing. Use it for camera paths, motion along curves and even spacing of instances.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "bezier",
    "curve",
    "arc length",
    "resampling",
    "de casteljau",
    "motion path"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "bezier_curve_arc_length.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "bezier_curve_arc_length",
    "entry_points": [
      {
        "name": "bezier_point",
        "signature": "bezier_point(controls, t)",
        "summary": "Point at parameter t in [0, 1] by de Casteljau's repeated linear interpolation (any dimension)."
      },
      {
        "name": "bezier_derivative",
        "signature": "bezier_derivative(controls, t)",
        "summary": "Velocity dB/dt of a cubic at t: 3 [(1-t)^2 (P1-P0) + 2 (1-t) t (P2-P1) + t^2 (P3-P2)]."
      },
      {
        "name": "split_bezier",
        "signature": "split_bezier(controls, t=0.5)",
        "summary": "The two cubics that trace the parts before and after t (de Casteljau's intermediate points)."
      },
      {
        "name": "arc_length",
        "signature": "arc_length(controls, t0=0.0, t1=1.0, pieces=16)",
        "summary": "Length of a cubic between t0 and t1: five-point Gauss-Legendre quadrature of the speed on ``pieces`` equal sub-intervals (error falls like the tenth power of the piece size for smooth speed)."
      },
      {
        "name": "length_table",
        "signature": "length_table(controls, pieces=32)",
        "summary": "Cumulative arc length at t = k / pieces for k = 0 .. pieces (the lookup table for inversion)."
      },
      {
        "name": "parameter_at_length",
        "signature": "parameter_at_length(controls, length, table=None)",
        "summary": "The t whose arc length from 0 equals ``length``: find the table piece, then Newton steps inside it."
      },
      {
        "name": "resample_by_length",
        "signature": "resample_by_length(segments, spacing)",
        "summary": "Points along a path of cubic segments spaced ``spacing`` apart in arc length, plus the final end point."
      },
      {
        "name": "demo_path",
        "signature": "demo_path(name='wave')",
        "summary": "Cubic segments of a demonstration path: 'wave' (four arches), 'loop' (closed) or 'quarter_circle'."
      },
      {
        "name": "build",
        "signature": "build(path='wave', spacing=0.05, tube_radius=0.04)",
        "summary": "A tube through the path resampled at even arc length (what the command line writes)."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the resampled path as a tube (.gltf or .obj) and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "path",
        "type": "str",
        "default": "wave",
        "unit": "name",
        "choices": [
          "wave",
          "loop",
          "quarter_circle"
        ],
        "meaning": "Demonstration path made of cubic segments."
      },
      {
        "name": "spacing",
        "type": "float",
        "default": 0.05,
        "unit": "m",
        "minimum": 0.001,
        "maximum": 1000.0,
        "meaning": "Arc-length spacing of the resampled points the tube follows."
      },
      {
        "name": "tube_radius",
        "type": "float",
        "default": 0.04,
        "unit": "m",
        "minimum": 0.0001,
        "maximum": 1000.0,
        "meaning": "Radius of the display tube."
      }
    ],
    "invariants": {
