{
  "record_type": "creative_original_item/v1",
  "identity": "loft_profiles",
  "title": "Loft through a stack of profiles",
  "purpose": "Skin a closed solid through a sequence of closed profiles, resampled to equal counts by arc length and aligned to avoid twisting, with capped ends. Use it for bottles, hulls, towers and organic forms.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "loft",
    "skinning",
    "profiles",
    "resampling",
    "modeling",
    "hull"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "loft_profiles.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "loft_profiles",
    "entry_points": [
      {
        "name": "resample_closed",
        "signature": "resample_closed(polygon, count)",
        "summary": "``count`` points spaced evenly by arc length around a closed polygon, starting at its first vertex."
      },
      {
        "name": "align",
        "signature": "align(reference, ring)",
        "summary": "``ring`` cyclically shifted to minimize the summed squared distance to ``reference`` (same orientation assumed), which keeps the skin from twisting."
      },
      {
        "name": "loft",
        "signature": "loft(profiles, samples=None, caps=True)",
        "summary": "A closed skin through 3D profiles (each a closed planar polygon, listed from the first end to the other)."
      },
      {
        "name": "demo_profiles",
        "signature": "demo_profiles(shape='bottle')",
        "summary": "Closed profiles (3D, horizontal) for a bottle (circles), a tower (square turning into an octagon) or a boat hull (U-shaped sections closed at the deck)."
      },
      {
        "name": "build",
        "signature": "build(shape='bottle', samples=48)",
        "summary": "The lofted demonstration solid with smooth normals."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the lofted solid (.gltf or .obj) and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "shape",
        "type": "str",
        "default": "bottle",
        "unit": "name",
        "choices": [
          "bottle",
          "tower",
          "boat"
        ],
        "meaning": "Demonstration stack of profiles."
      },
      {
        "name": "samples",
        "type": "int",
        "default": 48,
        "unit": "count",
        "minimum": 3,
        "maximum": 100000,
        "meaning": "Points per profile after resampling."
      }
    ],
    "invariants": {
      "box": {
        "call": "loft",
        "arguments": {
          "profiles": [
            [
              [
                -1.0,
                0.0,
                -1.0
              ],
              [
                1.0,
                0.0,
                -1.0
              ],
              [
                1.0,
                0.0,
                1.0
              ],
              [
                -1.0,
                0.0,
                1.0
              ]
            ],
            [
              [
                -1.0,
                2.0,
                -1.0
              ],
              [
                1.0,
                2.0,
                -1.0
              ],
              [
                1.0,
                2.0,
                1.0
              ],
              [
                -1.0,
                2.0,
                1.0
              ]
            ]
          ]
        },
        "expect": {
          "vertex_count": 8,
          "face_count": 8,
          "watertight": true,
          "volume": [
            8.0,
            1e-12
          ]
        }
      },
      "frustum_with_reversed_ring": {
        "call": "loft",
        "arguments": {
          "profiles": [
            [
              [
                -1.0,
                0.0,
                -1.0
              ],
              [
