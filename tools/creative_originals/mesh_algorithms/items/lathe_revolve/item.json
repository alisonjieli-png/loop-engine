  "record_type": "creative_original_item/v1",
  "identity": "lathe_revolve",
  "title": "Lathe revolution with partial angles",
  "purpose": "Revolve an (r, y) profile around the Y axis, fully or through a partial angle with flat cut faces, and compute the exact volume of the polygonal solid. Use it for vases, bowls, chess pieces and turned parts.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "lathe",
    "revolve",
    "surface of revolution",
    "turned parts",
    "vase",
    "modeling"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "lathe_revolve.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "lathe_revolve",
    "entry_points": [
      {
        "name": "demo_profile",
        "signature": "demo_profile(name='vase')",
        "summary": "An (r, y) polyline from bottom to top; r = 0 at an end closes the solid on the axis there."
      },
      {
        "name": "lathe",
        "signature": "lathe(profile, segments=48, angle=360.0)",
        "summary": "Revolve ``profile`` about Y; points with r = 0 become single vertices. A full turn welds the seam; a partial turn adds both cut faces (the profile closed along the axis) and is closed when both profile ends lie on the axis. Faces point outward for a profile listed from bottom to top with r >= 0."
      },
      {
        "name": "revolved_volume",
        "signature": "revolved_volume(profile, segments=48, angle=360.0)",
        "summary": "Exact volume of the lathe solid: segments * sin(angle / segments) * |first moment of the profile polygon closed along the axis| (each profile point sweeps straight chords, not circular arcs)."
      },
      {
        "name": "build",
        "signature": "build(profile='vase', segments=48, angle=360.0)",
        "summary": "The smooth-shaded lathe solid of a demonstration profile."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the revolved solid (.gltf or .obj) and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "profile",
        "type": "str",
        "default": "vase",
        "unit": "name",
        "choices": [
          "vase",
          "bowl",
          "pawn",
          "spindle"
        ],
        "meaning": "Demonstration (r, y) profile."
      },
      {
        "name": "segments",
        "type": "int",
        "default": 48,
        "unit": "count",
        "minimum": 3,
        "maximum": 4096,
        "meaning": "Divisions of the swept angle."
      },
      {
        "name": "angle",
        "type": "float",
        "default": 360.0,
        "unit": "degrees",
        "minimum": 1.0,
        "maximum": 360.0,
        "meaning": "Swept angle; below 360 the cut sides are closed with the profile polygon."
      }
    ],
