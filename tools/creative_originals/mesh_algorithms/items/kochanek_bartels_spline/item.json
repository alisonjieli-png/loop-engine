          ]
        }
      },
      "default_tangents": {
        "call": "tcb_tangents",
        "arguments": {
          "previous": [
            0.0,
            0.0,
            0.0
          ],
          "current": [
            1.0,
            0.0,
            0.0
          ],
          "following": [
            1.0,
            2.0,
            0.0
          ]
        },
        "expect": {
          "sequence_close": [
