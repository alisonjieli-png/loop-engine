                0.0
              ]
            ],
            1e-15
          ]
        }
      },
      "full_continuity_corner": {
        "call": "tcb_tangents",
        "arguments": {
          "previous": [
            0.0,
            0.0,
            0.0
          ],
          "current": [
            1.0,
            0.0,
            0.0
          ],
          "following": [
            1.0,
            2.0,
