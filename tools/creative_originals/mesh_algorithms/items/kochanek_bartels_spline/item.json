            0.0
          ],
          "t": 1.0
        },
        "expect": {
          "sequence_close": [
            [
              1.0,
              1.0,
              0.0
            ],
            0.0
          ]
        }
      },
      "display": {
        "call": "build",
        "arguments": {},
        "expect": {
          "mesh_count": 2,
          "watertight": true
        }
      }
    },
    "complexity": "O(keys * samples_per_segment)",
    "outputs": [
      {
        "format": "gltf",
        "content": "tubes along the chosen spline and along a tension 0.8 version for comparison"
      },
      {
        "format": "obj",
        "content": "the same tubes as Wavefront OBJ"
      }
    ],
    "axes": "+Y up, metres"
  },
  "limits": "Keys are equally spaced in time; uneven key times would need the tangent scaling of the original paper, which is not applied. Large continuity values make visible corners by design. Open ends repeat the neighbour difference.",
  "related": [
