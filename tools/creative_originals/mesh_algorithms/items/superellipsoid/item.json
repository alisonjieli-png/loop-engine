  "identity": "superellipsoid",
  "title": "Superellipsoid superquadric",
  "purpose": "Generate Barr superquadric solids whose two exponents morph between boxes, cylinders, ellipsoids, diamonds and pinched stars, with the exact smooth volume available. Use it for rounded props and shape fitting.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
