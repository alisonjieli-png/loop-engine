        "name": "north_south",
        "type": "float",
        "default": 0.6,
        "unit": "exponent",
        "minimum": 0.01,
        "maximum": 4.0,
        "meaning": "Exponent e1 of the latitude profile: below 1 squarer, 1 round, above 1 pinched."
      },
      {
        "name": "east_west",
        "type": "float",
        "default": 0.3,
        "unit": "exponent",
        "minimum": 0.01,
        "maximum": 4.0,
        "meaning": "Exponent e2 of the horizontal cross-section: below 1 squarer, 1 round, 2 diamond."
