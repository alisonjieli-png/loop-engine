  "contract": {
    "module": "superellipsoid",
    "entry_points": [
      {
        "name": "superellipsoid_point",
        "signature": "superellipsoid_point(polar, azimuth, size_x=1.0, size_y=0.8, size_z=1.0, north_south=0.6, east_west=0.3)",
        "summary": "Surface point at polar angle ``polar`` from +Y and azimuth from +X toward -Z (signed powers of cos, sin)."
      },
      {
        "name": "superellipsoid",
        "signature": "superellipsoid(size_x=1.0, size_y=0.8, size_z=1.0, north_south=0.6, east_west=0.3, segments=48, rings=24)",
        "summary": "A welded superellipsoid: 2 + (rings - 1) * segments vertices, segments * rings faces, outward winding."
      },
      {
        "name": "superellipsoid_volume",
        "signature": "superellipsoid_volume(size_x=1.0, size_y=0.8, size_z=1.0, north_south=0.6, east_west=0.3)",
        "summary": "Exact volume of the smooth surface: 2 a b c e1 e2 B(e1 / 2 + 1, e1) B(e2 / 2, e2 / 2), B the beta function."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the superellipsoid as .gltf or .obj and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "size_x",
        "type": "float",
        "default": 1.0,
        "unit": "m",
        "minimum": 1e-06,
        "maximum": 1000000.0,
        "meaning": "Semi-axis along X."
      },
      {
        "name": "size_y",
        "type": "float",
