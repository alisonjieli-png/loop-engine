  "identity": "klein_bottle",
  "title": "Klein bottle figure-eight immersion",
  "purpose": "Build the figure-eight immersion of the Klein bottle: a closed, one-sided surface with no edge and Euler characteristic 0. Use it for mathematical sculpture and to test non-orientable meshes.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
