  "contract": {
    "module": "klein_bottle",
    "entry_points": [
      {
        "name": "figure_eight_point",
        "signature": "figure_eight_point(u, v, radius=2.0)",
        "summary": "Point of the figure-eight immersion at angles u (around the centre circle) and v (around the eight)."
      },
      {
        "name": "klein_bottle",
        "signature": "klein_bottle(radius=2.0, scale=0.5, u_segments=80, v_segments=24)",
        "summary": "A closed figure-eight Klein bottle: u_segments * v_segments vertices and as many quads."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the surface as .gltf or .obj and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "radius",
        "type": "float",
        "default": 2.0,
        "unit": "m",
        "minimum": 1.0,
        "maximum": 1000000.0,
        "meaning": "Radius of the centre circle before scaling; above 1 keeps the figure eight off the axis."
      },
      {
        "name": "scale",
        "type": "float",
        "default": 0.5,
        "unit": "m",
        "minimum": 1e-06,
        "maximum": 1000000.0,
        "meaning": "Uniform scale applied to the whole surface."
      },
      {
        "name": "u_segments",
        "type": "int",
        "default": 80,
        "unit": "count",
        "minimum": 3,
        "maximum": 100000,
        "meaning": "Divisions around the centre circle."
      },
      {
        "name": "v_segments",
        "type": "int",
        "default": 24,
        "unit": "count",
        "minimum": 4,
        "maximum": 100000,
        "meaning": "Divisions around the figure-eight cross-section."
      }
    ],
    "invariants": {
      "default": {
        "call": "klein_bottle",
        "arguments": {},
        "expect": {
          "vertex_count": 1920,
          "face_count": 1920,
          "closed": true,
          "manifold": true,
          "oriented": false,
          "euler_characteristic": 0,
          "components": 1,
          "normals": "unit"
        }
      },
      "coarse": {
        "call": "klein_bottle",
        "arguments": {
          "radius": 3.0,
          "scale": 1.0,
          "u_segments": 8,
          "v_segments": 6
        },
        "expect": {
          "vertex_count": 48,
          "face_count": 48,
          "closed": true,
          "oriented": false,
          "euler_characteristic": 0
        }
      },
      "seam_point": {
        "call": "figure_eight_point",
        "arguments": {
          "u": 0.0,
          "v": 0.0,
          "radius": 2.0
        },
        "expect": {
          "sequence_close": [
            [
              2.0,
              0.0,
              0.0
            ],
            1e-15
          ]
        }
      }
    },
    "complexity": "O(u_segments * v_segments)",
    "outputs": [
      {
        "format": "gltf",
        "content": "one double-sided mesh with POSITION and NORMAL, indexed triangles"
      },
      {
        "format": "obj",
        "content": "the same surface as Wavefront OBJ"
      }
    ],
    "axes": "+Y up, metres"
  },
  "limits": "The figure-eight immersion passes through itself along one circle, as every Klein bottle in three dimensions must; the mesh does not split faces there. There is no consistent winding, so normals flip across one seam and the surface should be drawn double-sided.",
