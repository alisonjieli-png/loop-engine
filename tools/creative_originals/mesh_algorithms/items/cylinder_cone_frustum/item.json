    "frustum",
    "pipe",
    "revolution"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "cylinder_cone_frustum.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "cylinder_cone_frustum",
    "entry_points": [
      {
        "name": "frustum",
        "signature": "frustum(bottom_radius=0.6, top_radius=0.3, height=1.2, segments=32, inner_radius=0.12, caps=True)",
        "summary": "A straight solid of revolution around Y, centred at the origin, with outward faces."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the solid as .gltf or .obj and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "bottom_radius",
        "type": "float",
        "default": 0.6,
        "unit": "m",
        "minimum": 0.0,
        "maximum": 1000000.0,
        "meaning": "Outer radius at the bottom (y = -height / 2); 0 makes a cone pointing down."
      },
      {
        "name": "top_radius",
        "type": "float",
        "default": 0.3,
        "unit": "m",
        "minimum": 0.0,
        "maximum": 1000000.0,
        "meaning": "Outer radius at the top (y = +height / 2); 0 makes a cone; equal radii make a cylinder."
      },
      {
        "name": "height",
        "type": "float",
        "default": 1.2,
        "unit": "m",
        "minimum": 1e-06,
        "maximum": 1000000.0,
        "meaning": "Distance between the bottom and top planes."
      },
      {
        "name": "segments",
        "type": "int",
        "default": 32,
        "unit": "count",
        "minimum": 3,
        "maximum": 4096,
        "meaning": "Divisions around the Y axis."
      },
      {
        "name": "inner_radius",
        "type": "float",
        "default": 0.12,
        "unit": "m",
        "minimum": 0.0,
        "maximum": 1000000.0,
        "meaning": "Radius of a straight bore along Y; 0 for a solid. Must be below both outer radii."
      },
      {
        "name": "caps",
        "type": "bool",
        "default": true,
        "unit": "flag",
        "meaning": "Close the ends; without caps the result is an open tube (or two tubes with a bore)."
      }
    ],
    "invariants": {
