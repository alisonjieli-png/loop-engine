{
  "record_type": "creative_original_item/v1",
  "identity": "cylinder_cone_frustum",
  "title": "Cylinder, cone, frustum and pipe",
  "purpose": "Generate straight solids of revolution: cylinders, cones, truncated cones and bored pipes, with flat-shaded caps and UVs. Use it for columns, cups, nozzles, pipes and lamp shades.",
  "form": "function",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "primitive",
