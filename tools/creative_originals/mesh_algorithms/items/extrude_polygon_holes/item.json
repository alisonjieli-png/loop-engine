  "record_type": "creative_original_item/v1",
  "identity": "extrude_polygon_holes",
  "title": "Extrude a polygon with holes",
  "purpose": "Extrude a 2D polygon with any number of holes into a closed solid with optional taper, triangulating the caps with bridged holes. Use it for plates, signs, floor plans, gaskets and logos.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "2.5d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "extrusion",
    "polygon with holes",
    "triangulation",
    "2.5d",
    "plate",
    "taper"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
