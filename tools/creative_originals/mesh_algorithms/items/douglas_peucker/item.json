  "contract": {
    "module": "douglas_peucker",
    "entry_points": [
      {
        "name": "simplify",
        "signature": "simplify(points, tolerance=0.05)",
        "summary": "The kept points, in order: both ends, and recursively the point farthest from the current chord segment while that distance exceeds ``tolerance``. Iterative (no recursion limit). O(n log n) typical, O(n^2) worst."
      },
      {
        "name": "max_deviation",
        "signature": "max_deviation(original, simplified)",
        "summary": "Largest distance from any original point to the simplified polyline (0 when nothing was removed)."
      },
      {
        "name": "demo_curve",
        "signature": "demo_curve(samples=400)",
        "summary": "A 3D test curve: a spiral with a superimposed wobble."
      },
      {
        "name": "build",
        "signature": "build(tolerance=0.05, samples=400)",
        "summary": "Two tubes: the original curve (thin, grey) and its simplification (thicker, coloured)."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write both tubes (.gltf or .obj) and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "tolerance",
        "type": "float",
        "default": 0.05,
        "unit": "m",
        "minimum": 0.0,
        "maximum": 1000000.0,
        "meaning": "Largest allowed distance from a removed point to the simplified polyline."
      },
      {
        "name": "samples",
        "type": "int",
        "default": 400,
        "unit": "count",
        "minimum": 2,
        "maximum": 1000000,
        "meaning": "Points in the demonstration curve before simplification."
      }
