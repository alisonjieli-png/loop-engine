  "identity": "delaunay_bowyer_watson",
  "title": "2D Delaunay triangulation by Bowyer-Watson",
  "purpose": "Triangulate 2D points so that no point lies inside any triangle's circumcircle, using Bowyer-Watson insertion with exact fallback predicates. Use it for terrain meshes, interpolation and Voronoi construction.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "2d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "delaunay",
    "triangulation",
    "bowyer-watson",
    "computational geometry",
    "2d",
    "exact predicates"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "delaunay_bowyer_watson.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "delaunay_bowyer_watson",
    "entry_points": [
      {
        "name": "delaunay",
        "signature": "delaunay(points)",
        "summary": "Delaunay triangulation of 2D points: {\"points\", \"triangles\", \"hull\"}."
      },
      {
        "name": "random_points",
        "signature": "random_points(count=160, layout='random', seed=11)",
        "summary": "Seeded demonstration points in the unit square: uniform 'random', 'jittered_grid' or concentric 'rings'."
      },
      {
        "name": "triangulation_mesh",
        "signature": "triangulation_mesh(result, height=0.0)",
        "summary": "A flat glTF-ready mesh of a triangulation: one colour per triangle, the plane facing +Y."
      },
      {
        "name": "build",
        "signature": "build(count=160, layout='random', seed=11)",
        "summary": "The coloured triangulation of seeded points that the command line writes."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the triangulation as .gltf or .obj and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "count",
        "type": "int",
        "default": 160,
        "unit": "count",
        "minimum": 3,
        "maximum": 20000,
        "meaning": "Number of input points."
      },
      {
        "name": "layout",
        "type": "str",
        "default": "random",
        "unit": "name",
        "choices": [
          "random",
          "jittered_grid",
          "rings"
        ],
        "meaning": "How the demonstration points are placed in the unit square."
      },
      {
        "name": "seed",
        "type": "int",
        "default": 11,
        "unit": "integer",
        "minimum": 0,
        "maximum": 2147483647,
        "meaning": "Random seed; the same seed gives the same points."
      }
    ],
