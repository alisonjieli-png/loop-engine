{
  "record_type": "creative_original_item/v1",
  "identity": "rotation_minimizing_frames",
  "title": "Rotation-minimizing frames by double reflection",
  "purpose": "Compute twist-free frames along a sampled curve with the double reflection method, compare them with Frenet frames and close loops without a jump. Use it for sweeps, ribbons, rails and camera roll.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "rotation minimizing frame",
    "double reflection",
    "frenet",
    "sweep",
    "ribbon",
    "parallel transport"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "rotation_minimizing_frames.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "rotation_minimizing_frames",
    "entry_points": [
      {
        "name": "double_reflection_frames",
        "signature": "double_reflection_frames(points, tangents=None, normal=None)",
        "summary": "Frames (tangent, normal, binormal) along sampled points by double reflection (Wang, Juttler, Zheng and Liu 2008): reflect the previous frame in the bisector plane of the chord, then in the plane that maps the reflected tangent onto the next tangent. Fourth-order accurate for smooth curves. Without ``tangents``, central differences of an open polyline are used; without ``normal``, one perpendicular to the first tangent is chosen."
      },
      {
        "name": "frenet_frames",
        "signature": "frenet_frames(points)",
        "summary": "Frenet frames from finite differences (normal toward the centre of curvature); undefined where the curve is straight, where the previous normal is kept."
      },
      {
        "name": "frame_normals",
        "signature": "frame_normals(points, closed=False)",
        "summary": "Just the normals of the rotation-minimizing frames for points with central-difference tangents."
      },
      {
        "name": "closing_twist",
        "signature": "closing_twist(points, frames)",
        "summary": "For a closed curve: the angle (radians, about the first tangent) between the first normal and the last frame carried once more across the closing chord. Zero means the frames join without a twist."
      },
      {
        "name": "twist_between",
        "signature": "twist_between(frames_a, frames_b)",
        "summary": "Signed angle (radians) of each normal of ``frames_b`` relative to the matching normal of ``frames_a``, about the tangent of ``frames_a``."
      },
      {
        "name": "demo_curve",
        "signature": "demo_curve(curve='trefoil', samples=300)",
        "summary": "Points of a demonstration curve: a closed trefoil knot, a three-turn helix or an open wave."
      },
      {
        "name": "ribbon",
        "signature": "ribbon(points, frames, width=0.25, closed=False, spread_twist=True)",
        "summary": "A two-sided strip across each frame's binormal (the strip faces along the normal); a closed curve can spread its closing twist evenly so the strip joins without a jump."
      },
      {
        "name": "build",
        "signature": "build(curve='trefoil', width=0.25, samples=300)",
        "summary": "The ribbon along the demonstration curve, oriented by rotation-minimizing frames."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the ribbon (.gltf or .obj) and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "curve",
        "type": "str",
        "default": "trefoil",
        "unit": "name",
        "choices": [
          "trefoil",
          "helix",
          "wave"
        ],
        "meaning": "Demonstration curve the ribbon follows."
      },
      {
        "name": "width",
        "type": "float",
        "default": 0.25,
        "unit": "m",
        "minimum": 0.001,
        "maximum": 100.0,
        "meaning": "Ribbon width across the frame normal."
      },
      {
        "name": "samples",
        "type": "int",
        "default": 300,
        "unit": "count",
        "minimum": 4,
        "maximum": 100000,
        "meaning": "Samples along the curve."
      }
    ],
