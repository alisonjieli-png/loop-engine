    "complexity": "O(points * sides)",
    "outputs": [
      {
        "format": "gltf",
        "content": "the flat-shaded demonstration pipe with POSITION and NORMAL"
      },
      {
        "format": "obj",
        "content": "the same pipe as Wavefront OBJ"
      }
    ],
    "axes": "+Y up, metres"
  },
  "limits": "Sharp corners (turning more than about 120 degrees) make long miter spikes; corners closer than the radius overlap. Use profile_sweep or a tube for smooth bends. The cross-section is a regular polygon centred on the path.",
  "related": [
