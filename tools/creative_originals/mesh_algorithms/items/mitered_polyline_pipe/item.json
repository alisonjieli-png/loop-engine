              0.0
            ]
          ],
          "radius": 0.5,
          "sides": 4
        },
        "expect": {
          "vertex_count": 12,
          "face_count": 10,
          "watertight": true,
          "volume": [
            2.5,
            1e-12
          ]
        }
      },
      "plumbing": {
        "call": "mitered_pipe",
        "arguments": {
          "points": [
            [
              -1.5,
              0.0,
              0.0
            ],
            [
