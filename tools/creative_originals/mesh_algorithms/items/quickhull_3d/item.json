  "identity": "quickhull_3d",
  "title": "3D convex hull by quickhull",
  "purpose": "Compute the convex hull of 3D points as a closed mesh with outward faces, merging coplanar triangles into polygons. Use it for collision shapes, bounding volumes and faceted gem forms.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
