  "contract": {
    "module": "quickhull_3d",
    "entry_points": [
      {
        "name": "convex_hull",
        "signature": "convex_hull(points, merge_coplanar=True, tolerance=None)",
        "summary": "The convex hull of 3D points as a closed mesh with outward faces."
      },
      {
        "name": "sphere_points",
        "signature": "sphere_points(count=60, radius=1.0)",
        "summary": "``count`` points spread evenly on a sphere by the golden-angle (Fibonacci) spiral; every point is extreme."
      },
      {
        "name": "random_points",
        "signature": "random_points(count=300, distribution='ball', seed=5)",
        "summary": "Seeded random points in the unit ball, the cube [-1, 1]^3, on the unit sphere, or Gaussian (sigma 0.5)."
      },
      {
        "name": "build",
        "signature": "build(count=300, distribution='ball', seed=5)",
        "summary": "The faceted hull of seeded random points that the command line writes."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the hull of random points as .gltf or .obj and print a JSON summary."
      }
    ],
    "parameters": [
