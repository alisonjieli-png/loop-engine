{
  "record_type": "creative_original_item/v1",
  "identity": "catmull_rom_spline",
  "title": "Centripetal Catmull-Rom spline",
  "purpose": "Interpolate a curve through control points with uniform, centripetal or chordal Catmull-Rom parameterization, open or closed. Use it for paths through waypoints, camera rails and track layouts.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "3d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "catmull-rom",
    "spline",
    "interpolation",
    "centripetal",
    "waypoints",
    "curve"
  ],
  "files": [
    {
      "path": "README.md",
      "role": "other"
    },
    {
      "path": "catmull_rom_spline.py",
      "role": "executable_tool"
    },
    {
      "path": "example.gltf",
      "role": "skill_asset"
    }
  ],
  "contract": {
    "module": "catmull_rom_spline",
    "entry_points": [
      {
        "name": "catmull_rom_point",
        "signature": "catmull_rom_point(p0, p1, p2, p3, t, alpha=0.5)",
        "summary": "Point between p1 (t = 0) and p2 (t = 1) of the Catmull-Rom segment with knot spacing |dp|^alpha, by the Barry-Goldman pyramid of linear interpolations."
      },
      {
        "name": "catmull_rom",
        "signature": "catmull_rom(points, alpha=0.5, closed=False, samples_per_segment=16)",
        "summary": "Points of the spline through every control point; each segment contributes ``samples_per_segment`` points starting at its first control point, and an open spline ends exactly on the last point. Open ends use a reflected neighbour (2 p0 - p1) so the end tangents follow the first and last segments."
      },
      {
        "name": "build",
        "signature": "build(alpha=0.5, closed=True, samples_per_segment=16)",
        "summary": "A tube through the demonstration control points plus small markers at each control point."
      },
      {
        "name": "main",
        "signature": "main(argv=None)",
        "summary": "Command line: write the spline tube and control markers (.gltf or .obj) and print a JSON summary."
      }
    ],
    "parameters": [
      {
        "name": "alpha",
        "type": "float",
        "default": 0.5,
        "unit": "exponent",
        "minimum": 0.0,
        "maximum": 1.0,
        "meaning": "Knot spacing exponent: 0 uniform, 0.5 centripetal (no cusps or self-loops), 1 chordal."
      },
      {
        "name": "closed",
        "type": "bool",
        "default": true,
        "unit": "flag",
        "meaning": "Join the last control point back to the first."
      },
      {
        "name": "samples_per_segment",
        "type": "int",
        "default": 16,
        "unit": "count",
        "minimum": 1,
        "maximum": 10000,
        "meaning": "Points per segment between consecutive control points."
      }
    ],
    "invariants": {
      "passes_through_start": {
        "call": "catmull_rom_point",
        "arguments": {
          "p0": [
            0.0,
            0.0,
            0.0
          ],
