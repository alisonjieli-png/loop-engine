      }
    },
    "complexity": "O(n * 2^iterations)",
    "outputs": [
      {
        "format": "gltf",
        "content": "the smoothed demonstration star as a flat plate and the input polygon as a thin tube"
      },
      {
        "format": "obj",
        "content": "the same meshes as Wavefront OBJ"
      }
    ],
    "axes": "+Y up, metres; 2D (x, y) maps to (x, 0, -y)"
  },
  "limits": "The curve shrinks inside the control polygon (it approximates, it does not interpolate). Point counts double every round. Ratios other than 1/4 converge to curves that are not the quadratic B-spline.",
