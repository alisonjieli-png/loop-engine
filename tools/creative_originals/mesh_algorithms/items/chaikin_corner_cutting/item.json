  "record_type": "creative_original_item/v1",
  "identity": "chaikin_corner_cutting",
  "title": "Chaikin corner cutting",
  "purpose": "Round polygons and polylines by repeated corner cutting at the quarter points, converging to the quadratic B-spline. Use it for smooth outlines, organic 2D shapes and softening hand-drawn strokes.",
  "form": "library_module",
  "asset_role": null,
  "dimension": "2d",
  "engine": {
    "name": "python",
    "minimum_version": "3.10"
  },
  "tags": [
    "chaikin",
    "corner cutting",
    "subdivision",
    "curve smoothing",
    "2d",
    "b-spline"
  ],
  "files": [
