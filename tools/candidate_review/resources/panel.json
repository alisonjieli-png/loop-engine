{
  "record_type": "candidate_review_panel/v1",
  "policy": {
    "record_type": "candidate_review_panel_policy/v1",
    "minimum_approvals": 3,
    "minimum_distinct_families": 3,
    "exclude_producer_family": true,
    "any_rejection_withholds_approval": true,
    "reviewers_per_item": 3,
    "stop_asking_after_first_rejection": false,
    "prechecks": {
      "licence": ["builtin_licence_rules"],
      "format": ["builtin_format_rules", "agent_skills_reference"],
      "safety": ["builtin_static_rules", "skillspector_static"],
      "effects": ["builtin_effect_rules"],
      "secrets": ["builtin_secret_patterns"],
      "duplicates": ["exact_shingle_jaccard", "datasketch_minhash_lsh"]
    },
    "accepted_licences": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "CC0-1.0", "CC-BY-4.0"],
    "output_allocation_tokens": 8192,
    "temperature": 0.0,
    "rate_limit": {
      "initial_seconds": 15.0,
      "maximum_seconds": 120.0,
      "maximum_total_seconds": 900.0,
      "maximum_retries_per_call": 3
    }
  },
  "families": ["anthropic", "openai", "zhipu", "deepseek", "alibaba", "minimax", "moonshot", "mistral", "nvidia", "google"],
  "precheck_engines": {
    "builtin_licence_rules": {
      "licence_states_accepted": ["declared"],
      "licence_sentence": "Licence: {licence}."
    },
    "builtin_format_rules": {
      "minimum_words": 150,
      "maximum_words": 600,
      "required_parts": ["## When to use it", "## Steps", "## Checks", "## Known-wrong example", "## What to record", "## Source"],
      "grounding_sentences": {
        "restates_cited_source": "Compiled from revision {revision}.",
        "general_practice_beside_cited_source": "Written for this catalogue at revision {revision}."
      },
      "general_practice_grounding": "general_practice_beside_cited_source",
      "general_practice_sentence": "The steps above are ordinary engineering practice, written for this catalogue in its own words.",
      "maximum_description_characters": 1024,
      "forbidden_patterns": [
        "(?<![a-z0-9])loops?(?![a-z0-9])",
        "(?<![a-z0-9])practitioners?(?![a-z0-9])",
        "role[\\s_-]+profiles?",
        "runtime[\\s_-]+classification",
        "solution[\\s_-]+canvas",
        "code[\\s_-]+nodes?",
        "(?<![a-z0-9])spawn(?:s|ed|ing)?(?![a-z0-9])",
        "starting[\\s_-]+(?:solution|intelligence)(?![a-z0-9])",
        "run[\\s_-]+history",
        "runtime[\\s_-]+(?:memory|history)",
        "(?:context|code|solution|feedback)[\\s_-]+intelligence",
        "intelligence[\\s_-]+(?:items?|quer(?:y|ies)|layers?)",
        "(?<![a-z0-9])(?:grand)?child(?:ren)?(?![a-z0-9])",
        "[\u2014\u2013\u2015\u2212]",
        "stop[\\s_-]+conditions?",
        "(?<![a-z0-9])receipts?(?![a-z0-9])",
        "(?<![a-z0-9])chronicles?(?![a-z0-9])",
        "what[\\s_-]*is[\\s_-]*next|what[\\s_-]+next|whats[\\s_-]*next"
      ]
    },
    "agent_skills_reference": {
      "program": "agentskills",
      "arguments": ["validate", "{skill_folder}"],
      "version_arguments": ["--version"],
      "timeout_seconds": 60
    },
    "builtin_static_rules": {},
    "skillspector_static": {
      "program": "skillspector",
      "arguments": ["scan", "{skill_folder}", "--no-llm", "--format", "json", "--output", "{report_path}"],
      "version_arguments": ["--version"],
      "timeout_seconds": 180,
      "tolerated_partial_reasons": ["reference_missing"],
      "refuse_at_or_above": "HIGH"
    },
    "builtin_effect_rules": {},
    "builtin_secret_patterns": {
      "extra_patterns": [
        "sk_(?:live|test)_[A-Za-z0-9]{16,}",
        "github_pat_[A-Za-z0-9_]{20,}",
        "AIza[0-9A-Za-z_\\-]{35}",
        "eyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}",
        "-----BEGIN [A-Z ]*PRIVATE KEY-----"
      ]
    },
    "exact_shingle_jaccard": {
      "shingle_words": 5,
      "near_duplicate_threshold": 0.8,
      "maximum_population": 5000
    },
    "datasketch_minhash_lsh": {
      "shingle_words": 5,
      "near_duplicate_threshold": 0.8,
      "permutations": 128
    }
  },
