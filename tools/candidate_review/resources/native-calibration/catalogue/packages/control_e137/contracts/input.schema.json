{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
            },
            "minItems": 0,
            "maxItems": 60,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "duration",
          "depends_on"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 60
    }
  },
  "required": [
    "tasks"
  ],
  "additionalProperties": false
}
