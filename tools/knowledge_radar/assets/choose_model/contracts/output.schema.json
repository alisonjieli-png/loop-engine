{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "choose_model result",
 "type": "object",
 "additionalProperties": false,
 "required": ["record_type", "as_of", "valid_until", "on", "rule", "basis", "expected_input_tokens", "expected_output_tokens", "chosen", "rejected", "state"],
 "properties": {
  "record_type": {"const": "knowledge_radar_choose_model_result/v2"},
  "as_of": {"type": ["string", "null"]},
  "valid_until": {"type": "string"},
  "on": {"type": "string"},
  "rule": {"type": "string"},
  "basis": {"type": "string"},
  "expected_input_tokens": {"type": "integer"},
  "expected_output_tokens": {"type": "integer"},
  "state": {"enum": ["chosen", "no_eligible_option", "table_expired"]},
  "note": {"type": "string"},
  "rejected": {"type": "object", "additionalProperties": {"type": "integer"}},
  "chosen": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "url", "provider", "model_id", "input_price", "output_price", "context", "structured_output", "tool_calling", "deprecation_date", "estimated_cost_per_call"],
    "properties": {
     "title": {"type": "string"},
     "url": {"type": "string"},
     "provider": {"type": ["string", "null"]},
     "model_id": {"type": ["string", "null"]},
     "input_price": {"type": "number"},
     "output_price": {"type": "number"},
     "context": {"type": ["integer", "null"]},
     "structured_output": {"type": ["boolean", "null"]},
     "tool_calling": {"type": ["boolean", "null"]},
     "deprecation_date": {"type": ["string", "null"]},
     "estimated_cost_per_call": {"type": "number"}
    }
   }
  }
 }
}
