{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "choose_model request",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "needs_structured_output": {"type": "boolean", "default": true},
  "needs_tool_calling": {"type": "boolean", "default": false},
  "needs_reasoning": {"type": "boolean", "default": false},
  "minimum_context": {"type": "integer", "minimum": 0, "default": 0},
  "maximum_output_price": {"type": ["number", "null"], "minimum": 0, "description": "US dollars per million output tokens"},
  "maximum_cost_per_call": {"type": ["number", "null"], "minimum": 0, "description": "US dollars for one call of the expected size"},
  "expected_input_tokens": {"type": "integer", "minimum": 0, "default": 1000},
  "expected_output_tokens": {"type": "integer", "minimum": 0, "default": 300},
  "open_weights_only": {"type": "boolean", "default": false},
  "allowed_providers": {"type": ["array", "null"], "items": {"type": "string"}},
  "count": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5},
  "today": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
 }
}
