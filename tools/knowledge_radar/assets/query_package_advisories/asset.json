{
  "record_type": "knowledge_radar_asset/v1",
  "asset_id": "query_package_advisories",
  "asset_version": "1.0.0",
  "kind": "tool",
  "title": "Query open source advisories for one package version",
  "purpose": "Asks the OSV.dev API at call time which published advisories affect one exact package version and returns identifiers, aliases, dates, severity entries and fixed versions, so a harness never relies on a stored advisory list.",
