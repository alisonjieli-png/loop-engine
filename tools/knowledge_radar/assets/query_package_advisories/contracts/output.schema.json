{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "query_package_advisories result",
  "description": "The OSV advisories that affect one package version, as OSV answered at observed_at. A value that OSV leaves out is null. The free-text details of an advisory are never returned.",
  "type": "object",
  "properties": {
    "record_type": {"const": "knowledge_radar_query_package_advisories_result/v1"},
    "ecosystem": {
      "type": "string",
      "enum": ["PyPI", "npm", "Go", "crates.io", "Maven", "NuGet", "RubyGems", "Packagist", "Hex", "Pub"]
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 300},
    "version": {"type": "string", "minLength": 1, "maxLength": 100},
    "count": {"description": "Number of entries in vulnerabilities.", "type": "integer", "minimum": 0},
    "vulnerabilities": {
      "description": "One entry for each advisory identifier, in the order OSV returned them.",
      "type": "array",
      "items": {"$ref": "#/$defs/vulnerability"}
    },
    "source": {"const": "https://api.osv.dev/v1/query"},
    "observed_at": {
      "description": "UTC time of the read.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": ["record_type", "ecosystem", "name", "version", "count", "vulnerabilities", "source", "observed_at"],
  "additionalProperties": false,
  "$defs": {
    "vulnerability": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "aliases": {"description": "Other identifiers of the same problem, or null when OSV gives none.", "type": ["array", "null"], "items": {"type": "string"}},
        "published": {"type": ["string", "null"]},
        "modified": {"type": ["string", "null"]},
        "severity": {
          "description": "The severity entries of the advisory as OSV gives them, or null when OSV gives none.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "type": {"description": "For example CVSS_V3 or CVSS_V4.", "type": ["string", "null"]},
              "score": {"description": "The score string as given, for example a CVSS vector.", "type": ["string", "null"]}
            },
            "required": ["type", "score"],
            "additionalProperties": false
          }
        },
        "fixed_versions": {
          "description": "Fixed events of ECOSYSTEM and SEMVER ranges for the asked package, in source order, each once. Commit identifiers of GIT ranges are not included.",
          "type": "array",
          "items": {"type": "string"}
        },
        "details_address": {"type": "string", "pattern": "^https://osv\\.dev/vulnerability/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
      },
      "required": ["id", "aliases", "published", "modified", "severity", "fixed_versions", "details_address"],
      "additionalProperties": false
    }
  }
}
