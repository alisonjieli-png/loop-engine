{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP service setup plan request",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type"],
  "properties": {
    "record_type": {"const": "mcp_setup_plan_request/v1"},
    "query": {"type": "string", "maxLength": 160, "pattern": "^[A-Za-z0-9 ._-]*$"},
    "publisher": {"type": "string", "maxLength": 120, "pattern": "^[a-z0-9.-]*$"},
    "transport": {"enum": ["streamable-http", "sse"]},
    "count": {"type": "integer", "minimum": 1, "maximum": 20},
    "on": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
