# Website and authenticated intelligence service. Customer harnesses stay local.
# The worker Dockerfile remains a separate image with its existing command.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip wheel --wheel-dir /wheels '.[serving]'

FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY --from=build /wheels /wheels
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels 'loop-engine[serving]' \
    && rm -r /wheels
# The reviewed starter catalogue travels in the release, not on the Fly volume,
# because a volume holds state and this is release content. The folder is
# generated by tools/build_host_catalogue_manifest.py from the independent
# review record, so it holds the approved bodies and the manifest that names
# them and nothing else. This is a copy from the build context; the build makes
# no network request. /data/host.json points manifest_path at the file below.
COPY examples/29_intelligence_service/starter-catalogue/host-release /opt/baltor/catalogue
RUN chown -R 65534:65534 /opt/baltor/catalogue \
    && find /opt/baltor/catalogue -type d -exec chmod 0555 {} + \
    && find /opt/baltor/catalogue -type f -exec chmod 0444 {} + \
    && test -f /opt/baltor/catalogue/manifest.json
USER 65534:65534
WORKDIR /tmp
EXPOSE 8080
ENTRYPOINT ["loop-engine"]
CMD ["service", "serve", "--config", "/data/host.json", "--host", "0.0.0.0", "--port", "8080", "--behind-trusted-tls-proxy"]
