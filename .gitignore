# Embodiment runtimes, upstream clones, mirrors, and release archives.
# The authored files (harness.json, manifest.json, README.md, run.py,
# catalog.json, qualification.json) stay tracked.
/embodiments/*/runtime/
/embodiments/*/upstream/
/embodiments/mirrors/
/embodiments/**/*.tgz
/embodiments/**/*.tar.zst
/embodiments/**/SHA256SUMS

# Third-party source copies, virtual environments, scratch trees, repository
# snapshots, and harness fake-home state inside dated evidence trees.
/artifacts/**/source/
/artifacts/**/snapshot/
/artifacts/**/tmp/
/artifacts/**/home/
/artifacts/**/evidence/*-env-*/
/artifacts/**/evidence/base-venv/
/artifacts/**/dist/
/artifacts/**/prior-review-material/

# Databases, write-ahead logs, archives, and other generated binaries inside
# evidence trees. Summaries and reports next to them stay tracked.
/artifacts/**/*.duckdb
/artifacts/**/*.duckdb.wal
/artifacts/**/*.sqlite
/artifacts/**/*.sqlite-wal
/artifacts/**/*.sqlite-shm
/artifacts/**/*.db
/artifacts/**/*.db-wal
/artifacts/**/*.db-shm
/artifacts/**/*.gz
/artifacts/**/*.whl
/artifacts/**/*.so
/artifacts/**/*.tiktoken
/artifacts/**/*.lance
/artifacts/**/*.lock
/artifacts/**/*.png
node_modules/

# Large structural projections are versioned as compressed, lossless archives
# and are also embedded in the single self-contained HTML system map.
/artifacts/architecture-audit-2026-09-19/inventory.json
/artifacts/architecture-audit-2026-09-19/graph.json
!/artifacts/architecture-audit-2026-09-19/inventory.json.gz
!/artifacts/architecture-audit-2026-09-19/graph.json.gz

# Complete hardcoding audit dumps are about 37 MB each and can be regenerated
# from any revision with the development tools. Their small summaries, triage
# records and canary results beside them are tracked.
/artifacts/architecture-audit-2026-09-19/decision-endpoints-hardcoding-[0-9].json
/artifacts/architecture-audit-2026-09-19/launch-hardcoding-attempt-[0-9].json
/artifacts/architecture-audit-2026-09-19/hardcoding-service-integration-attempt-[0-9].json
/artifacts/architecture-audit-2026-09-19/hardcoding-triage-current.json
/artifacts/architecture-audit-2026-09-19/hardcoding-before-exact-allowances-20260919.json
/artifacts/architecture-audit-2026-09-19/hardcoding-after-source-repairs.json
/artifacts/architecture-audit-2026-09-19/hardcoding-after-exact-allowances-20260919.json

# Run workspaces and batch outputs inside dated evidence trees. The
# summaries, reports, and manifests next to them are tracked and are what
# the documentation links.
/artifacts/harness-expansion-*/*/
/artifacts/harness-t1-gates/work/
/artifacts/embodiment-comparison-*/*/
/artifacts/embodiment-study-*/case-*/
/artifacts/project-review-*/base-cli-acceptance/
/artifacts/project-review-*/product-acceptance/
/artifacts/project-review-*/studio-runs/
/artifacts/universal-compiler-audit-*/snapshot-*/

# Added 2026-09-14: the local task database (about 276 GB of Kaggle,
# OpenML, and synthetic task material) and campaign run outputs (about
# 6 GB) now live inside this checkout. They are data, not source, and tools
# that list untracked files must not walk them. stub-test is the moved
# Capability-Reuse Harness workspace, which keeps its own history.
/task_database/
/task-campaign-runs/
/stub-test/

# Isolated worktrees that parallel development agents create and remove.
/.claude/worktrees/
