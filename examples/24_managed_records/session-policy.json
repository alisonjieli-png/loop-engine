{
  "record_type": "record_operation_policy/v1",
  "policy_id": "example.development_session.v1",
  "scope": {
    "namespace": "development.sessions",
    "source_collection": "learned",
    "intelligence_layer": "runtime_history_solution_intelligence",
    "artifact_kind": "intelligence_record",
    "record_id_prefix": "session."
  },
  "document_schema": {
    "type": "object",
    "required": ["title", "source_revision", "status", "tests", "unproven", "next_actions"],
    "additionalProperties": false,
    "properties": {
      "title": {"type": "string", "maxLength": 160},
      "source_revision": {"type": "string", "minLength": 40, "maxLength": 64, "pattern": "^[a-f0-9]+$"},
      "status": {"type": "string", "maxLength": 80},
      "tests": {
        "type": "array", "maxItems": 30,
        "items": {
          "type": "object", "required": ["name", "passed", "total", "evidence_ref"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "maxLength": 160},
            "passed": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "evidence_ref": {"type": "string", "maxLength": 1024}
          }
        }
      },
      "unproven": {"type": "array", "maxItems": 40, "items": {"type": "string", "maxLength": 500}},
      "next_actions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 500}}
    }
  },
  "indexed_fields": ["status", "source_revision"],
  "maximum_document_bytes": 32768,
  "maximum_query_results": 50,
  "maximum_history_depth": 50
}
