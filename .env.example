# Copy to .env and fill in whichever you have. None is required.
# deterministic loops run without any provider.

# One key, many models (https://openrouter.ai)
OPENROUTER_API_KEY=

# Ollama Cloud (https://ollama.com)
OLLAMA_API_KEY=

# Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=

# Your own OpenAI-compatible servers. Fields: name, url, model, key, wire,
# locality, max_output, evidence. Separate multiple endpoints with |
# LOOP_ENGINE_ENDPOINTS=name=my_server,url=http://localhost:11434/v1,model=qwen2.5:7b

# Optional candidate Context store. The default is
# ~/.loop-engine/intelligence/candidates/context.jsonl
# LOOP_ENGINE_CONTEXT_CANDIDATES=/absolute/path/context.jsonl
