{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_units": {
      "type": "integer"
    },
    "closing_units": {
      "type": "integer"
    },
    "discrepancy_units": {
      "type": "integer"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "status": {
      "enum": [
        "matches",
        "needs_review"
      ]
    }
  },
  "required": [
    "sku",
    "closing_units",
    "available_units",
    "discrepancy_units",
    "status",
    "reason"
  ],
  "type": "object"
}
