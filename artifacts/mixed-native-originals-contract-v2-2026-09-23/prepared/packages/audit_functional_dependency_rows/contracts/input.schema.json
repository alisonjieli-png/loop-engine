{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "determinants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {},
        "description": "Only columns named in determinants/dependents require the bounded scalar domain; the tool enforces these data-dependent constraints. Other columns are ignored."
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "determinants",
    "dependents",
    "rows"
  ],
  "additionalProperties": false
}
