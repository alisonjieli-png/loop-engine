{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "variables": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
          },
          "when": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "decision": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
          }
        },
        "required": [
          "id",
          "when",
          "decision"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
    }
  },
  "required": [
    "variables",
    "rules"
  ],
  "additionalProperties": false
}
