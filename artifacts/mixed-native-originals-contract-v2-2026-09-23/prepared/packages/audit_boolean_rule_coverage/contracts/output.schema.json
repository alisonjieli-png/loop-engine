{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "unambiguous_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "uncovered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "minItems": 0,
      "maxItems": 64
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assignment": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
            },
            "minItems": 2,
            "maxItems": 50,
            "uniqueItems": true
          }
        },
        "required": [
          "assignment",
          "rule_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "unambiguous_count",
    "uncovered",
    "conflicts"
  ],
  "additionalProperties": false
}
