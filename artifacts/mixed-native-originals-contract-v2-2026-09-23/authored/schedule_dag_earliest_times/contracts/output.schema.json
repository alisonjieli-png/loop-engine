{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "duration": {
      "type": "integer",
      "minimum": 0
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}(?![\\s\\S])"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "finish": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "start",
          "finish"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 60
    }
  },
  "required": [
    "duration",
    "schedule"
  ],
  "additionalProperties": false
}
