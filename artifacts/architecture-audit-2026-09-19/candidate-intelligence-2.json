        "family": "evaluation",
        "license_state": "pending_review",
        "tags": [
          "model selection",
          "cost",
          "latency",
          "retry",
          "routing"
        ],
        "title": "Compare complete route cost rather than the first model call"
      },
      "payload": {
        "authoring": "assistant_authored_from_repository_sources",
        "execution_available": false,
        "family": "evaluation",
        "license_state": "pending_review",
        "lifecycle": "candidate",
        "qualification": "not_independently_qualified",
        "record_type": "candidate_intelligence_specification/v1",
        "sources": [
          {
            "path": "docs/guides/configuration-grid-search-and-optimization.md",
            "sha256": "51bb646ab4ba7d99cf4678e84ac3fa7eee787261f8e54e702bd58f0e2912da12"
          },
          {
            "path": "docs/architecture/CONSTITUTION.md",
            "sha256": "986401969a2745862693335a89f3a38025c1a20271d6b0030f9798f00517554a"
          }
        ],
        "symbols": [],
        "text": "Compare eligible routes on the same frozen task population. Include retrieval, feature computation, process startup, context transfer, execution, verification and permitted retries. Keep correctness and authority as hard requirements. Record failures, uncertain costs and missing token accounting. A cheaper initial call is not a cheaper successful task when it needs more retries. Do not promote a route from these instructions alone.",
        "title": "Compare complete route cost rather than the first model call"
      }
    },
