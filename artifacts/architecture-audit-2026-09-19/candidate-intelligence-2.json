        "family": "method",
        "license_state": "pending_review",
        "tags": [
          "failure",
          "environment",
          "verification",
          "repair"
        ],
        "title": "Classify a failed check before changing the work"
      },
      "payload": {
        "authoring": "assistant_authored_from_repository_sources",
        "execution_available": false,
        "family": "method",
        "license_state": "pending_review",
        "lifecycle": "candidate",
        "qualification": "not_independently_qualified",
        "record_type": "candidate_intelligence_specification/v1",
        "sources": [
          {
            "path": "docs/architecture/CONSTITUTION.md",
            "sha256": "986401969a2745862693335a89f3a38025c1a20271d6b0030f9798f00517554a"
          }
        ],
        "symbols": [],
        "text": "Preserve the failing input and observation. Determine whether the candidate, the check or the environment is wrong. Name the smallest discriminating test and a known-wrong control. A revised check needs separate review and must still reject that control. Never use a review to waive permission, secrets, network, spending, sandbox or external-effect requirements.",
        "title": "Classify a failed check before changing the work"
      }
    },
    {
      "record_id": "pilot.review.20260920.complete_route_cost",
      "record_version": "cd57eaf70bd5fef2149fd5a4f42a631a7589049e625c1e2c61511d167d56be7f",
      "intelligence_layer": "context",
      "source_collection": "learned",
