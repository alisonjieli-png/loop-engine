        "title": "Select a reference before downloading intelligence"
      },
      "payload": {
        "authoring": "assistant_authored_from_repository_sources",
        "execution_available": false,
        "family": "method",
        "license_state": "pending_review",
        "lifecycle": "candidate",
        "qualification": "not_independently_qualified",
        "record_type": "candidate_intelligence_specification/v1",
        "sources": [
          {
            "path": "docs/guides/harness-instance-context-layout.md",
            "sha256": "5c8cc6928fbe1a8eb96c8d7d8dd173ab9fa2f864cbbfb18b345bc0c9c96f569f"
          },
          {
            "path": "src/loop_engine/core/service_runtime/provisioning.py",
            "sha256": "4b5553ae122781f31737d19d9b77886c74535e8674fe6ba96ee3e0699bb54d06"
          }
        ],
        "symbols": [],
        "text": "Search for small references using task requirements and authorized scope. Inspect source, revision, compatibility, license state and qualification. Select the required references before requesting bodies. Reauthorize at fetch time and compare exact bytes with the selected digest. Record selection, fetching, native loading and downstream use separately. A digest match does not prove safety or usefulness.",
        "title": "Select a reference before downloading intelligence"
      }
    },
    {
      "record_id": "pilot.review.20260920.failure_classification",
      "record_version": "c15b804895279d615bd61105c8f7f9ead4e0272c1fe3e8cd055cec5baaca71e0",
      "intelligence_layer": "context",
      "source_collection": "learned",
