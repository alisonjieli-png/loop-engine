        ],
        "title": "Check missing inputs before a consequential action"
      },
      "payload": {
        "authoring": "assistant_authored_from_repository_sources",
        "execution_available": false,
        "family": "checklist",
        "license_state": "pending_review",
        "lifecycle": "candidate",
        "qualification": "not_independently_qualified",
        "record_type": "candidate_intelligence_specification/v1",
        "sources": [
          {
            "path": "AGENTS.md",
            "sha256": "3a27395761176dc7c328c04e964319d62660d36349eee63680ca6c0f0b3efabd"
          },
          {
            "path": "src/loop_engine/core/action_vector_assessment.py",
            "sha256": "888d739871a2f607a2ec55357a27cbee291ec301e866422abc73a623adba182c"
          }
        ],
        "symbols": [],
        "text": "Before acting, identify the supplied inputs, requested output and acceptance check. List missing information that changes the result. Keep an unknown value distinct from a false value. Prepare useful work that does not require the missing authority, and ask a scoped question when only the owner can resolve it. Do not substitute a guessed permission or fabricate an input.",
        "title": "Check missing inputs before a consequential action"
      }
    },
    {
      "record_id": "pilot.review.20260920.reference_before_body",
