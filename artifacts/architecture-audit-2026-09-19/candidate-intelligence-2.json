      "payload": {
        "authoring": "assistant_authored_from_repository_sources",
        "execution_available": false,
        "family": "connection_recipe",
        "license_state": "pending_review",
        "lifecycle": "candidate",
        "qualification": "not_independently_qualified",
        "record_type": "candidate_intelligence_specification/v1",
        "sources": [
          {
            "path": "docs/guides/launch-setup-runbook.md",
            "sha256": "58ac50aae2df8f71c61b0cdf43c915a58d0782c22fe37e41bb3f534b105d0128"
          },
          {
            "path": "src/loop_engine/core/service_runtime/web_assets/client-recipes.json",
            "sha256": "3d976e2ffed89ba3339c01dcb795be485b6dc6ee23dc43c2d897d50bed40bb60"
          }
        ],
        "symbols": [],
        "text": "First verify the service origin and declared protocol. Supply a scoped service token through the client's secret mechanism. Confirm the server-bound tenant and available operations. Model access is configured separately in the executor or approved broker. Do not send a model key to the website, put a token in a URL, or assume an operator's provider login supplies backend runtime credentials.",
        "title": "Distinguish a service token from model-provider authentication"
      }
    },
