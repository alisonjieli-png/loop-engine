--- a/tests/test_regression_set_key.py
+++ b/tests/test_regression_set_key.py
@@ -0,0 +1,15 @@
+import os
+from dotenv.main import set_key, dotenv_values
+
+def test_set_key_with_trailing_backslash():
+    env_file = "test_regression.env"
+    try:
+        win_dir_val = "C:\\Users\\me\\"
+        set_key(env_file, "WIN_DIR", win_dir_val)
+        set_key(env_file, "NEXT", "ok")
+        values = dotenv_values(env_file)
+        assert values["WIN_DIR"] == win_dir_val
+        assert values["NEXT"] == "ok"
+    finally:
+        if os.path.exists(env_file):
+            os.remove(env_file)
