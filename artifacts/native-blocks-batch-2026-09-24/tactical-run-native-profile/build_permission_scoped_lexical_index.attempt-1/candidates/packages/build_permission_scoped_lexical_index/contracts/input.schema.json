{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#",
  "title": "Lexical Index Request",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["build", "query"]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": ["string", "integer"] },
          "text": { "type": "string" },
          "tenant_id": { "type": "string" },
          "source_hash": { "type": "string" }
        },
        "required": ["id", "text", "tenant_id", "source_hash"]
      }
    },
    "query_terms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tenant_id": { "type": "string" },
    "min_distinct_matches": { "type": "integer" },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": ["string", "integer"] },
          "text": { "type": "string" },
          "tenant_id": { "type": "string" },
          "source_hash": { "type": "string" }
        },
        "required": ["id", "text", "tenant_id", "source_hash"]
      }
    }
  },
  "required": ["mode"]
}
