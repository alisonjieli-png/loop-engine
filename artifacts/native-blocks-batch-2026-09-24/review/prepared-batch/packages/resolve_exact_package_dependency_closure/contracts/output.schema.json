{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package Dependency Resolution Result",
  "oneOf": [
    {
      "title": "Success",
      "type": "object",
      "properties": {
        "status": { "const": "success" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "rev": { "type": "string" },
              "digest": { "type": "string" }
            },
            "required": ["id", "rev", "digest"]
          }
        },
        "total_size_bytes": { "type": "integer" },
        "effects": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["status", "dependencies", "total_size_bytes", "effects"]
    },
    {
      "title": "Refusal",
      "type": "object",
      "properties": {
        "status": { "const": "refused" },
        "error_code": { "type": "string" }
      },
      "required": ["status", "error_code"]
    }
  ]
}
