{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package Dependency Request",
  "type": "object",
  "properties": {
    "available_packages": {
      "type": "object",
      "description": "Map of 'id@rev' to package metadata.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "digest": { "type": "string" },
          "size": { "type": "integer" },
          "effects": { "type": "array", "items": { "type": "string" } },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "rev": { "type": "string" },
                "digest": { "type": "string" }
              },
              "required": ["id", "rev", "digest"]
            }
          }
        },
        "required": ["digest"]
      }
    },
    "requested_identities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "rev": { "type": "string" },
          "digest": { "type": "string" }
        },
        "required": ["id", "rev", "digest"]
      }
    }
  },
  "required": ["available_packages", "requested_identities"]
}
