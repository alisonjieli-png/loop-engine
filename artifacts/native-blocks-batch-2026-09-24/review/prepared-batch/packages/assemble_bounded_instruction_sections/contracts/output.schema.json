{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": { "const": "SUCCESS" },
        "selected_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "byte_range": {
                "type": "array",
                "items": { "type": "integer" },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": ["id", "byte_range"]
          }
        },
        "omitted_sections": { "type": "array", "items": { "type": "string" } },
        "total_units": { "type": "integer" },
        "assembled_text": { "type": "string" }
      },
      "required": ["status", "selected_sections", "omitted_sections", "total_units", "assembled_text"]
    },
    {
      "type": "object",
      "properties": {
        "status": { "const": "REFUSED" },
        "code": { "type": "string" }
      },
      "required": ["status", "code"]
    }
  ]
}
