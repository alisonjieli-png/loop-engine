{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "env_var_name": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "target_profile": {
      "type": "string",
      "enum": ["codex", "claude"]
    }
  },
  "required": ["server_id", "url", "env_var_name", "target_profile"],
  "additionalProperties": false
}
