{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency Resolution Result",
  "type": "object",
  "properties": {
    "status": { "enum": ["success", "refused"] },
    "resolved_dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "total_size_bytes": { "type": "integer" },
    "effects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error_code": { "type": "string" },
    "message": { "type": "string" }
  },
  "oneOf": [
    {
      "required": ["status", "resolved_dependencies", "total_size_bytes", "effects"]
    },
    {
      "required": ["status", "error_code", "message"]
    }
  ]
}
