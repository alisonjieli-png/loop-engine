{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandoffOutput",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/refusal" }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "properties": {
        "status": { "const": "success" },
        "briefing": {
          "type": "object",
          "properties": {
            "first_action": { "type": ["string", "null"] },
            "output_contract": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["first_action", "output_contract"]
        },
        "passive_state": {
          "type": "object",
          "properties": {
            "task_id": { "type": "string" },
            "attempt_id": { "type": "string" },
            "current_state": { "type": "string" },
            "external_effects": { "type": "object" }
          },
          "required": ["task_id", "attempt_id", "current_state", "external_effects"]
        }
      },
      "required": ["status", "briefing", "passive_state"]
    },
    "refusal": {
      "type": "object",
      "properties": {
        "status": { "const": "refused" },
        "code": { "type": "string" },
        "field": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["status", "code"]
    }
  }
}
