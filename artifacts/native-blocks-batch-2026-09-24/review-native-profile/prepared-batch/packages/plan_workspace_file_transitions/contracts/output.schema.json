{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": { "const": "success" },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "op": { "enum": ["create", "update", "noop", "delete", "conflict"] },
              "expected_digest": { "type": ["string", "null"] }
            },
            "required": ["path", "op", "expected_digest"]
          }
        }
      },
      "required": ["status", "transitions"]
    },
    {
      "type": "object",
      "properties": {
        "status": { "const": "refused" },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["status", "error"]
    }
  ]
}
