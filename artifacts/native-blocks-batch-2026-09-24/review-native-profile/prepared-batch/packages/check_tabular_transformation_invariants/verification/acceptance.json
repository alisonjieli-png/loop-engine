[
  {
    "name": "Valid transformation",
    "input_file": "examples/input.json",
    "expected_status": "success"
  },
  {
    "name": "Type mismatch: true vs 1",
    "input": {
      "before": [{"id": "1", "p": true}],
      "after": [{"id": "1", "p": 1}],
      "contract": {"id_field": "id", "preserved_fields": ["p"]}
    },
    "expected_status": "refused",
    "expected_code": "INVARIANT_VIOLATION"
  },
  {
    "name": "Sum mismatch",
    "input": {
      "before": [{"id": "1", "v": 10}, {"id": "2", "v": 10}],
      "after": [{"id": "1", "v": 10}, {"id": "2", "v": 11}],
      "contract": {"id_field": "id", "integer_total_fields": ["v"]}
    },
    "expected_status": "refused",
    "expected_code": "TOTAL_SUM_MISMATCH"
  },
  {
    "name": "Unauthorized mutation",
    "input": {
      "before": [{"id": "1", "x": "a"}],
      "after": [{"id": "1", "x": "b"}],
      "contract": {"id_field": "id", "allowed_changed_fields": []}
    },
    "expected_status": "refused",
    "expected_code": "INVARIANT_VIOLATION"
  },
  {
    "name": "Non-integer in total field",
    "input": {
      "before": [{"id": "1", "v": true}],
      "after": [{"id": "1", "v": true}],
      "contract": {"id_field": "id", "integer_total_fields": ["v"]}
    },
    "expected_status": "refused",
    "expected_code": "NON_INTEGER_VALUE"
  }
]
