    "first_action": "Run python3 -I -B .baltor/unattended-git-rules/scripts/git_ticket_check.py begin --ticket KEY with the real ticket key before changing anything, and read its JSON answer.",
    "done_when": [
      "verify --ticket KEY --require-commit answers \"result\": \"pass\" after exactly one local commit that names the ticket key.",
      "For a ticket that needs no change, verify --ticket KEY --no-change answers \"result\": \"pass\" with no commit and no tracked change."
    ],
    "stop_and_report_when": [
      "The check answers fail or refused; the whole answer is saved in .baltor/state/unattended-run-rules/KEY-git.json and the ticket is recorded as blocked with that file.",
      "The ticket needs a forbidden git operation or a conflict appears."
    ],
