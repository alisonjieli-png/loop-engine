    "render_placeholders": {
      "BUILD_COMMAND": "One simple command, run from the workspace root, that builds the project, or the word none. No shell operators and no install or fetch step.",
      "TEST_COMMAND": "One simple command, run from the workspace root, that runs the whole test suite. Every step needs it, so it is never none.",
      "TEST_ONE_FILE_COMMAND": "One simple command that runs the tests of one file, with the literal word FILE once where the test file path goes, or the word none.",
      "LINT_COMMAND": "One simple lint command run from the workspace root, or the word none.",
      "FORMAT_COMMAND": "One simple format command with the literal word FILES once where the changed file paths go, or the word none when the formatter cannot take file paths.",
      "SOURCE_DIRS": "Comma-separated workspace-relative folders that hold the source code, for example src/, written with path characters only.",
      "TEST_DIRS": "Comma-separated workspace-relative folders that hold the tests, for example tests/, written with path characters only.",
      "PROTECTED_PATHS": "Comma-separated workspace-relative paths or glob patterns the step must never edit, such as lock files, generated code, vendored folders and applied migrations, written with path characters only, or the word none."
    },
    "tests": {
      "command": [
        "python3",
        "-I",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "minimum_python": "3.10"
    },
    "hooks": [],
    "servers": [],
    "first_action": "Before the first edit, run the tests for the file you will change with the rendered one-file command, or All tests when it is none, and write down which tests fail.",
    "done_when": [
      "After the last edit, Format ran on the changed files, then Lint, Build and All tests in that order; each is reported with its exit code, a command written as none is reported as skipped, and every test that fails now but passed before is named.",
      "No protected path and no file the step did not change was modified, and no command or test configuration was changed to get a pass."
    ],
    "stop_and_report_when": [
      "All tests is none.",
      "A value still shows an unfilled double-brace marker.",
      "A command cannot start at all, for example command not found.",
      "Format changed a protected path or a file the step did not change.",
      "The work needs an edit to a protected path."
    ],
