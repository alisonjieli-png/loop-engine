{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Values the host renders into the cleaning application step",
 "description": "Every value is placed inside a shell command, so paths use only safe characters.",
 "type": "object",
 "required": ["table_path", "plan_path", "output_dir"],
 "additionalProperties": false,
 "properties": {
  "table_path": {"$ref": "#/$defs/relative_path"},
  "plan_path": {"$ref": "#/$defs/relative_path"},
  "output_dir": {"$ref": "#/$defs/relative_path"}
 },
 "$defs": {
  "relative_path": {
   "type": "string",
   "maxLength": 200,
   "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
  }
 }
}
