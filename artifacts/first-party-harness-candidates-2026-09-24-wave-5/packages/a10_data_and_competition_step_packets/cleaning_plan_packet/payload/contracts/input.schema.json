{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Values the host renders into the cleaning plan step",
 "description": "Every value is placed inside a shell command, so paths and names use only safe characters.",
 "type": "object",
 "required": ["table_path", "output_dir", "max_rows", "delimiter"],
 "additionalProperties": false,
 "properties": {
  "table_path": {"$ref": "#/$defs/relative_path"},
  "output_dir": {"$ref": "#/$defs/relative_path"},
  "max_rows": {"type": "integer", "minimum": 1, "maximum": 5000000},
  "delimiter": {"enum": ["comma", "semicolon", "tab", "pipe"]}
 },
 "$defs": {
  "relative_path": {
   "type": "string",
   "maxLength": 200,
   "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
  }
 }
}
