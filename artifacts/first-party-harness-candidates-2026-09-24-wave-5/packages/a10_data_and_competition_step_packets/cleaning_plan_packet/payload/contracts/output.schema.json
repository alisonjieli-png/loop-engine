{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "cleaning_plan/v1 as the cleaning plan step hands it over",
 "description": "Rules are proposed or dropped. Evidence is counted by the step script, never typed.",
 "type": "object",
 "required": ["record_type", "table", "profile", "rules", "questions"],
 "additionalProperties": false,
 "properties": {
  "record_type": {"const": "cleaning_plan/v1"},
  "table": {
   "type": "object",
   "required": ["path", "sha256", "delimiter", "columns", "rows_profiled", "row_cap", "row_cap_reached"],
   "additionalProperties": false,
   "properties": {
    "path": {"type": "string", "minLength": 1},
    "sha256": {"$ref": "#/$defs/digest"},
    "delimiter": {"enum": ["comma", "semicolon", "tab", "pipe"]},
    "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rows_profiled": {"type": "integer", "minimum": 1},
    "row_cap": {"type": "integer", "minimum": 1},
    "row_cap_reached": {"type": "boolean"}
   }
  },
  "profile": {
   "type": "object",
   "required": ["path", "sha256"],
   "additionalProperties": false,
   "properties": {
    "path": {"type": "string", "minLength": 1},
    "sha256": {"$ref": "#/$defs/digest"}
   }
  },
  "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
  "questions": {"type": "array", "items": {"type": "string", "minLength": 5}}
 },
 "$defs": {
  "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
  "rule": {
   "type": "object",
   "required": ["rule_id", "column", "operation", "parameters", "status", "reason", "evidence"],
   "additionalProperties": false,
   "properties": {
    "rule_id": {"type": "string", "pattern": "^r[0-9]{1,4}$"},
    "column": {"type": "string", "minLength": 1},
    "operation": {"enum": ["trim_whitespace", "missing_tokens_to_empty", "map_values", "parse_number", "parse_date"]},
    "parameters": {"type": "object"},
    "status": {"enum": ["proposed", "dropped"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"$ref": "#/$defs/evidence"}
   }
  },
  "evidence": {
   "type": "object",
   "required": ["cells_considered", "would_change", "would_hold", "change_examples", "hold_examples"],
   "additionalProperties": false,
   "properties": {
    "cells_considered": {"type": "integer", "minimum": 0},
    "would_change": {"type": "integer", "minimum": 0},
    "would_hold": {"type": "integer", "minimum": 0},
    "change_examples": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/pair"}},
    "hold_examples": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/pair"}}
   }
  }
 }
}
