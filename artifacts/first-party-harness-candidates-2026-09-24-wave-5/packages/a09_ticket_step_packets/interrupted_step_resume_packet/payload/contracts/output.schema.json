{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "interrupted_step_resume_record/v1",
 "description": "The record the step writes to .baltor/resume-output/record.json. A record that matches this schema is not yet accepted; the host checks the evidence file and the outputs it names.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "record_type",
  "step_id",
  "verdict",
  "evidence_path",
  "differences",
  "continued_from",
  "outputs_written",
  "reason"
 ],
 "properties": {
  "record_type": {
   "const": "interrupted_step_resume_record/v1"
  },
  "step_id": {
   "$ref": "#/$defs/identifier"
  },
  "verdict": {
   "enum": [
    "resumed",
    "stopped",
    "drift",
    "not_resumable",
    "refused"
   ]
  },
  "evidence_path": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "$ref": "#/$defs/output_path"
    }
   ]
  },
  "differences": {
   "type": "array",
   "maxItems": 200,
   "items": {
    "$ref": "#/$defs/difference"
   }
  },
  "continued_from": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "minLength": 1,
     "maxLength": 1000,
     "pattern": "\\S"
    }
   ]
  },
  "outputs_written": {
   "type": "array",
   "maxItems": 100,
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/path"
   }
  },
  "reason": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "minLength": 1,
     "maxLength": 1200,
     "pattern": "\\S"
    }
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "required": [
     "verdict"
    ],
    "properties": {
     "verdict": {
      "const": "resumed"
     }
    }
   },
   "then": {
    "properties": {
     "evidence_path": {
      "$ref": "#/$defs/output_path"
     },
     "differences": {
      "maxItems": 0
     },
     "continued_from": {
      "type": "string"
     },
     "outputs_written": {
      "minItems": 1
     }
    }
   }
  },
  {
   "if": {
    "required": [
     "verdict"
    ],
    "properties": {
     "verdict": {
      "const": "stopped"
     }
    }
   },
   "then": {
    "properties": {
     "evidence_path": {
      "$ref": "#/$defs/output_path"
     },
     "differences": {
      "maxItems": 0
     },
     "continued_from": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    }
   }
  },
  {
   "if": {
    "required": [
     "verdict"
    ],
    "properties": {
     "verdict": {
      "const": "drift"
     }
    }
   },
   "then": {
    "properties": {
     "evidence_path": {
      "$ref": "#/$defs/output_path"
     },
     "differences": {
      "minItems": 1
     },
     "continued_from": {
      "type": "null"
     },
     "outputs_written": {
      "maxItems": 0
     },
     "reason": {
      "type": "string"
     }
    }
   }
  },
  {
   "if": {
    "required": [
     "verdict"
    ],
    "properties": {
     "verdict": {
      "const": "not_resumable"
     }
    }
   },
   "then": {
    "properties": {
     "evidence_path": {
      "$ref": "#/$defs/output_path"
     },
     "differences": {
      "maxItems": 0
     },
     "continued_from": {
      "type": "null"
     },
     "outputs_written": {
      "maxItems": 0
     },
     "reason": {
      "type": "string"
     }
    }
   }
  },
  {
   "if": {
    "required": [
     "verdict"
    ],
    "properties": {
     "verdict": {
      "const": "refused"
     }
    }
   },
   "then": {
    "properties": {
     "evidence_path": {
      "type": "null"
     },
     "differences": {
      "maxItems": 0
     },
     "continued_from": {
      "type": "null"
     },
     "outputs_written": {
      "maxItems": 0
     },
     "reason": {
      "type": "string"
     }
    }
   }
  }
 ],
 "$defs": {
  "identifier": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
  },
  "path": {
   "type": "string",
   "minLength": 1,
   "maxLength": 400,
   "pattern": "^[^/~][^\\\\]*$",
   "not": {
    "pattern": "(^|/)\\.\\.(/|$)"
   }
  },
  "difference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "path",
    "expected",
    "found"
   ],
   "properties": {
    "kind": {
     "enum": [
      "head_moved",
      "file_changed",
      "file_missing",
      "file_present_but_recorded_absent",
      "not_a_regular_file",
      "unrecorded_change",
      "host_file_changed",
      "host_file_missing"
     ]
    },
    "path": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/path"
      }
     ]
    },
    "expected": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "maxLength": 200
      }
     ]
    },
    "found": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "maxLength": 200
      }
     ]
    }
   }
  },
  "output_path": {
   "description": "A path inside .baltor/ and outside .baltor/step/, the interrupted step's packet folder.",
   "allOf": [
    {
     "$ref": "#/$defs/path"
    },
    {
     "pattern": "^\\.baltor/"
    },
    {
     "not": {
      "pattern": "^\\.baltor/step(/|$)"
     }
    }
   ]
  }
 }
}
