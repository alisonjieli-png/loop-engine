{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "night_step_handoff/v1",
 "description": "What one step of an unattended night leaves for the next reader: its status, its claims with evidence, its blocker, and for unfinished work the action to take first. Paths are relative to the workspace root. For a step that the host stopped, the host writes this record right after the stop with the write command of handoff_drift.py in the interrupted step resume packet.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "record_type",
  "step_id",
  "ticket_id",
  "status",
  "written_at",
  "revision",
  "files",
  "claims",
  "blocker",
  "first_action",
  "remaining_actions",
  "done_when"
 ],
 "properties": {
  "record_type": {
   "const": "night_step_handoff/v1"
  },
  "step_id": {
   "$ref": "#/$defs/identifier"
  },
  "ticket_id": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "$ref": "#/$defs/identifier"
    }
   ]
  },
  "status": {
   "enum": [
    "complete",
    "blocked",
    "unfinished"
   ]
  },
  "written_at": {
   "type": "string",
   "maxLength": 40,
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
  },
  "revision": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
   ],
   "description": "The commit HEAD pointed at when the handoff was written, or null outside git."
  },
  "files": {
   "type": "array",
   "maxItems": 500,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "sha256"
    ],
    "properties": {
     "path": {
      "$ref": "#/$defs/path"
     },
     "sha256": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      ]
     }
    }
   },
   "description": "Every path that differed from revision when the handoff was written: changed, added, deleted and untracked files, including those an earlier step of the same ticket left uncommitted. The host's files under .baltor/, the host placed paths and byte caches are left out. sha256 is null for a deleted file."
  },
  "claims": {
   "type": "array",
   "maxItems": 50,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "evidence"
    ],
    "properties": {
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
     },
     "evidence": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "$ref": "#/$defs/path"
       }
      ]
     }
    }
   }
  },
  "blocker": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "reason",
      "question",
      "evidence"
     ],
     "properties": {
      "reason": {
       "type": "string",
       "minLength": 1,
       "maxLength": 500,
       "pattern": "\\S"
      },
      "question": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "type": "string",
         "minLength": 1,
         "maxLength": 500,
         "pattern": "\\S"
        }
       ]
      },
      "evidence": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "$ref": "#/$defs/path"
        }
       ]
      }
     }
    }
   ]
  },
  "first_action": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "minLength": 1,
     "maxLength": 1000,
     "pattern": "\\S"
    }
   ],
   "description": "For unfinished work, the action to take first. A resume check accepts it only when it quotes in backticks at least one command or path that the interrupted instructions show, and nothing else."
  },
  "remaining_actions": {
   "type": "array",
   "maxItems": 50,
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 1000,
    "pattern": "\\S"
   },
   "description": "Further actions in order, under the same rule as first_action."
  },
  "done_when": {
   "type": "array",
   "maxItems": 20,
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 500,
    "pattern": "\\S"
   }
  }
 },
 "allOf": [
  {
   "if": {
    "required": [
     "status"
    ],
    "properties": {
     "status": {
      "const": "blocked"
     }
    }
   },
   "then": {
    "properties": {
     "blocker": {
      "type": "object"
     }
    }
   }
  },
  {
   "if": {
    "required": [
     "status"
    ],
    "properties": {
     "status": {
      "const": "unfinished"
     }
    }
   },
   "then": {
    "properties": {
     "first_action": {
      "type": "string"
     }
    }
   }
  }
 ],
 "$defs": {
  "identifier": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
  },
  "path": {
   "type": "string",
   "minLength": 1,
   "maxLength": 400,
   "pattern": "^[^/~][^\\\\]*$",
   "not": {
    "pattern": "(^|/)\\.\\.(/|$)"
   }
  }
 }
}
