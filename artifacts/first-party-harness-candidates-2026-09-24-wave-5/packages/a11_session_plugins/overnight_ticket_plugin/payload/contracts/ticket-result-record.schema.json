{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ticket result record written by close_ticket.py",
  "description": "One file per closed ticket at .baltor/state/overnight-ticket-plugin/results/<ticket id>.json, created once and never replaced. queue_sha256 binds the record to the exact queue bytes it was written for.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "queue_sha256", "ticket_id", "position", "outcome", "summary", "evidence", "changed_files", "handoff", "closed_at"],
  "properties": {
    "record_type": {"const": "overnight_ticket_result/v1"},
    "queue_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ticket_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "position": {"type": "integer", "minimum": 1},
    "outcome": {"enum": ["fixed", "blocked", "skipped", "needs_review"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 400},
    "evidence": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "observed"],
        "properties": {
          "command": {"type": "string", "minLength": 1, "maxLength": 300},
          "exit_code": {"type": "integer", "minimum": -255, "maximum": 255},
          "observed": {"type": "string", "maxLength": 300}
        }
      }
    },
    "changed_files": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "handoff": {"type": "string", "minLength": 1, "maxLength": 600},
    "closed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
