    "servers": [],
    "first_action": "Read the competition summary that the session start hook added; it names the metric, folds, data version, deadline and daily submission limit.",
    "done_when": [
      "Every finished experiment has a note recorded by experiment_note.py.",
      "Any submission handed to the host has a ready_for_host_upload decision from the gate."
    ],
    "stop_and_report_when": [
      "The brief is missing or cannot be read.",
      "A note is refused because its metric, fold count or data version differs from the brief.",
      "The gate decides hold."
    ],
