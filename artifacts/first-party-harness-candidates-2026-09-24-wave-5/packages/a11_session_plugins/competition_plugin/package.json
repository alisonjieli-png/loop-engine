        ],
        "environment": {
          "CLAUDE_PROJECT_DIR": "{WORKSPACE}/examples/competition"
        },
        "samples": [
          {
            "input": "examples/claude_code-sessionstart-startup.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "\"hookEventName\": \"SessionStart\"",
              "Metric: rmse, lower is better",
              "never upload yourself"
            ]
          },
          {
            "input": "examples/claude_code-sessionstart-malformed.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "{}"
            ]
          }
        ]
      },
      {
        "harness": "gemini_cli",
        "event": "SessionStart",
        "script": "scripts/brief_summary.py",
        "arguments": [
          "--harness",
          "gemini_cli"
        ],
        "environment": {
          "GEMINI_PROJECT_DIR": "{WORKSPACE}/examples/competition"
        },
        "samples": [
          {
            "input": "examples/gemini_cli-sessionstart-startup.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "\"additionalContext\"",
              "Validation: group_kfold, 5 folds, groups by store_id"
