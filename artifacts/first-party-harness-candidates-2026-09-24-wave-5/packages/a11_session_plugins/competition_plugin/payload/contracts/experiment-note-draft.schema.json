{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft sent to experiment_note.py on standard input",
  "description": "The script adds record_type, direction, fold_count, cv_mean, cv_std, the submission digest and recorded_at. A draft that carries its own mean is refused.",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "hypothesis", "change", "metric", "fold_scores", "seed", "data_version", "code_revision"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 300},
    "change": {"type": "string", "minLength": 1, "maxLength": 300},
    "metric": {"type": "string", "minLength": 1, "maxLength": 40},
    "fold_scores": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "number"}},
    "seed": {"type": "integer"},
    "data_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "code_revision": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "submission_file": {"type": "string", "minLength": 1, "maxLength": 200},
    "outcome_note": {"type": "string", "maxLength": 300}
  }
}
