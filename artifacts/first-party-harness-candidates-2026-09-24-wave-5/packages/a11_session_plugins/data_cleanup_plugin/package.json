    "first_action": "Run the cleanup status command once before cleaning, to confirm the pairs file is readable and every source exists.",
    "done_when": [
      "The cleanup status command reports status match for every declared pair.",
      "No count check message reported a problem after the last write."
    ],
    "stop_and_report_when": [
      "The pairs file is missing or unreadable.",
      "A source file was written or is missing.",
      "A mismatch could pass only by editing the pairs file."
    ],
