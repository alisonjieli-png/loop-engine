          "claude_code"
        ],
        "environment": {
          "CLAUDE_PROJECT_DIR": "{WORKSPACE}/examples/cleanup"
        },
        "samples": [
          {
            "input": "examples/claude_code-posttooluse-clean-copy.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "\"hookEventName\": \"PostToolUse\"",
              "Cleanup count check passed"
            ]
          },
          {
            "input": "examples/claude_code-posttooluse-dropped-row.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "\"decision\": \"block\"",
              "rows lost: 4 rows, source has 5"
            ]
          },
          {
            "input": "examples/claude_code-posttooluse-malformed.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "{}"
            ]
          }
        ]
      },
      {
        "harness": "gemini_cli",
        "event": "AfterTool",
        "script": "scripts/check_cleaned_counts.py",
        "arguments": [
          "--harness",
          "gemini_cli"
        ],
        "environment": {
          "GEMINI_PROJECT_DIR": "{WORKSPACE}/examples/cleanup"
        },
        "samples": [
          {
            "input": "examples/gemini_cli-aftertool-clean-copy.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "\"additionalContext\"",
              "Cleanup count check passed"
            ]
          },
          {
            "input": "examples/gemini_cli-aftertool-dropped-row.json",
            "expect_exit": 0,
            "expect_stdout_json": true,
            "expect_stdout_contains": [
              "\"additionalContext\"",
