{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cleaned copies and their sources, read by the data cleanup plugin",
  "description": "Written by the host or the planning step before cleaning starts. It stays unchanged for the whole step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "pairs"],
  "properties": {
    "record_type": {"const": "cleanup_pairs/v1"},
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/pair"}
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "cleaned"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 200},
        "cleaned": {"type": "string", "minLength": 1, "maxLength": 200},
        "delimiter": {"enum": [",", ";", "\t", "|"]},
        "renamed_columns": {
          "type": "object",
          "maxProperties": 200,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "max_dropped_rows": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    }
  }
}
