{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/.baltor/guard-shell-command-allowlist/hooks/guard_shell_commands.py\" --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
