{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/.baltor/require-tests-before-stop/hooks/require_tests_before_stop.py\" --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/.baltor/require-tests-before-stop/hooks/require_tests_before_stop.py\" --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/.baltor/require-tests-before-stop/hooks/require_tests_before_stop.py\" --harness claude_code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
