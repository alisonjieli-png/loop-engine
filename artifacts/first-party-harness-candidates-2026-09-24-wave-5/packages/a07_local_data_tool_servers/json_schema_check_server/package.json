    "first_action": "Before handing a JSON output on, call the check_json_schema tool with document_path set to the output file and schema_path set to its contract schema, then read valid and violations.",
    "done_when": [
      "check_json_schema answers valid true with an empty unchecked list for every JSON output the step hands on.",
      "No schema file was edited to make a document pass."
    ],
    "stop_and_report_when": [
      "The schema itself is refused, for example for an unknown keyword or an unsupported $schema value.",
      "The same violation remains after two fixes, or the check stops at the time limit.",
