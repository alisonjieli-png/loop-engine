    "hooks": [],
    "servers": [
      {
        "name": "pattern_tester_server",
        "script": "server/pattern_tester_server.py",
        "arguments": [
          "--root",
          "examples"
        ],
        "tools": [
          "test_pattern"
        ],
        "protocol_versions": [
          "2025-11-25",
          "2025-06-18",
          "2025-03-26"
        ],
        "sample_call": {
          "tool": "test_pattern",
          "arguments": {
            "pattern": "(?P<year>[0-9]{4})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2})",
            "should_match": [
              "2025-03-01",
              "1999-12-31"
            ],
            "should_not_match": [
              "2025-3-1",
              "03/04/2025",
              "2025-03-01 extra",
              " 2025-03-01"
            ],
            "replacement": "\\g<day>.\\g<month>.\\g<year>"
          },
          "expect_is_error": false
        }
      }
    ],
    "first_action": "Before a cleaning rule uses a regular expression, call the test_pattern tool with the pattern, should_match texts and should_not_match texts taken from the real data.",
    "done_when": [
      "test_pattern answers passed true for the final pattern.",
      "Each kind of value the rule must reject appears in should_not_match."
    ],
    "stop_and_report_when": [
      "The same refusal (a compile error, a missing replacement group or the time limit) returns after the pattern was changed.",
      "No listed tool name ends in test_pattern; run the package tests. If they pass, the harness did not start a working server: report that. Otherwise report their last line."
    ],
