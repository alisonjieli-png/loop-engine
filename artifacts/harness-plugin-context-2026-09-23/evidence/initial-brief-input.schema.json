{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Focused step brief candidate input",
  "description": "Structure only. Names are logical labels, not paths. An authority reference is not a permission grant. Additional runtime checks require unique check IDs and a check for every declared output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "objective",
    "inputs",
    "outputs",
    "constraints",
    "out_of_scope",
    "unresolved_questions",
    "requested_effects",
    "authority_reference",
    "acceptance_checks"
  ],
  "properties": {
    "record_type": {
      "const": "baltor_step_brief/v1"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\ud800-\\udfff]"
          }
        }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S",
        "allOf": [
          {
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\ud800-\\udfff]"
            }
          }
        ]
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S",
        "allOf": [
          {
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\ud800-\\udfff]"
            }
          }
        ]
      }
    },
    "unresolved_questions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S",
        "allOf": [
          {
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\ud800-\\udfff]"
            }
          }
        ]
      }
    },
    "requested_effects": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_selected_inputs",
          "write_declared_outputs",
          "shell",
          "network",
          "model"
        ]
      }
    },
    "authority_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\ud800-\\udfff]"
          }
        }
      ]
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "output",
          "assertion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "output": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "assertion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S",
            "allOf": [
              {
                "not": {
                  "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\ud800-\\udfff]"
                }
              }
            ]
          }
        }
      }
    }
  }
}
