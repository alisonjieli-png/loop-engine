{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
