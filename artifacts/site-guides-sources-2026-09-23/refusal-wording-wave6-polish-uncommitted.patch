+def self_test() -> dict:
+    """Check that every way `report` refuses also says what to do next."""
+    import re
+    source = __loader__.get_source(__name__) if hasattr(__loader__, "get_source") else ""
+    emitted = set(re.findall(r'"error_code": "([A-Z_]+)"', source))
+    tests = [{"test": "every_report_refusal_names_what_to_do_next",
+              "passed": bool(emitted) and emitted == set(REPORT_NEXT_ACTIONS)
+                        and all(len(value.split()) >= 5 and value.endswith(".")
+                                for value in REPORT_NEXT_ACTIONS.values()),
+              "detail": "refusal codes read from this module's own source"}]
+    # A next action that only repeats the command that just refused sends the
+    # reader round the same loop.
+    tests.append({"test": "a_report_next_action_does_not_send_the_reader_back_to_the_same_command",
+                  "passed": all("loop-engine report" not in value
+                                for value in REPORT_NEXT_ACTIONS.values()),
+                  "detail": "refusal wording only"})
+    return {"tests": tests}
+
+
+__all__ = ("run_history_command", "REPORT_NEXT_ACTIONS", "self_test")
