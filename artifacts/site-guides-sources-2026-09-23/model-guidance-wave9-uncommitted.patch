diff --git a/src/loop_engine/core/service_runtime/model_guidance_checks.py b/src/loop_engine/core/service_runtime/model_guidance_checks.py
new file mode 100644
index 00000000..90267626
--- /dev/null
+++ b/src/loop_engine/core/service_runtime/model_guidance_checks.py
@@ -0,0 +1,248 @@
+"""Structural checks for the three pages that answer "which model for this step".
+
+The pages recommend settings and name third-party models, so a page that has
+drifted from the source is worse than no page: a reader copies a field that no
+longer exists and gets a refusal they cannot explain. These checks read the
+packaged pages and hold them against the source rather than against wording
+kept here.
+
+Four guards do the real work.
+
+    Every setting a page prints is fed through the real settings loader, so a
+    renamed or removed field fails here before a reader meets it.
+    Every source name a page prints is matched against a vocabulary built from
+    the route registry, the purposes, the wire formats, the cost record and the
+    typed decision contract.
+    Every measured figure a page quotes is matched against the dated evidence
+    record it came from.
+    Every internal address a page points at is one the service serves, and no
+    page names an internal runtime word.
+
+Each guard is followed by a control that removes the behaviour from a copy of
+the page text held in memory and requires the guard's own predicate to fail.
+No source file is edited and no provider is contacted.
+"""
+from __future__ import annotations
+
+from dataclasses import fields
+import hashlib
+import re
+
+from .web_routes import WEB_ASSETS
+
+#: The three addresses and the packaged file each one answers with.
+GUIDANCE_PAGES = ("/models", "/models/building", "/models/deciding")
+#: The two pages that carry a full recommendation. The third sends a reader to one of them.
+DEEP_PAGES = GUIDANCE_PAGES[1:]
+#: The plain-word rule the public pages follow. `tools/check_hosted_website.mjs`
+#: and `tools/check_service_workspace.mjs` carry the same expression.
+INTERNAL_TERMS = re.compile(r"\bLoop(?:s|[ -]node| Engine)?\b|runtime classification|role profile", re.I)
+#: Addresses a page may point at that are not packaged files.
+LIVE_PREFIXES = ("/api/", "/.well-known/")
+#: Figures the pages quote from `docs/evidence/local-model-call-2026-09-21.md`.
+#: A page may not print a measured figure that record does not contain.
+MEASURED_FIGURES = ("RTX 3060", "12288", "Q4_K_M", "6659", "32768", "4.7 GB",
+                    "87.28", "0.71", "0.78", "64 prompt tokens", "qwen2.5-coder:7b")
+#: Where that record lives, relative to the repository root. It is documentation
+#: rather than packaged source, so an installed copy may not carry it.
+EVIDENCE_RECORD = "docs/evidence/local-model-call-2026-09-21.md"
+#: The one settings key that is not also a field name on the record it builds.
+SETTINGS_KEY_ALIASES = {"id": "provider_id"}
+
+
+def page_text(path: str) -> str:
+    """The packaged bytes of one guidance page, as text."""
+    from importlib.resources import files
+    name, _media_type = WEB_ASSETS[path]
+    return files("loop_engine").joinpath("core", "service_runtime", "web_assets", name).read_text("utf-8")
+
+
+def unserved_addresses(page: str) -> list:
+    """Internal addresses on a page that the service does not serve."""
+    linked = {value for value in re.findall(r'(?:href|src)="(/[^"#?]*)"', page)}
+    return sorted(value for value in linked
+                  if value not in WEB_ASSETS and value != "/mcp"
+                  and not any(value.startswith(prefix) for prefix in LIVE_PREFIXES))
+
+
+def settings_blocks(page: str) -> list:
+    """Every settings example a page prints, as YAML text."""
+    import html
+    return [html.unescape(block) for block in re.findall(r"<pre><code>(.*?)</code></pre>", page, re.S)]
+
+
+def printed_names(page: str) -> set:
+    """The source names a page prints in code style: a field, a purpose, a route or a model."""
+    marked = set(re.findall(r"<code>([^<]+)</code>", page))
+    return {name for name in marked
+            if re.fullmatch(r"[a-z][a-z0-9_]*(?:[._/:-][a-z0-9_.+]+)*", name)
+            and ("_" in name or "." in name or "/" in name or ":" in name)}
+
+
+def source_vocabulary() -> set:
+    """Every name the pages are allowed to print, built from the source itself."""
+    from ..custom_endpoint import THINK_MODES, WIRE_FORMATS
+    from ..model_routes import PURPOSES, RouteRegistry
+    from ..operation_cost_records import COST_OUTCOMES, PHASES, OperationCostRecord
+    from ..response_contracts import TYPED_DECISION
+    from ..runtime_settings import (
+        EscalationSettings, ModelSettings, ModelTier, ProviderSettings,
+    )
+    from ..typed_decision import CONTRACT_FIELDS, ROW_FIELDS, TypedDecisionSuiteReport
+    from ...loop.recursive_loop import MODEL_THINKING_POWER_LEVELS
+    known = set(PURPOSES) | set(WIRE_FORMATS) | set(THINK_MODES) | set(PHASES) | set(COST_OUTCOMES)
+    known |= set(CONTRACT_FIELDS) | set(ROW_FIELDS) | set(MODEL_THINKING_POWER_LEVELS) | {TYPED_DECISION}
+    for record in (ProviderSettings, ModelSettings, ModelTier, EscalationSettings,
+                   OperationCostRecord, TypedDecisionSuiteReport):
+        known |= {item.name for item in fields(record)}
+    known |= {name for name, value in vars(TypedDecisionSuiteReport).items() if isinstance(value, property)}
+    known |= set(SETTINGS_KEY_ALIASES)
+    for route in RouteRegistry().all():
+        known |= {route.name, route.model, route.provider}
+    # The settings file names its own sections, and a custom provider is reached
+    # by the route name its identifier builds.
+    known |= {"models", "providers", "tiers", "escalation", "loop-engine.settings.yaml"}
+    known |= {"custom." + name for name in ("local_coder", "local_decider")}
+    return known
+
+
+def loaded_settings(block: str):
+    """One settings example parsed and accepted by the real loader, or a refusal."""
+    import yaml
+    from ..settings_loader import runtime_settings_from_mapping
+    return runtime_settings_from_mapping({"version": 1, **yaml.safe_load(block)})
+
+
+def evidence_figures(root=None) -> "str | None":
+    """The dated local model record, when this copy carries documentation."""
+    from pathlib import Path
+    base = Path(root) if root is not None else Path(__file__).resolve().parents[4]
+    record = base / EVIDENCE_RECORD
+    return record.read_text("utf-8") if record.is_file() else None
+
+
+def run_checks(check, root=None) -> None:
+    """Every guard, each followed by the control that removes its behaviour."""
+    pages = {path: page_text(path) for path in GUIDANCE_PAGES}
+
+    # 1. Each address answers with its own page, and the stylesheet they share
+    # is served too. A page that is served by accident, because another address
+    # happens to answer, would pass every wording check below while a reader
+    # saw the wrong thing.
+    digests = {path: hashlib.sha256(text.encode()).hexdigest() for path, text in pages.items()}
+    check("every_model_guidance_address_serves_its_own_page",
+          len(set(digests.values())) == len(GUIDANCE_PAGES)
+          and all(WEB_ASSETS[path][1] == "text/html" for path in GUIDANCE_PAGES)
+          and WEB_ASSETS["/assets/model-guidance.css"] == ("model-guidance.css", "text/css")
+          and all("{{SERVICE_NAME}}" in text for text in pages.values()))
+    # The known-wrong case: the table is exact, so a neighbouring address is not
+    # answered by a page that happens to sit near it.
+    check("an_address_beside_the_model_guidance_pages_is_not_served",
+          not any(candidate in WEB_ASSETS for candidate in
+                  ("/models/", "/models/nothing", "/model", "/models/building/")))
+
+    # 2. Every internal address on a guidance page is one the service serves.
+    check("every_internal_address_on_a_model_guidance_page_is_served",
+          not any(unserved_addresses(text) for text in pages.values()))
+    broken = pages[GUIDANCE_PAGES[0]].replace('href="/docs"', 'href="/setup-guide"')
+    check("the_unserved_address_scan_rejects_a_page_that_points_nowhere",
+          unserved_addresses(broken) == ["/setup-guide"])
+
+    # 3. A guidance page is a page a customer reads, so it follows the same
+    # plain-word rule as the homepage and the shared footer.
+    check("the_model_guidance_pages_name_no_internal_runtime_word",
+          not any(INTERNAL_TERMS.search(text) for text in pages.values()))
+    check("the_plain_word_scan_rejects_a_page_that_names_the_runtime",
+          all(INTERNAL_TERMS.search(pages[GUIDANCE_PAGES[0]] + claim) for claim in
+              ("<p>Built on Loop Engine.</p>", "<p>Every step is a Loop node.</p>",
+               "<p>See the role profile.</p>", "<p>Read the runtime classification.</p>")))
+
+    # 4. The two kinds of work are separated and reachable from each other. A
+    # reader who lands on either deep page must be able to find the other.
+    entry = pages[GUIDANCE_PAGES[0]]
+    kinds = set(re.findall(r'data-work-kind="([a-z]+)"', entry))
+    check("the_entry_page_separates_the_two_kinds_of_work_and_sends_a_reader_to_each",
+          kinds == {"building", "deciding"}
+          and all(('href="%s"' % path) in entry for path in DEEP_PAGES)
+          and all(('href="%s"' % GUIDANCE_PAGES[0]) in pages[path] for path in DEEP_PAGES)
+          and all(('href="%s"' % other) in pages[path]
+                  for path in DEEP_PAGES for other in DEEP_PAGES if other != path))
+    check("the_two_kinds_scan_rejects_an_entry_page_that_names_only_one",
+          set(re.findall(r'data-work-kind="([a-z]+)"',
+                         re.sub(r'data-work-kind="deciding"', 'data-x=""', entry))) != {"building", "deciding"})
+
+    # 5. Each deep page answers the five questions a reader arrived with, and
+    # ends by saying what nobody has measured. The last one is the easiest to
+    # quietly drop and the most important to keep.
+    required = ("what-it-is", "local", "hosted", "working", "settings")
+    check("each_deep_page_answers_what_it_is_what_to_run_how_to_tell_and_what_it_costs",
+          all(all(('id="%s"' % section) in pages[path] for section in required) for path in DEEP_PAGES))
+    check("each_deep_page_says_what_nobody_has_measured_and_claims_no_saving",
+          all('data-unmeasured=' in pages[path] and "No saving is claimed" in pages[path]
+              and "nobody has measured" in pages[path].lower() for path in DEEP_PAGES))
+    stripped = re.sub(r'<div class="unmeasured".*?</div>', "", pages[DEEP_PAGES[0]], flags=re.S)
+    check("the_unmeasured_scan_rejects_a_page_that_dropped_that_paragraph",
+          "data-unmeasured=" not in stripped and "No saving is claimed" not in stripped)
+
+    # 6. Every setting a page prints is accepted by the real settings loader. A
+    # renamed or removed field fails here rather than in a reader's terminal.
+    blocks = [block for path in DEEP_PAGES for block in settings_blocks(pages[path])]
+    accepted, refusals = [], []
+    for block in blocks:
+        try:
+            accepted.append(loaded_settings(block))
+        except Exception as error:
+            refusals.append("%s: %s" % (type(error).__name__, error))
+    check("every_setting_the_model_guidance_pages_print_is_accepted_by_the_settings_loader",
+          len(blocks) >= 3 and not refusals and len(accepted) == len(blocks))
+    # The control: the loader rejects an unknown field, so the guard above is
+    # proving acceptance and not merely that nothing raised.
+    from ..settings_loader import SettingsError
+    invented, unknown_field = [], blocks[0].replace("purposes:", "purpose_list:")
+    for broken_block in (unknown_field, blocks[0].replace("models:", "modles:")):
+        try:
+            loaded_settings(broken_block)
+        except SettingsError:
+            invented.append(True)
+    check("the_settings_loader_refuses_a_renamed_field_in_the_same_block",
+          invented == [True, True] and unknown_field != blocks[0])
+
+    # 7. Every source name the pages print exists. A route renamed in
+    # `model_routes.py` or a field renamed on a record breaks this.
+    vocabulary = source_vocabulary()
+    printed = {name for path in GUIDANCE_PAGES for name in printed_names(pages[path])}
+    # Model tags and file names a publisher owns are not this repository's
+    # vocabulary; they are held to the published card instead, and a route's own
+    # model name is already in the vocabulary.
+    external = {name for name in printed if ":" in name or name.endswith((".yaml", ".py", ".css", ".html"))}
+    unmatched = sorted((printed - external) - vocabulary)
+    check("every_route_purpose_and_record_name_the_pages_print_exists_in_the_source",
+          len(printed) >= 25 and not unmatched)
+    check("the_source_vocabulary_scan_rejects_an_invented_name",
+          sorted(printed_names(pages[DEEP_PAGES[0]].replace("<code>counted_generation</code>",
+                                                            "<code>counted_generaton</code>")) - vocabulary
+                 - external) == ["counted_generaton"])
+
+    # 8. Every measured figure the pages quote comes from the dated record. A
+    # figure that record does not contain is a number nobody measured.
+    quoting = [path for path in GUIDANCE_PAGES if "87.28" in pages[path]]
+    record = evidence_figures(root)
+    check("every_measured_figure_the_pages_quote_is_in_the_dated_evidence_record",
+          len(quoting) == len(DEEP_PAGES)
+          and all(figure in pages[path] for path in quoting for figure in MEASURED_FIGURES)
+          and (record is None or all(figure in record for figure in MEASURED_FIGURES)))
+    check("the_measured_figure_scan_rejects_a_figure_the_record_does_not_carry",
+          record is None or not all(figure in record for figure in (*MEASURED_FIGURES, "142 tokens each second")))
+
+
+def self_test() -> dict:
+    tests = []
+
+    def check(name, passed):
+        tests.append({"test": name, "passed": bool(passed),
+                      "detail": "packaged pages held against the source; no socket and no provider"})
+
+    run_checks(check)
+    passed = sum(row["passed"] for row in tests)
+    return {"record_type": "model_guidance_checks_self_test", "tests": tests,
+            "passed": passed, "total": len(tests), "all_passed": passed == len(tests)}
