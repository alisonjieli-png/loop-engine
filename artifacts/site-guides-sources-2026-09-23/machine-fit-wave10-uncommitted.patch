@@ -0,0 +1,632 @@
+"""What to run on this machine, split by the kind of work.
+
+`machine_reading` reads the machine. `local_fit` does the memory
+arithmetic. This module joins them and answers the reader's actual
+question, which is not "does this model fit" but "what should I run".
+
+It gives two answers, because they are two different problems:
+
+    BUILDING. Writing code, drafting a migration, producing a document.
+    The output is long and the output is the product. A bigger model and
+    fewer calls, and the context has to hold the material the step needs.
+
+    CLASSIFYING AND DECIDING. Is this relevant, does this satisfy the
+    contract, which of these five fits. The output is short and there are
+    many calls. A small model, resident, with room left over.
+
+Three decisions in here are judgement rather than measurement, and each
+says so in the record it produces:
+
+  * A RECOMMENDATION IS MADE AGAINST TOTAL MEMORY, NOT FREE MEMORY. What
+    is in use right now includes the model the reader is asking about: the
+    machine this was written on had a 12 GiB card with 1.3 GiB free
+    precisely because the model in question was already loaded on it. A
+    machine that is busy at the moment it is asked is not a machine that
+    cannot run the model. What is free right now is reported separately,
+    as its own fact, under `right_now`.
+
+  * THE RUNTIME RESERVE IS DECLARED, NOT MEASURED. See
+    DEFAULT_RUNTIME_RESERVE_BYTES for the figure and the observation behind
+    it. Raise it when a load fails close to the line.
+
+  * THE WANTED CONTEXT PER KIND OF WORK IS A DECLARED POLICY. See
+    WORK_KINDS. Both are inputs, and both appear in the record beside the
+    word `declared`.
+
+Nothing here contacts a provider, calls a model, or writes anything.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .local_fit import (GIB, FitError, LocalModel, MachineTier, fit,
+                        gibibytes, largest_context)
+
+RECORD_TYPE = "machine_fit_advice/v1"
+
+#: The inference runtime's own working space, beside the weights and the
+#: cache. Declared, because it depends on the runtime and on how many
+#: requests it serves at once, not on arithmetic anyone can redo.
+#:
+#: The figure: on the machine this was written on, the local server
+#: reported one model occupying 5,384,466,533 bytes whose weights file is
+#: 4,683,087,561 bytes and whose cache at the loaded context of 8192 tokens
+#: is 469,762,048 bytes. The runtime's own working space was therefore
+#: 231,616,924 bytes, about 221 MiB. One gibibyte is a round figure above
+#: that with room for a display and a second sequence. A runtime serving
+#: several requests at once keeps one cache for each, so raise this.
+DEFAULT_RUNTIME_RESERVE_BYTES = 1 * GIB
+
+#: The cache element assumed when nothing on the machine states one. Two
+#: bytes for each key and value element is the common default of every
+#: local runtime this repository talks to; an eight bit cache halves it and
+#: is an explicit runtime setting.
+ASSUMED_CACHE_ELEMENT = "f16"
+
+#: The arithmetic, written out, so a reader can redo it for a model this
+#: never named. Both the command and the served page print this line.
+BUDGET_FORMULA = (
+    "weights_file_bytes + 2 x layers x key_value_heads x head_dimension x "
+    "context_tokens x cache_element_bytes + runtime_reserve_bytes "
+    "<= usable_video_bytes")
+
+
+class AdviceError(ValueError):
+    """An input this module refuses rather than answers badly."""
+
+
+@dataclass(frozen=True)
+class WorkKind:
+    """One kind of work, and the shape of model it wants.
+
+    `wanted_context_tokens` and `prefer` are declared policy. They are the
+    two levers that make the two answers different, and both are inputs.
+    """
+
+    name: str
+    what_it_is: str
+    wanted_context_tokens: int
+    prefer: str
+    allow_split: bool
+    why_this_shape: str
+
+    def __post_init__(self) -> None:
+        if self.prefer not in ("largest", "smallest"):
+            raise AdviceError("prefer must be largest or smallest")
+        if (isinstance(self.wanted_context_tokens, bool)
+                or not isinstance(self.wanted_context_tokens, int)
+                or self.wanted_context_tokens < 1):
+            raise AdviceError("wanted_context_tokens must be a positive "
+                              "whole number")
+
+
+#: A long enough context to hold the file being changed, the file it calls
+#: and the instruction, and short enough to leave a 7 billion parameter
+#: model resident on a 12 GiB card. Declared, and an input.
+BUILDING_CONTEXT_TOKENS = 16384
+
+#: A short context, because the work is one question about one piece of
+#: material. Declared, and an input.
+DECIDING_CONTEXT_TOKENS = 4096
+
+BUILDING = WorkKind(
+    name="building",
+    what_it_is=("Writing code, drafting a migration, producing a document. "
+                "The output is long and the output is the product."),
+    wanted_context_tokens=BUILDING_CONTEXT_TOKENS,
+    prefer="largest",
+    allow_split=True,
+    why_this_shape=(
+        "A bigger model and fewer calls. The context has to hold the "
+        "material the step needs, so the largest model that stays resident "
+        "at the wanted context wins. A model that cannot reach that context "
+        "is still offered, with the context it can actually reach."))
+
+DECIDING = WorkKind(
+    name="classifying_and_deciding",
+    what_it_is=("Is this relevant, does this satisfy the contract, which of "
+                "these five fits. The output is short and there are many "
+                "calls."),
+    wanted_context_tokens=DECIDING_CONTEXT_TOKENS,
+    prefer="smallest",
+    allow_split=False,
+    why_this_shape=(
+        "A small model, resident, with room left over for the work that "
+        "asked the question. Many short calls pay the cost of a split "
+        "placement on every one of them, so a split placement is not "
+        "offered for this kind of work. Whether a model declines when it is "
+        "unsure is a property of the model and the prompt, not of this "
+        "machine, and this command does not measure it."))
+
+WORK_KINDS = (BUILDING, DECIDING)
+
+
+@dataclass(frozen=True)
+class Candidate:
+    """One model that could be recommended, and where it came from."""
+
+    model: LocalModel
+    origin: str
+    purposes: tuple = ()
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.model, LocalModel):
+            raise AdviceError("a candidate holds a LocalModel")
+        if not self.origin.strip():
+            raise AdviceError("a candidate names where it came from")
+
+
+def machine_tier(*, video_bytes: object, system_bytes: object,
+                 runtime_reserve_bytes: float = DEFAULT_RUNTIME_RESERVE_BYTES,
+                 name: str = "this machine") -> MachineTier:
+    """The machine as the arithmetic wants it, from total memory figures.
+
+    `video_bytes` may be None on a machine with no separate video memory.
+    That is not zero video memory pretending to be a reading: it means
+    every placement is decided against system memory, which is what a
+    machine with one shared pool actually does.
+    """
+    if system_bytes is None:
+        raise AdviceError(
+            "system memory was not read, so nothing can be recommended. Give "
+            "it by hand with --system-memory-gib")
+    return MachineTier(
+        name=name,
+        usable_video_bytes=0.0 if video_bytes is None else float(video_bytes),
+        usable_system_bytes=float(system_bytes),
+        runtime_reserve_bytes=float(runtime_reserve_bytes))
+
+
+def candidates_from_reading(reading, *, cache_element: str) -> tuple:
+    """Models the machine actually holds, and the ones set aside with why.
+
+    A model is set aside rather than quietly dropped, because "there is
+    nothing here for you" and "you have four models and none of them
+    published its key/value head count" are different situations and the
+    reader needs to know which one they are in.
+    """
+    usable, set_aside = [], []
+    for model in reading.local_models:
+        if not model.local:
+            set_aside.append({
+                "model": model.name,
+                "why": ("this server forwards it to another machine, so no "
+                        "amount of memory here decides whether it runs")})
+            continue
+        if model.purposes and "completion" not in model.purposes:
+            set_aside.append({
+                "model": model.name,
+                "why": ("the server declares this model for "
+                        + ", ".join(model.purposes)
+                        + ", not for producing text")})
+            continue
+        missing = [field for field, value in (
+            ("weights_file_bytes", model.weights_file_bytes),
+            ("layers", model.layers),
+            ("key_value_heads", model.key_value_heads),
+            ("head_dimension", model.head_dimension),
+            ("maximum_context_tokens", model.maximum_context_tokens))
+            if not value.was_read]
+        if missing:
+            set_aside.append({
+                "model": model.name,
+                "why": ("the server published no " + ", ".join(missing)
+                        + ", and this arithmetic will not substitute a "
+                          "figure for a field it did not read")})
+            continue
+        try:
+            built = LocalModel(
+                name=model.name, layers=model.layers.value,
+                key_value_heads=model.key_value_heads.value,
+                head_dimension=model.head_dimension.value,
+                weights_file_bytes=model.weights_file_bytes.value,
+                maximum_context_tokens=model.maximum_context_tokens.value,
+                cache_element=cache_element)
+        except FitError as exc:
+            set_aside.append({"model": model.name, "why": str(exc)})
+            continue
+        usable.append(Candidate(model=built,
+                                origin="held by the local model server",
+                                purposes=model.purposes))
+    return tuple(usable), tuple(set_aside)
+
+
+def _arithmetic(model: LocalModel, context_tokens: int,
+                reserve_bytes: float) -> list:
+    """The three lines a reader can check with a calculator."""
+    weights = model.resident_weights_bytes()
+    cache = model.cache_bytes_at(context_tokens)
+    element = int(cache / (2 * model.layers * model.key_value_heads
+                           * model.head_dimension * context_tokens))
+    return [
+        f"weights = {int(weights)} bytes, the size of the file on disk"
+        if model.weights_file_bytes else
+        f"weights = {int(model.parameters)} parameters x "
+        f"{weights / model.parameters} bytes each = {int(weights)} bytes",
+        f"cache = 2 x {model.layers} layers x {model.key_value_heads} "
+        f"key/value heads x {model.head_dimension} head dimension x "
+        f"{context_tokens} tokens x {element} bytes = {int(cache)} bytes",
+        f"total = weights + cache + {int(reserve_bytes)} bytes of declared "
+        f"runtime reserve = {int(weights + cache + reserve_bytes)} bytes",
+    ]
+
+
+def _placement_for(tier: MachineTier, candidate: Candidate,
+                   kind: WorkKind) -> dict:
+    """Where one candidate lands for one kind of work."""
+    model = candidate.model
+    context = min(kind.wanted_context_tokens, model.maximum_context_tokens)
+    placed = fit(tier, model, context)
+    resident = largest_context(tier, model, placement="video")
+    limits = []
+    if model.maximum_context_tokens < kind.wanted_context_tokens:
+        limits.append(
+            f"this model declares {model.maximum_context_tokens} context "
+            f"tokens, below the {kind.wanted_context_tokens} this kind of "
+            "work asks for, so it was measured at its own maximum")
+    if resident and resident < context:
+        limits.append(
+            f"at {context} tokens it does not stay in video memory; "
+            f"{resident} tokens is the most that does")
+    if not resident:
+        limits.append(
+            "the weights alone do not fit in video memory at any context "
+            "length, so every token crosses the system bus")
+    return {
+        "model": model.name,
+        "origin": candidate.origin,
+        "context_tokens": context,
+        "wanted_context_tokens": kind.wanted_context_tokens,
+        "weights_bytes": int(model.resident_weights_bytes()),
+        "kv_cache_bytes": int(model.cache_bytes_at(context)),
+        "runtime_reserve_bytes": int(tier.runtime_reserve_bytes),
+        "total_bytes": int(model.resident_weights_bytes()
+                           + model.cache_bytes_at(context)
+                           + tier.runtime_reserve_bytes),
+        "largest_resident_context_tokens": resident,
+        "fit": placed,
+        "arithmetic": _arithmetic(model, context, tier.runtime_reserve_bytes),
+        "limits": limits,
+    }
+
+
+def _choose(placements: list, kind: WorkKind) -> tuple:
+    """The recommended placement for one kind of work, or why there is none."""
+    resident = [item for item in placements if item["fit"]["placement"] == "video"]
+    pool = resident
+    note = ""
+    if not pool and kind.allow_split:
+        pool = [item for item in placements if item["fit"]["placement"] == "split"]
+        note = ("nothing stays in video memory here, so this is the best "
+                "split placement: part of every token crosses the system "
+                "bus and it is slower than a resident model")
+    if not pool:
+        return None, note
+    ordered = sorted(pool, key=lambda item: (item["weights_bytes"], item["model"]))
+    return (ordered[-1] if kind.prefer == "largest" else ordered[0]), note
+
+
+def _refusal(placements: list, kind: WorkKind, tier: MachineTier) -> str:
+    """Why there is no answer, with the number that decided it."""
+    if not placements:
+        return ("no model was offered to this arithmetic, so there is nothing "
+                "to recommend. Point it at a local model server, or give a "
+                "model's figures by hand")
+    smallest = min(placements, key=lambda item: item["total_bytes"])
+    if kind.allow_split:
+        return (
+            f"the smallest model offered needs {gibibytes(smallest['total_bytes'])} "
+            f"GiB at {smallest['context_tokens']} context tokens and this "
+            f"machine has {gibibytes(tier.usable_system_bytes)} GiB of system "
+            "memory, so nothing here loads at all. A smaller model or a "
+            "smaller quantisation is the next thing to try")
+    return (
+        f"the smallest model offered needs {gibibytes(smallest['total_bytes'])} "
+        f"GiB at {smallest['context_tokens']} context tokens and this machine "
+        f"has {gibibytes(tier.usable_video_bytes)} GiB of video memory, of "
+        f"which {gibibytes(tier.runtime_reserve_bytes)} GiB is the declared "
+        "runtime reserve. A split placement is not offered for this kind of "
+        "work, so there is no recommendation rather than a slow one")
+
+
+def advise(*, tier: MachineTier, candidates: tuple, cache_element: str,
+           cache_element_basis: str, right_now: object = None,
+           work_kinds: tuple = WORK_KINDS, set_aside: tuple = ()) -> dict:
+    """Two answers for one machine, with the arithmetic beside each.
+
+    Pure: the same inputs give the same record, which is what lets the
+    served page run the same arithmetic in a browser and lets a check
+    compare the two records field by field.
+    """
+    if not isinstance(tier, MachineTier):
+        raise AdviceError("advise needs a MachineTier")
+    if cache_element_basis not in ("read", "assumed"):
+        raise AdviceError("a cache element is read or assumed, and the record "
+                          "says which")
+    for candidate in candidates:
+        if not isinstance(candidate, Candidate):
+            raise AdviceError("every candidate must be a Candidate")
+        if candidate.model.cache_element != cache_element:
+            raise AdviceError(
+                f"{candidate.model.name} was built for a "
+                f"{candidate.model.cache_element} cache and the machine "
+                f"reports {cache_element}. Build the candidate for the cache "
+                "the machine actually uses")
+    work = []
+    for kind in work_kinds:
+        placements = [_placement_for(tier, candidate, kind)
+                      for candidate in candidates]
+        chosen, note = _choose(placements, kind)
+        work.append({
+            "kind": kind.name,
+            "what_it_is": kind.what_it_is,
+            "why_this_shape": kind.why_this_shape,
+            "wanted_context_tokens": kind.wanted_context_tokens,
+            "wanted_context_basis": "declared policy",
+            "split_placement_offered": kind.allow_split,
+            "recommended": chosen,
+            "recommendation_note": note,
+            "refused_because": "" if chosen else _refusal(placements, kind, tier),
+            "considered": sorted(
+                ({"model": item["model"],
+                  "placement": item["fit"]["placement"],
+                  "context_tokens": item["context_tokens"],
+                  "total_bytes": item["total_bytes"]}
+                 for item in placements),
+                key=lambda item: (item["total_bytes"], item["model"])),
+        })
+    return {
+        "record_type": RECORD_TYPE,
+        "machine": {
+            "name": tier.name,
+            "usable_video_bytes": int(tier.usable_video_bytes),
+            "usable_system_bytes": int(tier.usable_system_bytes),
+            "runtime_reserve_bytes": int(tier.runtime_reserve_bytes),
+            "runtime_reserve_basis": "declared",
+            "usable_video_gib": gibibytes(tier.usable_video_bytes),
+            "usable_system_gib": gibibytes(tier.usable_system_bytes),
+            "runtime_reserve_gib": gibibytes(tier.runtime_reserve_bytes),
+            "memory_basis": (
+                "total memory, not free memory. What is in use right now "
+                "includes any model already loaded, so free memory answers a "
+                "different question and is reported under right_now"),
+        },
+        "cache_element": cache_element,
+        "cache_element_basis": cache_element_basis,
+        "budget_formula": BUDGET_FORMULA,
+        "right_now": right_now,
+        "set_aside": list(set_aside),
+        "work": work,
+    }
+
+
+def advise_from_reading(reading, *,
+                        runtime_reserve_bytes: float = DEFAULT_RUNTIME_RESERVE_BYTES,
+                        video_bytes: object = None,
+                        system_bytes: object = None,
+                        work_kinds: tuple = WORK_KINDS,
+                        extra_candidates: tuple = ()) -> dict:
+    """Advice for a machine that was read, with hand figures overriding it.
+
+    A model loads onto one device unless the runtime is told to split it
+    across several, so the video figure is the largest single device rather
+    than the sum of them. The other devices are named in the machine note.
+    """
+    element = (reading.cache_element.value if reading.cache_element.was_read
+               else ASSUMED_CACHE_ELEMENT)
+    basis = "read" if reading.cache_element.was_read else "assumed"
+    sized = [device for device in reading.video_devices
+             if device.total_bytes.was_read]
+    largest = max(sized, key=lambda device: device.total_bytes.value, default=None)
+    if video_bytes is None and largest is not None:
+        video_bytes = largest.total_bytes.value
+    if system_bytes is None and reading.system_memory_total_bytes.was_read:
+        system_bytes = reading.system_memory_total_bytes.value
+    name = "this machine"
+    if largest is not None and largest.name.was_read:
+        name = largest.name.value
+    tier = machine_tier(video_bytes=video_bytes, system_bytes=system_bytes,
+                        runtime_reserve_bytes=runtime_reserve_bytes, name=name)
+    found, set_aside = candidates_from_reading(reading, cache_element=element)
+    right_now = {
+        "video_free_bytes": (int(largest.total_bytes.value - largest.used_bytes.value)
+                             if largest is not None and largest.used_bytes.was_read
+                             else None),
+        "system_available_bytes": (reading.system_memory_available_bytes.value
+                                   if reading.system_memory_available_bytes.was_read
+                                   else None),
+        "note": ("what is free this minute. A recommendation is made against "
+                 "total memory, so a busy machine still gets an answer; this "
+                 "says whether it would start right now"),
+    }
+    record = advise(tier=tier, candidates=tuple(found) + tuple(extra_candidates),
+                    cache_element=element, cache_element_basis=basis,
+                    right_now=right_now, work_kinds=work_kinds,
+                    set_aside=set_aside)
+    notes = []
+    if len(sized) > 1:
+        notes.append(
+            "this machine has " + str(len(sized)) + " video devices and the "
+            "figures are the largest single one, because a model loads onto "
+            "one device unless the runtime is told to split it")
+    if not reading.video_devices:
+        notes.append(reading.video_unread_reason)
+    if not reading.local_server_answered and reading.local_server_unread_reason:
+        notes.append(reading.local_server_unread_reason)
+    record["machine"]["notes"] = notes
+    return record
+
+
+def self_check() -> list:
+    """Every guard beside the known-wrong input it exists to refuse."""
+    results = []
+
+    def check(name, passed, detail=""):
+        results.append({"check": name, "passed": bool(passed),
+                        "detail": str(detail)[:300]})
+
+    def refuses(name, call, expect_fragment):
+        try:
+            call()
+        except (AdviceError, FitError) as exc:
+            check(name, expect_fragment in str(exc), str(exc))
+        else:
+            check(name, False, "accepted a known wrong input")
+
+    # The machine this was written on, and the model that demonstrably ran
+    # on it. If the arithmetic ever says this does not fit, the arithmetic
+    # is wrong, because the model ran.
+    qwen = LocalModel(name="qwen2.5-coder:7b", layers=28, key_value_heads=4,
+                      head_dimension=128, weights_file_bytes=4683087561,
+                      maximum_context_tokens=32768)
+    card = machine_tier(video_bytes=12884901888, system_bytes=66100064256,
+                        name="NVIDIA GeForce RTX 3060")
+    answer = advise(tier=card,
+                    candidates=(Candidate(model=qwen, origin="the test"),),
+                    cache_element="f16", cache_element_basis="assumed")
+    building = answer["work"][0]
+    deciding = answer["work"][1]
+    check("the_model_that_ran_on_this_machine_is_recommended_for_building",
+          building["recommended"] is not None
+          and building["recommended"]["model"] == "qwen2.5-coder:7b"
+          and building["recommended"]["fit"]["placement"] == "video",
+          building["refused_because"] or building["recommended"]["fit"])
+    check("the_same_model_is_the_deciding_answer_when_it_is_the_only_one",
+          deciding["recommended"] is not None
+          and deciding["recommended"]["context_tokens"] == DECIDING_CONTEXT_TOKENS)
+    check("the_largest_resident_context_is_the_models_own_maximum_here",
+          building["recommended"]["largest_resident_context_tokens"] == 32768,
+          building["recommended"]["largest_resident_context_tokens"])
+    check("the_arithmetic_is_three_lines_a_reader_can_check",
+          len(building["recommended"]["arithmetic"]) == 3
+          and "4683087561" in building["recommended"]["arithmetic"][0]
+          and "2 x 28 layers x 4 key/value heads x 128 head dimension"
+          in building["recommended"]["arithmetic"][1],
+          building["recommended"]["arithmetic"])
+
+    # A machine whose free memory is nearly gone still answers, because the
+    # model already loaded is what is using it.
+    busy = advise_from_reading(_busy_reading())
+    check("a_busy_machine_still_recommends_the_model_already_loaded_on_it",
+          busy["work"][0]["recommended"] is not None
+          and busy["right_now"]["video_free_bytes"] == 1474560000,
+          busy["work"][0]["refused_because"])
+
+    # The refusal, with the number that decided it.
+    small = machine_tier(video_bytes=2 * GIB, system_bytes=4 * GIB,
+                         name="a small machine")
+    refused = advise(tier=small,
+                     candidates=(Candidate(model=qwen, origin="the test"),),
+                     cache_element="f16", cache_element_basis="assumed")
+    check("a_machine_that_cannot_hold_it_refuses_with_the_number",
+          refused["work"][0]["recommended"] is None
+          and "GiB of system memory" in refused["work"][0]["refused_because"],
+          refused["work"][0]["refused_because"])
+    check("deciding_refuses_rather_than_offering_a_split_placement",
+          refused["work"][1]["recommended"] is None
+          and "split placement is not offered"
+          in refused["work"][1]["refused_because"],
+          refused["work"][1]["refused_because"])
+    middling = machine_tier(video_bytes=2 * GIB, system_bytes=32 * GIB,
+                            name="a machine with a small card")
+    split = advise(tier=middling,
+                   candidates=(Candidate(model=qwen, origin="the test"),),
+                   cache_element="f16", cache_element_basis="assumed")
+    check("building_offers_a_split_placement_and_says_what_it_costs",
+          split["work"][0]["recommended"]["fit"]["placement"] == "split"
+          and "system bus" in split["work"][0]["recommendation_note"],
+          split["work"][0]["recommendation_note"])
+    check("deciding_still_refuses_where_building_accepts_a_split",
+          split["work"][1]["recommended"] is None)
+
+    # Two candidates: the kinds of work must pick differently.
+    tiny = LocalModel(name="small:1b", layers=16, key_value_heads=2,
+                      head_dimension=128, weights_file_bytes=900_000_000,
+                      maximum_context_tokens=32768)
+    both = advise(tier=card,
+                  candidates=(Candidate(model=qwen, origin="the test"),
+                              Candidate(model=tiny, origin="the test")),
+                  cache_element="f16", cache_element_basis="assumed")
+    check("building_takes_the_larger_model_and_deciding_takes_the_smaller",
+          both["work"][0]["recommended"]["model"] == "qwen2.5-coder:7b"
+          and both["work"][1]["recommended"]["model"] == "small:1b",
+          [both["work"][0]["recommended"]["model"],
+           both["work"][1]["recommended"]["model"]])
+
+    # Known wrong inputs.
+    refuses("a_machine_with_no_system_memory_reading_is_refused",
+            lambda: machine_tier(video_bytes=GIB, system_bytes=None),
+            "system memory was not read")
