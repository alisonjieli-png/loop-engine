+                    model=LocalModel(name="m", layers=1, key_value_heads=1,
+                                     head_dimension=1, weights_file_bytes=1,
+                                     maximum_context_tokens=4096,
+                                     cache_element="q8"),
+                    origin="the test"),),
+                cache_element="f16", cache_element_basis="assumed"),
+            "cache the machine actually uses")
+    refuses("a_work_kind_with_no_context_is_refused",
+            lambda: WorkKind(name="x", what_it_is="x", wanted_context_tokens=0,
+                             prefer="largest", allow_split=True,
+                             why_this_shape="x"),
+            "positive whole number")
+    refuses("a_work_kind_with_an_unknown_preference_is_refused",
+            lambda: WorkKind(name="x", what_it_is="x",
+                             wanted_context_tokens=1024, prefer="cheapest",
+                             allow_split=True, why_this_shape="x"),
