+        """
+        if not isinstance(host, str) or not host.strip():
+            return "/"
+        name = host.strip().lower()
+        if name.startswith("["):
+            return "/"
+        if name.count(":") == 1:
+            name = name.partition(":")[0]
+        for surface in self.surfaces:
+            if surface.hostname == name:
+                return surface.root_address
+        return "/"
+
+    def canonical_address(self, path, host=None):
+        """The one address a served page names as canonical: the canonical origin and the page it shows."""
+        shown = self.root_address(host) if path == "/" else path
+        return self.canonical_origin + shown
+
+
+@lru_cache(maxsize=1)
+def web_surface_map():
+    """The packaged surface map, read once and refused whole when any part of it is wrong."""
+    from importlib.resources import files
+    text = files("loop_engine").joinpath("core", "service_runtime", WEB_SURFACE_MAP_FILE).read_text("utf-8")
+    return WebSurfaceMap.from_record(json.loads(text))
+
+
+def page_address_tags(path, host=None, surfaces=None):
+    """The tags written into a served page: its canonical address and, at a surface root, the address it shows."""
+    surfaces = surfaces or web_surface_map()
+    tags = '<link rel="canonical" href="' + escape(surfaces.canonical_address(path, host), quote=True) + '">'
+    shown = surfaces.root_address(host) if path == "/" else path
+    if path == "/" and shown != "/":
+        tags += '<meta name="' + ROOT_ADDRESS_META + '" content="' + escape(shown, quote=True) + '">'
+    return tags
+
+
+def with_page_address(body, path, host=None, surfaces=None):
+    """Write the page address tags into a page just before its head closes.
+
+    A page without exactly one closing head tag is refused rather than served
+    with its address tags in a place a browser would not read them.
+    """
+    if body.count(_HEAD_END) != 1:
+        raise ValueError("a served page has exactly one closing head tag")
+    return body.replace(_HEAD_END, page_address_tags(path, host, surfaces).encode("utf-8") + _HEAD_END, 1)
