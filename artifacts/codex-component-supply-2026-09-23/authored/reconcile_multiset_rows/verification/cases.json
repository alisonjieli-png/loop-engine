[
  {
    "name": "multiplicity",
    "input": {
      "left": [
        {
          "x": 1
        },
        {
          "x": 1
        },
        {
          "x": 2
        }
      ],
      "right": [
        {
          "x": 1
        },
        {
          "x": 3
        }
      ]
    },
    "expected": {
      "ok": true,
      "result": {
        "left_count": 3,
        "right_count": 2,
        "equal": false,
        "common": [
          {
            "row": {
              "x": 1
            },
            "count": 1
          }
        ],
        "left_only": [
          {
            "row": {
              "x": 1
            },
            "count": 1
          },
          {
            "row": {
              "x": 2
            },
            "count": 1
          }
        ],
        "right_only": [
          {
            "row": {
              "x": 3
            },
            "count": 1
          }
        ]
      }
    },
    "expected_exit": 0
  },
  {
    "name": "empty",
    "input": {
      "left": [],
      "right": []
    },
    "expected": {
      "ok": true,
      "result": {
        "left_count": 0,
        "right_count": 0,
        "equal": true,
        "common": [],
        "left_only": [],
        "right_only": []
      }
    },
    "expected_exit": 0
  },
