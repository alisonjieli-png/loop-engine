{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compare supplied file inventories input",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "compare_file_inventories_request/v1"
    },
    "before": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "executable": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "digest",
          "size_bytes",
          "executable"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "after": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "executable": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "digest",
          "size_bytes",
          "executable"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    }
  },
  "required": [
    "record_type",
    "before",
    "after"
  ],
  "additionalProperties": false,
  "description": "Strict UTF-8 JSON document, at most 65536 bytes and 16 container levels; duplicate keys, nonfinite literals and lone surrogates refuse. Numeric literals at most 128 characters; mathematically integral decimal/scientific numbers are accepted exactly. Additional semantic conditions are stated in AGENTS.md."
}
