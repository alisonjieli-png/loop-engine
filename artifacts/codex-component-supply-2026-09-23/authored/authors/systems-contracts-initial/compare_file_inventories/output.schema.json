{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compare supplied file inventories output",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "compare_file_inventories_result/v1"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
          },
          "maxItems": 256
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
          },
          "maxItems": 256
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
          },
          "maxItems": 256
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
              },
              "fields": {
                "type": "array",
                "items": {
                  "enum": [
                    "digest",
                    "size_bytes",
                    "executable"
                  ]
                },
                "maxItems": 3,
                "uniqueItems": true
              }
            },
            "required": [
              "path",
              "fields"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "record_type",
        "added",
        "removed",
        "unchanged",
        "changed"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "invalid_input",
            "output_limit_exceeded"
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Exactly one UTF-8 JSON line, at most 131072 bytes including LF. Success exits 0; refusal exits 2. No diagnostic content is sent to stderr."
}
