{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validate declared event precedence input",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "validate_event_precedence_request/v1"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "maxItems": 1024,
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "maxItems": 2048,
      "uniqueItems": true
    }
  },
  "required": [
    "record_type",
    "events",
    "constraints"
  ],
  "additionalProperties": false,
  "description": "Strict UTF-8 JSON document, at most 65536 bytes and 16 container levels; duplicate keys, nonfinite literals and lone surrogates refuse. Numeric literals at most 128 characters; mathematically integral decimal/scientific numbers are accepted exactly. Additional semantic conditions are stated in AGENTS.md."
}
