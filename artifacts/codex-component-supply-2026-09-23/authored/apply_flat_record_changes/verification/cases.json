[
  {
    "name": "replace_add_remove",
    "input": {
      "record": {
        "a": 1,
        "old": null
      },
      "changes": [
        {
          "key": "a",
          "before": {
            "present": true,
            "value": 1
          },
          "after": {
            "present": true,
            "value": 2
          }
        },
        {
          "key": "new",
          "before": {
            "present": false
          },
          "after": {
            "present": true,
            "value": "x"
          }
        },
        {
          "key": "old",
          "before": {
            "present": true,
            "value": null
          },
          "after": {
            "present": false
          }
        }
      ]
    },
    "expected": {
      "ok": true,
      "result": {
        "applied": true,
        "record": {
          "a": 2,
          "new": "x"
        },
        "changed_count": 3,
        "conflicts": []
      }
    },
    "expected_exit": 0
  },
  {
    "name": "conflict_is_atomic",
    "input": {
      "record": {
        "a": 1,
        "b": 2
      },
      "changes": [
        {
          "key": "a",
          "before": {
            "present": true,
            "value": 1
          },
          "after": {
            "present": true,
            "value": 7
          }
        },
        {
          "key": "b",
          "before": {
            "present": true,
            "value": 9
          },
          "after": {
            "present": false
          }
        }
      ]
    },
    "expected": {
      "ok": true,
      "result": {
        "applied": false,
        "record": {
          "a": 1,
          "b": 2
        },
        "changed_count": 0,
        "conflicts": [
          {
            "key": "b",
            "expected": {
              "present": true,
              "value": 9
            },
            "actual": {
              "present": true,
              "value": 2
            }
          }
        ]
      }
    },
    "expected_exit": 0
  },
  {
    "name": "null_is_present",
    "input": {
      "record": {
        "a": null
      },
      "changes": [
        {
          "key": "a",
          "before": {
            "present": false
          },
          "after": {
            "present": true,
            "value": 1
          }
        }
      ]
    },
    "expected": {
      "ok": true,
      "result": {
        "applied": false,
        "record": {
          "a": null
        },
        "changed_count": 0,
        "conflicts": [
          {
            "key": "a",
            "expected": {
              "present": false
            },
            "actual": {
              "present": true,
              "value": null
            }
          }
        ]
      }
    },
    "expected_exit": 0
  },
