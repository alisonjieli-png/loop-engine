{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assign exact IDs to digest shards output",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "assign_digest_shards_result/v1"
        },
        "shard_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f]"
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "shard": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            },
            "required": [
              "id",
              "sha256",
              "shard"
            ],
            "additionalProperties": false
          },
          "maxItems": 1024
        }
      },
      "required": [
        "record_type",
        "shard_count",
        "assignments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "invalid_input",
            "output_limit_exceeded"
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Exactly one UTF-8 JSON line, at most 131072 bytes including LF. Success exits 0; refusal exits 2. No diagnostic content is sent to stderr."
}
