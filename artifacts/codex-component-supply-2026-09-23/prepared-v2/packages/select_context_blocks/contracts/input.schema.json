{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "priority": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "required": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "text": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "cost",
          "priority",
          "required",
          "depends_on",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "budget",
    "blocks"
  ],
  "additionalProperties": false
}
