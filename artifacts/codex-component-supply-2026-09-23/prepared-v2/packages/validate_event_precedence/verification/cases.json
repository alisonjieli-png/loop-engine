[
  {
    "name": "strict_order",
    "input": {
      "record_type": "validate_event_precedence_request/v1",
      "events": [
        "fetch",
        "verify",
        "use"
      ],
      "constraints": [
        {
          "before": "fetch",
          "after": "verify"
        },
        {
          "before": "verify",
          "after": "use"
        }
      ]
    },
    "expected": {
      "record_type": "validate_event_precedence_result/v1",
      "satisfied": true,
      "violations": []
    },
    "expected_exit": 0
  },
  {
    "name": "reverse_and_self",
    "input": {
      "record_type": "validate_event_precedence_request/v1",
      "events": [
        "a",
        "b"
      ],
      "constraints": [
        {
          "before": "b",
          "after": "a"
        },
        {
          "before": "a",
          "after": "a"
        }
      ]
    },
    "expected": {
      "record_type": "validate_event_precedence_result/v1",
      "satisfied": false,
      "violations": [
        {
          "before": "b",
          "after": "a",
          "before_index": 1,
          "after_index": 0,
          "reason": "not_before"
        },
        {
          "before": "a",
          "after": "a",
          "before_index": 0,
          "after_index": 0,
          "reason": "not_before"
        }
      ]
    },
    "expected_exit": 0
  },
  {
    "name": "missing_event_report",
    "input": {
      "record_type": "validate_event_precedence_request/v1",
      "events": [
        "a"
      ],
      "constraints": [
        {
          "before": "missing",
          "after": "a"
        },
        {
          "before": "x",
          "after": "y"
        }
      ]
    },
    "expected": {
      "record_type": "validate_event_precedence_result/v1",
      "satisfied": false,
      "violations": [
        {
          "before": "missing",
          "after": "a",
          "before_index": null,
          "after_index": 0,
          "reason": "missing_event"
        },
        {
          "before": "x",
          "after": "y",
          "before_index": null,
          "after_index": null,
          "reason": "missing_event"
        }
      ]
    },
    "expected_exit": 0
  },
  {
    "name": "empty_constraints",
    "input": {
      "record_type": "validate_event_precedence_request/v1",
      "events": [],
      "constraints": []
    },
    "expected": {
      "record_type": "validate_event_precedence_result/v1",
      "satisfied": true,
      "violations": []
    },
    "expected_exit": 0
  },
  {
    "name": "ambiguous_repeated_event",
    "input": {
      "record_type": "validate_event_precedence_request/v1",
      "events": [
        "a",
        "a"
      ],
      "constraints": []
    },
    "expected": {
      "error": "invalid_input"
    },
    "expected_exit": 2
  },
  {
    "name": "duplicate_constraint",
    "input": {
      "record_type": "validate_event_precedence_request/v1",
      "events": [
        "a",
        "b"
      ],
      "constraints": [
        {
          "before": "a",
          "after": "b"
        },
        {
          "before": "a",
          "after": "b"
        }
      ]
    },
    "expected": {
      "error": "invalid_input"
    },
    "expected_exit": 2
  },
  {
    "name": "duplicate_top_key",
    "raw_input": "{\"record_type\":\"validate_event_precedence_request/v1\",\"record_type\":\"validate_event_precedence_request/v1\"}",
    "expected": {
      "error": "invalid_input"
    },
    "expected_exit": 2
  },
  {
    "name": "nonfinite",
    "raw_input": "{\"x\":NaN}",
    "expected": {
      "error": "invalid_input"
    },
    "expected_exit": 2
  },
  {
    "name": "depth_limit",
    "raw_input": "[[[[[[[[[[[[[[[[[0]]]]]]]]]]]]]]]]]",
    "expected": {
      "error": "invalid_input"
    },
    "expected_exit": 2
  },
  {
    "name": "lone_surrogate",
    "raw_input": "{\"x\":\"\\ud800\"}",
    "expected": {
      "error": "invalid_input"
    },
    "expected_exit": 2
  },
  {
    "name": "unknown_top_field",
    "input": {
      "record_type": "validate_event_precedence_request/v1",
      "events": [
        "fetch",
        "verify",
        "use"
      ],
      "constraints": [
        {
          "before": "fetch",
          "after": "verify"
        },
        {
          "before": "verify",
          "after": "use"
        }
      ],
      "unrecognized": true
    },
    "expected": {
      "error": "invalid_input"
    },
    "expected_exit": 2
  }
]
