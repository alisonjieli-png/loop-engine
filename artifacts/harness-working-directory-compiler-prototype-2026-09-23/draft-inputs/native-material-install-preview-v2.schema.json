{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Working Directory Compiler \u2014 native material installation preview v2 draft",
  "$comment": "Research candidate only. JSON Schema validates shape, not native support, provenance, review or authority.",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "native_material_install_preview/v2"
    },
    "component": {
      "const": "Harness Working Directory Compiler"
    },
    "draft_status": {
      "const": "research_only_not_runtime_admitted"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "status": {
      "enum": [
        "compiled",
        "refused"
      ]
    },
    "bindings": {
      "type": "object",
      "properties": {
        "profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assignment_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authority_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspace_state_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "engine_descriptor_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "engine_installation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "host_policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "profile_digest",
        "assignment_digest",
        "selection_digest",
        "authority_digest",
        "workspace_state_digest",
        "engine_descriptor_digest",
        "engine_installation_digest",
        "host_policy_digest"
      ],
      "additionalProperties": false
    },
    "client_binding": {
      "type": "object",
      "properties": {
        "client_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "interface": {
          "enum": [
            "cli",
            "editor",
            "api"
          ]
        },
        "exact_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operating_system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "executable_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effective_configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "client_kind",
        "interface",
        "exact_version",
        "operating_system",
        "architecture",
        "executable_digest",
        "effective_configuration_digest"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "slot_id": {
          "const": "material_install_layout"
        },
        "engine_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "slot_id",
        "engine_ref"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package_identity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "package_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_path": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "file_role": {
            "enum": [
              "instruction_file",
              "skill_definition",
              "skill_script",
              "skill_reference",
              "skill_asset",
              "subagent_definition",
              "command",
              "hook",
              "protocol_server_configuration",
              "plugin_manifest",
              "executable_tool",
              "configuration",
              "other"
            ]
          },
          "target_path": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
          },
          "rendering_operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "rendered_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "activation": {
            "enum": [
              "initial_discovery",
              "on_demand",
              "explicit_activation",
              "explicit_read"
            ]
          },
          "expected_existing": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "absent",
                  "managed_exact"
                ]
              },
              "digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              }
            },
            "required": [
              "state",
              "digest"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "absent"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "digest": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "package_identity",
          "package_digest",
          "source_path",
          "source_digest",
          "file_role",
          "target_path",
          "rendering_operation",
          "rendered_digest",
          "size_bytes",
          "activation",
          "expected_existing"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "resolved_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "outcome": {
            "enum": [
              "supported",
              "unsupported_optional",
              "refused"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ref",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "capability_id",
          "outcome",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "required_effects": {
      "type": "object",
      "properties": {
        "installation": {
          "type": "array",
          "items": {
            "enum": [
              "pure",
              "reads_fs",
              "writes_fs",
              "reads_secret",
              "network",
              "spawns_process"
            ]
          },
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true
        },
        "worker": {
          "type": "array",
          "items": {
            "enum": [
              "pure",
              "reads_fs",
              "writes_fs",
              "reads_secret",
              "network",
              "spawns_process"
            ]
          },
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true
        }
      },
      "required": [
        "installation",
        "worker"
      ],
      "additionalProperties": false
    },
    "runtime_handshake": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_performed",
            "matched",
            "refused"
          ]
        },
        "selected_profile_record_type": {
          "const": "native_client_layout_profile/v2"
        },
        "selected_plan_record_type": {
          "const": "native_material_install_preview/v2"
        },
        "observation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "ref",
                "digest"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "state",
        "selected_profile_record_type",
        "selected_plan_record_type",
        "observation"
      ],
      "additionalProperties": false
    },
    "launch_eligibility": {
      "enum": [
        "not_assessed",
        "eligible",
        "refused"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "writes_performed": {
      "const": false
    },
    "authority_granted": {
      "const": false
    }
  },
  "required": [
    "record_type",
    "component",
    "draft_status",
    "plan_id",
    "status",
    "bindings",
    "client_binding",
    "engine",
    "files",
    "required_capabilities",
    "resolved_capabilities",
    "required_effects",
    "runtime_handshake",
    "launch_eligibility",
    "reasons",
    "writes_performed",
    "authority_granted"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "refused"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "maxItems": 0
          },
          "reasons": {
            "minItems": 1
          },
          "launch_eligibility": {
            "const": "refused"
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "minItems": 1
          },
          "reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "launch_eligibility": {
            "const": "eligible"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "compiled"
          },
          "runtime_handshake": {
            "properties": {
              "state": {
                "const": "matched"
              },
              "observation": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "ref",
                  "digest"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  ]
}
