{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Produced SessionStart hook output subset",
  "oneOf": [
    {
      "type": "object",
      "maxProperties": 0
    },
    {
      "type": "object",
      "required": [
        "hookSpecificOutput"
      ],
      "additionalProperties": false,
      "properties": {
        "hookSpecificOutput": {
          "type": "object",
          "required": [
            "hookEventName",
            "additionalContext"
          ],
          "additionalProperties": false,
          "properties": {
            "hookEventName": {
              "const": "SessionStart"
            },
            "additionalContext": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      }
    }
  ]
}
