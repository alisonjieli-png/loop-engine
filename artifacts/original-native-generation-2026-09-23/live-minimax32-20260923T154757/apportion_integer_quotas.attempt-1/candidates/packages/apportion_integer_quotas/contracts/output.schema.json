{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/apportion_integer_quotas/output.schema.json",
  "title": "apportion_integer_quotas output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sum", "allocations"],
      "properties": {
        "status": { "const": "ok" },
        "sum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Always equals target on success."
        },
        "allocations": {
          "type": "object",
          "minProperties": 0,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "const": "refused" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "E_INPUT_BYTES",
                "E_INPUT_SHAPE",
                "E_TARGET",
                "E_WEIGHTS",
                "E_WEIGHT_VALUE",
                "E_WEIGHT_ID",
                "E_WEIGHTS_ALL_ZERO",
                "E_INTERNAL"
              ]
            },
            "message": { "type": "string" }
          }
        }
      }
    }
  ]
}
